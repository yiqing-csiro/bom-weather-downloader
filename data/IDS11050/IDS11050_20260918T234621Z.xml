    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-19T09:16:21+09:30" end-time-local="2026-09-19T09:16:21+09:30" start-time-utc="2026-09-18T23:46:21Z" end-time-utc="2026-09-18T23:46:21Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system centred over NSW extends a ridge over SA ahead of a cold front will approach from the west. The front moves across SA on Sunday. Another high pressure system will move eastwards across waters to the south during Monday then over Victoria on Tuesday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW010" description="West Coast" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-19T00:00:00+09:30" end-time-local="2026-09-20T00:00:00+09:30" start-time-utc="2026-09-18T14:30:00Z" end-time-utc="2026-09-19T14:30:00Z">
                <text type="forecast">Sunny. Winds northerly 25 to 40 km/h. Daytime maximum temperatures in the low to mid 30s.</text>
                <text type="uv_alert">Sun protection 9:10am to 3:40pm, UV Index predicted to reach 8 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-20T00:00:00+09:30" end-time-local="2026-09-21T00:00:00+09:30" start-time-utc="2026-09-19T14:30:00Z" end-time-utc="2026-09-20T14:30:00Z">
                <text type="forecast">Mostly sunny. Winds northerly 20 to 30 km/h shifting south to southwesterly 25 to 35 km/h early in the morning. Overnight temperatures falling to between 13 and 17 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-21T00:00:00+09:30" end-time-local="2026-09-22T00:00:00+09:30" start-time-utc="2026-09-20T14:30:00Z" end-time-utc="2026-09-21T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds southerly 15 to 20 km/h turning southeasterly 15 to 25 km/h during the morning. Overnight temperatures falling to around 9 with daytime temperatures reaching between 19 and 23.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-22T00:00:00+09:30" end-time-local="2026-09-23T00:00:00+09:30" start-time-utc="2026-09-21T14:30:00Z" end-time-utc="2026-09-22T14:30:00Z">
                <text type="forecast">Sunny day. The chance of morning frost south of Streaky Bay. The chance of a thunderstorm west of Nullarbor in the evening. Winds easterly 15 to 20 km/h tending northeasterly during the morning then turning east to southeasterly during the day. Overnight temperatures falling to between 3 and 8 with daytime temperatures reaching 23 to 28.</text>
            </forecast-period>
        </area>
