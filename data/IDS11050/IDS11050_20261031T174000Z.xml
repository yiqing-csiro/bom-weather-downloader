    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-01T04:10:40+10:30" end-time-local="2026-11-01T04:10:40+10:30" start-time-utc="2026-10-31T17:40:40Z" end-time-utc="2026-10-31T17:40:40Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A low pressure system is entering the state from the west today, moving over central and eastern districts on Monday, followed by another ridge of high pressure which will persist until Tuesday. On Wednesday a cold front moves over the south of the state.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW010" description="West Coast" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-01T00:00:00+10:30" end-time-local="2026-11-02T00:00:00+10:30" start-time-utc="2026-10-31T13:30:00Z" end-time-utc="2026-11-01T13:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers south of Streaky Bay, becoming less likely this afternoon. Near zero chance of rain elsewhere. The chance of a thunderstorm. Winds northwest to northeasterly 25 to 35 km/h tending northwest to southwesterly in the early afternoon then tending south to southwesterly 20 to 30 km/h in the evening. Daytime maximum temperatures 32 to 38.</text>
                <text type="fire_danger">High</text>
                <text type="uv_alert">Sun protection 9:20am to 5:10pm, UV Index predicted to reach 11 [Extreme]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-02T00:00:00+10:30" end-time-local="2026-11-03T00:00:00+10:30" start-time-utc="2026-11-01T13:30:00Z" end-time-utc="2026-11-02T13:30:00Z">
                <text type="forecast">Mostly sunny. Winds south to southwesterly 15 to 25 km/h increasing to 25 to 30 km/h in the late afternoon then tending south to southeasterly 15 to 25 km/h in the evening. Overnight temperatures falling to around 14 with daytime temperatures reaching 25 to 30.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-03T00:00:00+10:30" end-time-local="2026-11-04T00:00:00+10:30" start-time-utc="2026-11-02T13:30:00Z" end-time-utc="2026-11-03T13:30:00Z">
                <text type="forecast">Mostly sunny. The chance of morning fog south of Streaky Bay. Winds east to southeasterly 15 to 20 km/h tending east to northeasterly during the morning then tending southeast to southwesterly 15 to 25 km/h during the afternoon. Overnight temperatures falling to between 9 and 12 with daytime temperatures reaching 27 to 33.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-04T00:00:00+10:30" end-time-local="2026-11-05T00:00:00+10:30" start-time-utc="2026-11-03T13:30:00Z" end-time-utc="2026-11-04T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower south of Streaky Bay in the morning. Near zero chance of rain elsewhere. The chance of a thunderstorm south of Streaky Bay in the morning. Winds south to southeasterly 15 to 25 km/h tending south to southwesterly 20 to 30 km/h during the morning then tending south to southeasterly 15 to 25 km/h during the evening. Overnight temperatures falling to between 11 and 15 with daytime temperatures reaching 22 to 27.</text>
            </forecast-period>
        </area>
