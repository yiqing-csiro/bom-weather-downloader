        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-12T10:53:21+10:30" end-time-local="2026-11-12T10:53:21+10:30" start-time-utc="2026-11-12T00:23:21Z" end-time-utc="2026-11-12T00:23:21Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A ridge of high pressure lies over water south of the Bight and will weaken this evening. A low pressure system over Western Australian will move over South Australia on Friday, with an associated trough. A ridge of high pressure will follow and persist into early next week. A cold front clips the southeast on Sunday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW010" description="West Coast" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-12T00:00:00+10:30" end-time-local="2026-11-13T00:00:00+10:30" start-time-utc="2026-11-11T13:30:00Z" end-time-utc="2026-11-12T13:30:00Z">
                <text type="forecast">Cloudy. High chance of showers west of Ceduna, medium chance elsewhere. The chance of a thunderstorm. Winds northeast to southeasterly 15 to 25 km/h. Daytime maximum temperatures 24 to 30.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:20am to 5:10pm, UV Index predicted to reach 10 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-13T00:00:00+10:30" end-time-local="2026-11-14T00:00:00+10:30" start-time-utc="2026-11-12T13:30:00Z" end-time-utc="2026-11-13T13:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers. The chance of a thunderstorm in the early morning. Light winds becoming northwest to southwesterly 15 to 25 km/h in the morning then tending south to southwesterly 25 to 35 km/h in the early afternoon. Overnight temperatures falling to around 15 with daytime temperatures reaching 25 to 31.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-14T00:00:00+10:30" end-time-local="2026-11-15T00:00:00+10:30" start-time-utc="2026-11-13T13:30:00Z" end-time-utc="2026-11-14T13:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower west of Ceduna, near zero chance elsewhere. Winds southerly 20 to 30 km/h. Overnight temperatures falling to between 11 and 14 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-15T00:00:00+10:30" end-time-local="2026-11-16T00:00:00+10:30" start-time-utc="2026-11-14T13:30:00Z" end-time-utc="2026-11-15T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower. The chance of a thunderstorm west of Nullarbor in the evening. Winds south to southeasterly 25 to 35 km/h. Overnight temperatures falling to between 9 and 13 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
        </area>
