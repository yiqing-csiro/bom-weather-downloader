    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-26T21:17:24+09:30" end-time-local="2026-09-26T21:17:24+09:30" start-time-utc="2026-09-26T11:47:24Z" end-time-utc="2026-09-26T11:47:24Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough over central Australia will weaken and contract into WA as a ridge of high pressure extends across southern SA on Sunday. The high pressure system is expected to drift into the Tasman Sea by Tuesday as the trough in WA begins to re-extend over western SA on Tuesday, pushing into the state on Wednesday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW010" description="West Coast" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-26T21:00:00+09:30" end-time-local="2026-09-27T00:00:00+09:30" start-time-utc="2026-09-26T11:30:00Z" end-time-utc="2026-09-26T14:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers west of Nullarbor, near zero chance elsewhere. Winds southeasterly 20 to 30 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-27T00:00:00+09:30" end-time-local="2026-09-28T00:00:00+09:30" start-time-utc="2026-09-26T14:30:00Z" end-time-utc="2026-09-27T14:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers west of Nullarbor, most likely in the early morning. Near zero chance of rain elsewhere. Winds east to southeasterly 20 to 30 km/h tending east to northeasterly 15 to 25 km/h in the late evening. Overnight temperatures falling to between 10 and 13 with daytime temperatures reaching 25 to 35.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:10am to 3:40pm, UV Index predicted to reach 8 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-28T00:00:00+09:30" end-time-local="2026-09-29T00:00:00+09:30" start-time-utc="2026-09-27T14:30:00Z" end-time-utc="2026-09-28T14:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower west of Nullarbor, most likely in the evening. Near zero chance of rain elsewhere. The chance of a thunderstorm west of Nullarbor in the evening. Winds east to northeasterly 15 to 25 km/h tending north to northeasterly 25 to 35 km/h early in the morning. Overnight temperatures falling to between 13 and 19 with daytime temperatures reaching the low to mid 30s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-29T00:00:00+09:30" end-time-local="2026-09-30T00:00:00+09:30" start-time-utc="2026-09-28T14:30:00Z" end-time-utc="2026-09-29T14:30:00Z">
                <text type="forecast">Partly cloudy. High chance of showers west of Ceduna, slight chance elsewhere. The chance of a thunderstorm west of Ceduna. Winds north to northeasterly 25 to 35 km/h becoming northerly 30 to 45 km/h during the morning then shifting south to southwesterly 20 to 30 km/h during the afternoon. Overnight temperatures falling to between 17 and 22 with daytime temperatures reaching 25 to 35.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-09-30T00:00:00+09:30" end-time-local="2026-10-01T00:00:00+09:30" start-time-utc="2026-09-29T14:30:00Z" end-time-utc="2026-09-30T14:30:00Z">
                <text type="forecast">Partly cloudy. Very high chance of showers. The chance of a thunderstorm. Light winds becoming northwest to northeasterly 15 to 20 km/h during the morning then tending southeast to southwesterly during the afternoon. Overnight temperatures falling to around 13 with daytime temperatures reaching the mid to high 20s.</text>
            </forecast-period>
        </area>
