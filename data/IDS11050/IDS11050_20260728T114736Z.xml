        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-07-28T21:17:36+09:30" end-time-local="2026-07-28T21:17:36+09:30" start-time-utc="2026-07-28T11:47:36Z" end-time-utc="2026-07-28T11:47:36Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A cold front will clip the far southeast on Tuesday evening, before moving out to the east overnight. A high pressure system will then move over the Bight on Wednesday, and will extend a ridge across the state as it slowly moves east into NSW by Saturday. Another cold front is then forecast to cross the state from Saturday evening into Sunday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW010" description="West Coast" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-07-28T21:00:00+09:30" end-time-local="2026-07-29T00:00:00+09:30" start-time-utc="2026-07-28T11:30:00Z" end-time-utc="2026-07-28T14:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower east of Ceduna, near zero chance elsewhere. Winds southwesterly 15 to 20 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-07-29T00:00:00+09:30" end-time-local="2026-07-30T00:00:00+09:30" start-time-utc="2026-07-28T14:30:00Z" end-time-utc="2026-07-29T14:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower in the morning. Light winds becoming southerly 15 to 20 km/h in the morning then becoming light in the middle of the day. Overnight temperatures falling to between 5 and 8 with daytime temperatures reaching around 15.</text>
                <text type="uv_alert">Sun protection 11:10am to 2:10pm, UV Index predicted to reach 3 [Moderate]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-07-30T00:00:00+09:30" end-time-local="2026-07-31T00:00:00+09:30" start-time-utc="2026-07-29T14:30:00Z" end-time-utc="2026-07-30T14:30:00Z">
                <text type="forecast">Cloudy. Light winds. Overnight temperatures falling to around 4 with daytime temperatures reaching around 16.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-07-31T00:00:00+09:30" end-time-local="2026-08-01T00:00:00+09:30" start-time-utc="2026-07-30T14:30:00Z" end-time-utc="2026-07-31T14:30:00Z">
                <text type="forecast">Partly cloudy. The chance of morning fog south of Streaky Bay. Light winds becoming north to northeasterly 15 to 25 km/h during the morning. Overnight temperatures falling to between 2 and 5 with daytime temperatures reaching around 17.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-08-01T00:00:00+09:30" end-time-local="2026-08-02T00:00:00+09:30" start-time-utc="2026-07-31T14:30:00Z" end-time-utc="2026-08-01T14:30:00Z">
                <text type="forecast">Sunny. Winds northeasterly 15 to 25 km/h turning northerly 20 to 30 km/h during the morning then tending north to northeasterly 15 to 20 km/h during the evening. Overnight temperatures falling to between 3 and 6 with daytime temperatures reaching between 17 and 22.</text>
            </forecast-period>
        </area>
