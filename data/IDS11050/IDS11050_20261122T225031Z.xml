        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-23T09:20:31+10:30" end-time-local="2026-11-23T09:20:31+10:30" start-time-utc="2026-11-22T22:50:31Z" end-time-utc="2026-11-22T22:50:31Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough of low pressure over the northeast will linger over the far northeast until mid week. A cold front clips the southeast today, followed by a high pressure system, which will then move across southern parts of the state on Tuesday. A trough of low pressure approaches the western border on Wednesday whilst a cold font moves over waters to the south. The trough lingers near the western border on Thursday whilst a high pressure systems moves over waters to the south.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW010" description="West Coast" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-23T00:00:00+10:30" end-time-local="2026-11-24T00:00:00+10:30" start-time-utc="2026-11-22T13:30:00Z" end-time-utc="2026-11-23T13:30:00Z">
                <text type="forecast">Partly cloudy. Winds southwesterly 25 to 35 km/h turning south to southeasterly 15 to 20 km/h in the evening. Daytime maximum temperatures 22 to 27.</text>
                <text type="fire_danger">High</text>
                <text type="uv_alert">Sun protection 9:10am to 5:30pm, UV Index predicted to reach 12 [Extreme]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-24T00:00:00+10:30" end-time-local="2026-11-25T00:00:00+10:30" start-time-utc="2026-11-23T13:30:00Z" end-time-utc="2026-11-24T13:30:00Z">
                <text type="forecast">Mostly sunny. Winds east to southeasterly 15 to 20 km/h tending east to northeasterly 15 to 25 km/h in the morning then tending southeast to southwesterly in the evening. Overnight temperatures falling to between 9 and 13 with daytime temperatures reaching 26 to 31.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-25T00:00:00+10:30" end-time-local="2026-11-26T00:00:00+10:30" start-time-utc="2026-11-24T13:30:00Z" end-time-utc="2026-11-25T13:30:00Z">
                <text type="forecast">Partly cloudy. The chance of morning fog south of Streaky Bay. Medium chance of showers west of Ceduna, most likely in the afternoon and evening. Near zero chance of rain elsewhere. The chance of a thunderstorm west of Ceduna in the afternoon and evening. Winds east to northeasterly 20 to 30 km/h tending northwest to northeasterly 25 to 35 km/h during the morning then tending southeast to southwesterly 15 to 25 km/h during the evening. Overnight temperatures falling to between 9 and 17 with daytime temperatures reaching the low to mid 30s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-26T00:00:00+10:30" end-time-local="2026-11-27T00:00:00+10:30" start-time-utc="2026-11-25T13:30:00Z" end-time-utc="2026-11-26T13:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers west of Ceduna, slight chance elsewhere. The chance of a thunderstorm west of Ceduna in the morning. Winds northeast to southeasterly 15 to 25 km/h tending south to southeasterly during the afternoon then becoming light during the evening. Overnight temperatures falling to between 16 and 19 with daytime temperatures reaching 28 to 33.</text>
            </forecast-period>
        </area>
