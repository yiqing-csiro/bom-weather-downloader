    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-07T11:24:42+09:30" end-time-local="2026-09-07T11:24:42+09:30" start-time-utc="2026-09-07T01:54:42Z" end-time-utc="2026-09-07T01:54:42Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">The tail end of a cold front will move across southern coasts early Monday then a high pressure system centred southwest of WA will extend a ridge across the south of SA. The main high centre will move to the east of SA late Thursday and Friday. A trough over the interior of WA will remain stationary for most of the week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW010" description="West Coast" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-07T00:00:00+09:30" end-time-local="2026-09-08T00:00:00+09:30" start-time-utc="2026-09-06T14:30:00Z" end-time-utc="2026-09-07T14:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers west of Ceduna, near zero chance elsewhere. The chance of a thunderstorm west of Nullarbor. Winds east to southeasterly 20 to 30 km/h. Daytime maximum temperatures between 17 and 20.</text>
                <text type="uv_alert">Sun protection 9:40am to 3:20pm, UV Index predicted to reach 6 [High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-08T00:00:00+09:30" end-time-local="2026-09-09T00:00:00+09:30" start-time-utc="2026-09-07T14:30:00Z" end-time-utc="2026-09-08T14:30:00Z">
                <text type="forecast">Cloudy. Very high chance of showers west of Ceduna, slight chance elsewhere. The chance of a thunderstorm west of Nullarbor in the morning. Winds east to southeasterly 15 to 25 km/h tending south to southeasterly 20 to 30 km/h in the early afternoon. Overnight temperatures falling to between 6 and 11 with daytime temperatures reaching around 18.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-09T00:00:00+09:30" end-time-local="2026-09-10T00:00:00+09:30" start-time-utc="2026-09-08T14:30:00Z" end-time-utc="2026-09-09T14:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers west of Ceduna, most likely in the morning. Near zero chance of rain elsewhere. Winds southeasterly 25 to 35 km/h. Overnight temperatures falling to around 9 with daytime temperatures reaching between 16 and 19.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-10T00:00:00+09:30" end-time-local="2026-09-11T00:00:00+09:30" start-time-utc="2026-09-09T14:30:00Z" end-time-utc="2026-09-10T14:30:00Z">
                <text type="forecast">Mostly sunny. Slight chance of a shower west of Nullarbor, near zero chance elsewhere. Winds easterly 20 to 30 km/h. Overnight temperatures falling to between 5 and 8 with daytime temperatures reaching the low 20s.</text>
            </forecast-period>
        </area>
