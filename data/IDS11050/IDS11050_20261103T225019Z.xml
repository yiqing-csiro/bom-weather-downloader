    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-04T09:20:19+10:30" end-time-local="2026-11-04T09:20:19+10:30" start-time-utc="2026-11-03T22:50:19Z" end-time-utc="2026-11-03T22:50:19Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A cold front will move across the south of the state today, clearing the east of the state in the afternoon. Another ridge of high pressure will follow on Thursday, with another cold front clipping the southeast on Friday. Another high moves over waters to the south of SA on Saturday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW010" description="West Coast" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-04T00:00:00+10:30" end-time-local="2026-11-05T00:00:00+10:30" start-time-utc="2026-11-03T13:30:00Z" end-time-utc="2026-11-04T13:30:00Z">
                <text type="forecast">Partly cloudy. Winds south to southwesterly 25 to 35 km/h tending south to southeasterly 15 to 20 km/h during the afternoon and evening. Daytime maximum temperatures in the low to mid 20s.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:20am to 5:10pm, UV Index predicted to reach 11 [Extreme]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-05T00:00:00+10:30" end-time-local="2026-11-06T00:00:00+10:30" start-time-utc="2026-11-04T13:30:00Z" end-time-utc="2026-11-05T13:30:00Z">
                <text type="forecast">Mostly sunny. Light winds becoming east to northeasterly 15 to 20 km/h in the morning then tending southeast to southwesterly 15 to 25 km/h in the middle of the day. Overnight temperatures falling to between 7 and 10 with daytime temperatures reaching 24 to 29.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-06T00:00:00+10:30" end-time-local="2026-11-07T00:00:00+10:30" start-time-utc="2026-11-05T13:30:00Z" end-time-utc="2026-11-06T13:30:00Z">
                <text type="forecast">Sunny. The chance of morning fog south of Streaky Bay. Light winds becoming east to northeasterly 15 to 25 km/h during the morning then turning south to southeasterly 25 to 40 km/h during the afternoon. Overnight temperatures falling to between 7 and 11 with daytime temperatures reaching 27 to 33.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-07T00:00:00+10:30" end-time-local="2026-11-08T00:00:00+10:30" start-time-utc="2026-11-06T13:30:00Z" end-time-utc="2026-11-07T13:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers west of Ceduna, most likely in the morning. Near zero chance of rain elsewhere. The chance of a thunderstorm. Winds southeasterly 25 to 40 km/h. Overnight temperatures falling to between 9 and 14 with daytime temperatures reaching 23 to 29.</text>
            </forecast-period>
        </area>
