    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-07-26T15:55:42+09:30" end-time-local="2026-07-26T15:55:42+09:30" start-time-utc="2026-07-26T06:25:42Z" end-time-utc="2026-07-26T06:25:42Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system centred over northern SA will slowly drift east and weaken on Monday as a cold front moves up through the Bight. The front will move over southern SA during Monday night, with a new high pressure system moving into the Bight mid next week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW010" description="West Coast" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-07-26T15:00:00+09:30" end-time-local="2026-07-27T00:00:00+09:30" start-time-utc="2026-07-26T05:30:00Z" end-time-utc="2026-07-26T14:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower south of Streaky Bay early this evening. Near zero chance of rain elsewhere. Winds north to northwesterly 15 to 25 km/h becoming light in the evening then becoming northerly 15 to 20 km/h in the late evening.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-07-27T00:00:00+09:30" end-time-local="2026-07-28T00:00:00+09:30" start-time-utc="2026-07-26T14:30:00Z" end-time-utc="2026-07-27T14:30:00Z">
                <text type="forecast">Mostly sunny. Slight chance of a shower south of Streaky Bay in the evening. Near zero chance of rain elsewhere. Winds northerly 20 to 30 km/h tending northwesterly 25 to 35 km/h in the middle of the day then tending northwest to southwesterly 15 to 25 km/h in the late afternoon. Overnight temperatures falling to around 6 with daytime temperatures reaching around 19.</text>
                <text type="uv_alert">Sun protection 11:20am to 1:50pm, UV Index predicted to reach 3 [Moderate]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-07-28T00:00:00+09:30" end-time-local="2026-07-29T00:00:00+09:30" start-time-utc="2026-07-27T14:30:00Z" end-time-utc="2026-07-28T14:30:00Z">
                <text type="forecast">Partly cloudy. High chance of showers, most likely in the morning. Winds west to northwesterly 15 to 20 km/h turning south to southwesterly 20 to 30 km/h during the morning then becoming light in the late evening. Overnight temperatures falling to around 7 with daytime temperatures reaching around 16.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-07-29T00:00:00+09:30" end-time-local="2026-07-30T00:00:00+09:30" start-time-utc="2026-07-28T14:30:00Z" end-time-utc="2026-07-29T14:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower. Light winds. Overnight temperatures falling to around 6 with daytime temperatures reaching around 15.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-07-30T00:00:00+09:30" end-time-local="2026-07-31T00:00:00+09:30" start-time-utc="2026-07-29T14:30:00Z" end-time-utc="2026-07-30T14:30:00Z">
                <text type="forecast">Cloudy. Light winds. Overnight temperatures falling to between 3 and 6 with daytime temperatures reaching around 16.</text>
            </forecast-period>
        </area>
