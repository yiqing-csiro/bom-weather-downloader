    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-18T09:17:49+09:30" end-time-local="2026-09-18T09:17:49+09:30" start-time-utc="2026-09-17T23:47:49Z" end-time-utc="2026-09-17T23:47:49Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A strong high pressure system centred over Victoria will maintain a ridge across SA as it drifts slowly over NSW. A cold front will then approach from the west late Saturday and move across SA on Sunday, before another ridge pushes in behind the front. The associated high will then move eastwards across waters south from Monday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW010" description="West Coast" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-18T00:00:00+09:30" end-time-local="2026-09-19T00:00:00+09:30" start-time-utc="2026-09-17T14:30:00Z" end-time-utc="2026-09-18T14:30:00Z">
                <text type="forecast">Sunny. Winds northerly 25 to 35 km/h becoming light in the evening then becoming northeasterly 15 to 20 km/h in the late evening. Daytime maximum temperatures around 30.</text>
                <text type="uv_alert">Sun protection 9:10am to 3:40pm, UV Index predicted to reach 8 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-19T00:00:00+09:30" end-time-local="2026-09-20T00:00:00+09:30" start-time-utc="2026-09-18T14:30:00Z" end-time-utc="2026-09-19T14:30:00Z">
                <text type="forecast">Sunny. Winds northeasterly 15 to 20 km/h turning northerly 25 to 40 km/h early in the morning. Overnight temperatures falling to between 9 and 13 with daytime temperatures reaching the low 30s.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-20T00:00:00+09:30" end-time-local="2026-09-21T00:00:00+09:30" start-time-utc="2026-09-19T14:30:00Z" end-time-utc="2026-09-20T14:30:00Z">
                <text type="forecast">Mostly sunny. Winds north to northwesterly 20 to 30 km/h shifting south to southwesterly during the morning. Overnight temperatures falling to between 13 and 16 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-21T00:00:00+09:30" end-time-local="2026-09-22T00:00:00+09:30" start-time-utc="2026-09-20T14:30:00Z" end-time-utc="2026-09-21T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds southerly 15 to 20 km/h turning southeasterly 15 to 25 km/h during the morning. Overnight temperatures falling to around 9 with daytime temperatures reaching between 19 and 22.</text>
            </forecast-period>
        </area>
