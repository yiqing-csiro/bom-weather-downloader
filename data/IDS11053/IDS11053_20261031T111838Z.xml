    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-10-31T21:48:39+10:30" end-time-local="2026-10-31T21:48:39+10:30" start-time-utc="2026-10-31T11:18:39Z" end-time-utc="2026-10-31T11:18:39Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system over central districts moves eastwards in Victoria overnight. A low pressure system is expected to enter from the west on Sunday, moving over central and eastern districts on Monday, followed by another ridge of high pressure which will persist until Tuesday. On Wednesday a cold front moves over the south of the state.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW013" description="North West Pastoral" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-10-31T21:00:00+10:30" end-time-local="2026-11-01T00:00:00+10:30" start-time-utc="2026-10-31T10:30:00Z" end-time-utc="2026-10-31T13:30:00Z">
                <text type="forecast">Clear. Winds east to northeasterly 15 to 25 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-01T00:00:00+10:30" end-time-local="2026-11-02T00:00:00+10:30" start-time-utc="2026-10-31T13:30:00Z" end-time-utc="2026-11-01T13:30:00Z">
                <text type="forecast">Mostly sunny. Slight chance of a shower south of Woomera, near zero chance elsewhere. The chance of a thunderstorm south of Coober Pedy in the afternoon and evening. Winds northeasterly 20 to 30 km/h tending north to northeasterly 30 to 45 km/h in the early morning then shifting south to southwesterly 15 to 25 km/h during the afternoon and evening. Overnight temperatures falling to between 18 and 23 with daytime temperatures reaching around 40.</text>
                <text type="fire_danger">High</text>
                <text type="uv_alert">Sun protection 9:10am to 5:10pm, UV Index predicted to reach 12 [Extreme]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-02T00:00:00+10:30" end-time-local="2026-11-03T00:00:00+10:30" start-time-utc="2026-11-01T13:30:00Z" end-time-utc="2026-11-02T13:30:00Z">
                <text type="forecast">Partly cloudy. The chance of a thunderstorm north of Marla at night. Winds southeast to southwesterly 25 to 35 km/h. Overnight temperatures falling to between 15 and 22 with daytime temperatures reaching 32 to 37.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-03T00:00:00+10:30" end-time-local="2026-11-04T00:00:00+10:30" start-time-utc="2026-11-02T13:30:00Z" end-time-utc="2026-11-03T13:30:00Z">
                <text type="forecast">Sunny. Winds south to southeasterly 20 to 30 km/h tending east to southeasterly during the morning then tending southeast to southwesterly 15 to 25 km/h during the afternoon. Overnight temperatures falling to between 13 and 20 with daytime temperatures reaching 31 to 36.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-11-04T00:00:00+10:30" end-time-local="2026-11-05T00:00:00+10:30" start-time-utc="2026-11-03T13:30:00Z" end-time-utc="2026-11-04T13:30:00Z">
                <text type="forecast">Sunny. Winds south to southeasterly 20 to 30 km/h. Overnight temperatures falling to between 15 and 21 with daytime temperatures reaching 29 to 35.</text>
            </forecast-period>
        </area>
