    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-10-12T17:35:10+10:30" end-time-local="2026-10-12T17:35:10+10:30" start-time-utc="2026-10-12T07:05:10Z" end-time-utc="2026-10-12T07:05:10Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough located near the northern border of SA will shift north over the next few days as a high pressure system moves across the south. The high will move into the Tasman Sea later on Thursday with a trough moving into the far west on Friday before weakening over the weekend.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW013" description="North West Pastoral" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-10-12T17:32:45+10:30" end-time-local="2026-10-13T00:00:00+10:30" start-time-utc="2026-10-12T07:02:45Z" end-time-utc="2026-10-12T13:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers. The chance of a thunderstorm, possibly severe with damaging winds, large hail and heavy rain which may lead to flash flooding north of Coober Pedy. Winds south to southeasterly 25 to 35 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-10-13T00:00:00+10:30" end-time-local="2026-10-14T00:00:00+10:30" start-time-utc="2026-10-12T13:30:00Z" end-time-utc="2026-10-13T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower north of Coober Pedy, near zero chance elsewhere. The chance of a thunderstorm. Winds southeasterly 25 to 35 km/h. Overnight temperatures falling to between 8 and 15 with daytime temperatures reaching the low to mid 20s.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:40am to 4:50pm, UV Index predicted to reach 10 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-10-14T00:00:00+10:30" end-time-local="2026-10-15T00:00:00+10:30" start-time-utc="2026-10-13T13:30:00Z" end-time-utc="2026-10-14T13:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers west of Coober Pedy in the morning and afternoon. Near zero chance of rain elsewhere. The chance of a thunderstorm in the morning and afternoon. Winds southeasterly 15 to 25 km/h turning easterly in the morning. Overnight temperatures falling to between 9 and 15 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-10-15T00:00:00+10:30" end-time-local="2026-10-16T00:00:00+10:30" start-time-utc="2026-10-14T13:30:00Z" end-time-utc="2026-10-15T13:30:00Z">
                <text type="forecast">Mostly sunny. Medium chance of showers in the far west in the evening. Near zero chance of rain elsewhere. The chance of a thunderstorm west of Coober Pedy in the afternoon and evening. Winds east to northeasterly 20 to 30 km/h. Overnight temperatures falling to between 9 and 13 with daytime temperatures reaching 24 to 29.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-10-16T00:00:00+10:30" end-time-local="2026-10-17T00:00:00+10:30" start-time-utc="2026-10-15T13:30:00Z" end-time-utc="2026-10-16T13:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers west of Coober Pedy, slight chance elsewhere. The chance of a thunderstorm. Winds east to northeasterly 15 to 25 km/h tending east to southeasterly 15 to 20 km/h during the evening. Overnight temperatures falling to between 12 and 17 with daytime temperatures reaching 25 to 30.</text>
            </forecast-period>
        </area>
