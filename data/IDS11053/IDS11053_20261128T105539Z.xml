    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-28T21:25:40+10:30" end-time-local="2026-11-28T21:25:40+10:30" start-time-utc="2026-11-28T10:55:40Z" end-time-utc="2026-11-28T10:55:40Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A ridge of high pressure continues to build across the state. A cold front will brush the far southeast on Sunday before the high begins to move across the Bight and into the Tasman Sea early next week. Another trough begins to develop over WA mid next week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW013" description="North West Pastoral" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-28T21:00:00+10:30" end-time-local="2026-11-29T00:00:00+10:30" start-time-utc="2026-11-28T10:30:00Z" end-time-utc="2026-11-28T13:30:00Z">
                <text type="forecast">Clear. Winds southerly 25 to 35 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-29T00:00:00+10:30" end-time-local="2026-11-30T00:00:00+10:30" start-time-utc="2026-11-28T13:30:00Z" end-time-utc="2026-11-29T13:30:00Z">
                <text type="forecast">Partly cloudy. Winds southerly 25 to 35 km/h. Overnight temperatures falling to between 11 and 14 with daytime temperatures reaching the mid to high 20s.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:00am to 5:30pm, UV Index predicted to reach 13 [Extreme]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-30T00:00:00+10:30" end-time-local="2026-12-01T00:00:00+10:30" start-time-utc="2026-11-29T13:30:00Z" end-time-utc="2026-11-30T13:30:00Z">
                <text type="forecast">Cloud clearing. Winds south to southeasterly 15 to 25 km/h tending east to southeasterly 15 to 20 km/h in the late evening. Overnight temperatures falling to between 12 and 15 with daytime temperatures reaching around 30.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-12-01T00:00:00+10:30" end-time-local="2026-12-02T00:00:00+10:30" start-time-utc="2026-11-30T13:30:00Z" end-time-utc="2026-12-01T13:30:00Z">
                <text type="forecast">Sunny. Winds northeast to southeasterly 15 to 20 km/h tending northwest to northeasterly 20 to 30 km/h during the morning then tending east to northeasterly 15 to 20 km/h during the evening. Overnight temperatures falling to between 12 and 17 with daytime temperatures reaching the low to mid 30s.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-12-02T00:00:00+10:30" end-time-local="2026-12-03T00:00:00+10:30" start-time-utc="2026-12-01T13:30:00Z" end-time-utc="2026-12-02T13:30:00Z">
                <text type="forecast">Sunny morning. The chance of a thunderstorm in the far west in the afternoon and evening. Winds northeasterly 15 to 20 km/h tending northwest to northeasterly 20 to 30 km/h during the morning then tending northeast to southeasterly 15 to 20 km/h during the evening. Overnight temperatures falling to around 20 with daytime temperatures reaching around 40.</text>
            </forecast-period>
        </area>
