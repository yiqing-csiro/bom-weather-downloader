    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-07-29T09:18:40+09:30" end-time-local="2026-07-29T09:18:40+09:30" start-time-utc="2026-07-28T23:48:40Z" end-time-utc="2026-07-28T23:48:40Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">Showers lingering behind a cold front in Bass Strait will ease this morning. A high pressure system will then move over the Bight today, and will extend a ridge across the state as it slowly moves east into NSW by Saturday. Another cold front is then forecast to cross the state from Saturday evening into Sunday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW013" description="North West Pastoral" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-07-29T00:00:00+09:30" end-time-local="2026-07-30T00:00:00+09:30" start-time-utc="2026-07-28T14:30:00Z" end-time-utc="2026-07-29T14:30:00Z">
                <text type="forecast">Cloudy. Winds south to southeasterly 15 to 25 km/h becoming light in the late evening. Daytime maximum temperatures around 16.</text>
                <text type="uv_alert">Sun protection 10:40am to 2:30pm, UV Index predicted to reach 4 [Moderate]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-07-30T00:00:00+09:30" end-time-local="2026-07-31T00:00:00+09:30" start-time-utc="2026-07-29T14:30:00Z" end-time-utc="2026-07-30T14:30:00Z">
                <text type="forecast">Partly cloudy. Light winds becoming easterly 15 to 25 km/h in the morning then becoming light in the early afternoon. Overnight temperatures falling to between 3 and 7 with daytime temperatures reaching between 15 and 18.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-07-31T00:00:00+09:30" end-time-local="2026-08-01T00:00:00+09:30" start-time-utc="2026-07-30T14:30:00Z" end-time-utc="2026-07-31T14:30:00Z">
                <text type="forecast">Mostly sunny. The chance of morning fog south of Woomera. Winds east to northeasterly 15 to 25 km/h tending north to northeasterly during the day then tending east to northeasterly 15 to 20 km/h during the afternoon. Overnight temperatures falling to between 2 and 5 with daytime temperatures reaching between 16 and 19.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-08-01T00:00:00+09:30" end-time-local="2026-08-02T00:00:00+09:30" start-time-utc="2026-07-31T14:30:00Z" end-time-utc="2026-08-01T14:30:00Z">
                <text type="forecast">Sunny. Areas of morning frost east of Stuart Highway. Winds north to northeasterly 20 to 30 km/h becoming light during the afternoon then becoming northeasterly 15 to 20 km/h during the evening. Overnight temperatures falling to between 2 and 5 with daytime temperatures reaching between 17 and 21.</text>
            </forecast-period>
        </area>
