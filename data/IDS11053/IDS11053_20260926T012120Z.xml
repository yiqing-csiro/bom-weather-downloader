    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-26T10:51:20+09:30" end-time-local="2026-09-26T10:51:20+09:30" start-time-utc="2026-09-26T01:21:20Z" end-time-utc="2026-09-26T01:21:20Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough over central Australia will weaken and contract into WA as a ridge of high pressure extends across southern SA on Sunday. The high pressure system is expected to drift into the Tasman Sea by Tuesday as the trough in WA begins to re-extend over western SA on Tuesday, pushing into the state on Wednesday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW013" description="North West Pastoral" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-26T00:00:00+09:30" end-time-local="2026-09-27T00:00:00+09:30" start-time-utc="2026-09-25T14:30:00Z" end-time-utc="2026-09-26T14:30:00Z">
                <text type="forecast">Mostly sunny. Slight chance of a shower in the far west, near zero chance elsewhere. The chance of a thunderstorm in the far west in the afternoon and evening. Winds north to northeasterly 25 to 35 km/h tending northeast to southeasterly 20 to 30 km/h in the evening. Daytime maximum temperatures 29 to 36.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:00am to 3:40pm, UV Index predicted to reach 9 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-27T00:00:00+09:30" end-time-local="2026-09-28T00:00:00+09:30" start-time-utc="2026-09-26T14:30:00Z" end-time-utc="2026-09-27T14:30:00Z">
                <text type="forecast">Mostly sunny morning. The chance of a thunderstorm in the far west in the late afternoon and evening. Winds northeasterly 25 to 35 km/h. Overnight temperatures falling to between 14 and 19 with daytime temperatures reaching the low to mid 30s.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-28T00:00:00+09:30" end-time-local="2026-09-29T00:00:00+09:30" start-time-utc="2026-09-27T14:30:00Z" end-time-utc="2026-09-28T14:30:00Z">
                <text type="forecast">Sunny morning. The chance of a thunderstorm in the far west in the evening. Winds northeasterly 25 to 40 km/h. Overnight temperatures falling to between 16 and 21 with daytime temperatures reaching the mid to high 30s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-29T00:00:00+09:30" end-time-local="2026-09-30T00:00:00+09:30" start-time-utc="2026-09-28T14:30:00Z" end-time-utc="2026-09-29T14:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers in the far west, most likely in the afternoon and evening. Near zero chance of rain elsewhere. The chance of a thunderstorm west of Coober Pedy in the afternoon and evening. Winds northeasterly 20 to 30 km/h tending northwest to northeasterly 30 to 45 km/h during the morning then tending southeast to southwesterly 15 to 25 km/h during the evening. Overnight temperatures falling to between 18 and 22 with daytime temperatures reaching 31 to 37.</text>
            </forecast-period>
        </area>
