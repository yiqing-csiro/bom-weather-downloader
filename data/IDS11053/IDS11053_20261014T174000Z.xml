    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-10-15T04:10:53+10:30" end-time-local="2026-10-15T04:10:53+10:30" start-time-utc="2026-10-14T17:40:53Z" end-time-utc="2026-10-14T17:40:53Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system moves southeast across waters to the south of SA, reaching the Tasman Sea later on Thursday and extends a ridge over the state until early next week. Another trough moves into the far west on Friday before weakening over the weekend.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW013" description="North West Pastoral" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-10-15T00:00:00+10:30" end-time-local="2026-10-16T00:00:00+10:30" start-time-utc="2026-10-14T13:30:00Z" end-time-utc="2026-10-15T13:30:00Z">
                <text type="forecast">Mostly sunny. Medium chance of showers west of Coober Pedy this evening. Near zero chance of rain elsewhere. The chance of a thunderstorm west of Coober Pedy late this afternoon and evening. Thunderstorms possibly severe with damaging winds, large hail and heavy rain which may lead to flash flooding in the far west late this afternoon and evening. Winds east to northeasterly 20 to 30 km/h. Daytime maximum temperatures 25 to 31.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:40am to 4:50pm, UV Index predicted to reach 10 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-10-16T00:00:00+10:30" end-time-local="2026-10-17T00:00:00+10:30" start-time-utc="2026-10-15T13:30:00Z" end-time-utc="2026-10-16T13:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers north of Marla, slight chance elsewhere. The chance of a thunderstorm. Winds east to northeasterly 20 to 30 km/h. Overnight temperatures falling to between 14 and 17 with daytime temperatures reaching 26 to 32.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-10-17T00:00:00+10:30" end-time-local="2026-10-18T00:00:00+10:30" start-time-utc="2026-10-16T13:30:00Z" end-time-utc="2026-10-17T13:30:00Z">
                <text type="forecast">Mostly sunny. Slight chance of a shower north of Marla in the afternoon. Near zero chance of rain elsewhere. The chance of a thunderstorm north of Coober Pedy in the afternoon and evening. Winds east to northeasterly 15 to 25 km/h. Overnight temperatures falling to between 13 and 18 with daytime temperatures reaching 29 to 34.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-10-18T00:00:00+10:30" end-time-local="2026-10-19T00:00:00+10:30" start-time-utc="2026-10-17T13:30:00Z" end-time-utc="2026-10-18T13:30:00Z">
                <text type="forecast">Mostly sunny. Slight chance of a shower west of Coober Pedy in the afternoon and evening. Near zero chance of rain elsewhere. The chance of a thunderstorm west of Coober Pedy in the afternoon and evening. Winds east to northeasterly 15 to 25 km/h tending north to northeasterly 25 to 35 km/h during the morning then tending east to northeasterly 15 to 25 km/h during the evening. Overnight temperatures falling to between 16 and 20 with daytime temperatures reaching 31 to 38.</text>
            </forecast-period>
        </area>
