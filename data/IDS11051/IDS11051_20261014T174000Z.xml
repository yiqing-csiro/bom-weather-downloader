    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-10-15T04:10:45+10:30" end-time-local="2026-10-15T04:10:45+10:30" start-time-utc="2026-10-14T17:40:45Z" end-time-utc="2026-10-14T17:40:45Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system moves southeast across waters to the south of SA, reaching the Tasman Sea later on Thursday and extends a ridge over the state until early next week. Another trough moves into the far west on Friday before weakening over the weekend.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW011" description="Eastern Eyre Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-10-15T00:00:00+10:30" end-time-local="2026-10-16T00:00:00+10:30" start-time-utc="2026-10-14T13:30:00Z" end-time-utc="2026-10-15T13:30:00Z">
                <text type="forecast">Partly cloudy. Light winds becoming north to northeasterly 15 to 20 km/h in the middle of the day then turning east to southeasterly 15 to 25 km/h in the early afternoon. Daytime maximum temperatures in the low to mid 20s.</text>
                <text type="fire_danger">No Rating</text>
                <text type="uv_alert">Sun protection 9:40am to 4:30pm, UV Index predicted to reach 8 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-10-16T00:00:00+10:30" end-time-local="2026-10-17T00:00:00+10:30" start-time-utc="2026-10-15T13:30:00Z" end-time-utc="2026-10-16T13:30:00Z">
                <text type="forecast">Cloud clearing. Winds easterly 15 to 20 km/h tending northeasterly 15 to 25 km/h in the early morning then turning east to southeasterly 15 to 20 km/h in the late morning and afternoon. Overnight temperatures falling to between 10 and 13 with daytime temperatures reaching the mid to high 20s.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-10-17T00:00:00+10:30" end-time-local="2026-10-18T00:00:00+10:30" start-time-utc="2026-10-16T13:30:00Z" end-time-utc="2026-10-17T13:30:00Z">
                <text type="forecast">Sunny. Light winds becoming easterly 15 to 25 km/h during the day then becoming light during the evening. Overnight temperatures falling to around 12 with daytime temperatures reaching around 30.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-10-18T00:00:00+10:30" end-time-local="2026-10-19T00:00:00+10:30" start-time-utc="2026-10-17T13:30:00Z" end-time-utc="2026-10-18T13:30:00Z">
                <text type="forecast">Mostly sunny. Winds northeasterly 15 to 25 km/h. Overnight temperatures falling to around 15 with daytime temperatures reaching the low 30s.</text>
            </forecast-period>
        </area>
