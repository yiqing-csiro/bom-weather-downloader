    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-03T21:19:49+10:30" end-time-local="2026-11-03T21:19:49+10:30" start-time-utc="2026-11-03T10:49:49Z" end-time-utc="2026-11-03T10:49:49Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system east of the Bight will weaken allowing a cold front to move across the south of the state on Wednesday. Another ridge of high pressure follows on Thursday, with another cold front clipping the southeast on Friday. Another high moves over waters to the south of SA on Saturday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW011" description="Eastern Eyre Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-03T21:00:00+10:30" end-time-local="2026-11-04T00:00:00+10:30" start-time-utc="2026-11-03T10:30:00Z" end-time-utc="2026-11-03T13:30:00Z">
                <text type="forecast">Clear. Winds south to southeasterly 15 to 20 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-04T00:00:00+10:30" end-time-local="2026-11-05T00:00:00+10:30" start-time-utc="2026-11-03T13:30:00Z" end-time-utc="2026-11-04T13:30:00Z">
                <text type="forecast">Slight chance of a shower in the morning and early afternoon. Mostly sunny afternoon. Light winds becoming southwesterly 30 to 45 km/h in the morning then tending southerly in the late afternoon. Overnight temperatures falling to around 12 with daytime temperatures reaching the low to mid 20s.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:10am to 4:50pm, UV Index predicted to reach 10 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-05T00:00:00+10:30" end-time-local="2026-11-06T00:00:00+10:30" start-time-utc="2026-11-04T13:30:00Z" end-time-utc="2026-11-05T13:30:00Z">
                <text type="forecast">Cloud clearing. Winds southeast to southwesterly 20 to 30 km/h. Overnight temperatures falling to between 6 and 11 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-06T00:00:00+10:30" end-time-local="2026-11-07T00:00:00+10:30" start-time-utc="2026-11-05T13:30:00Z" end-time-utc="2026-11-06T13:30:00Z">
                <text type="forecast">The chance of morning fog. Sunny day. Winds south to southeasterly 15 to 20 km/h tending northwest to southwesterly during the day then tending southerly 25 to 35 km/h during the afternoon. Overnight temperatures falling to between 8 and 12 with daytime temperatures reaching 25 to 30.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-11-07T00:00:00+10:30" end-time-local="2026-11-08T00:00:00+10:30" start-time-utc="2026-11-06T13:30:00Z" end-time-utc="2026-11-07T13:30:00Z">
                <text type="forecast">Mostly sunny. Winds southerly 20 to 30 km/h turning southeasterly 25 to 35 km/h during the morning. Overnight temperatures falling to between 9 and 13 with daytime temperatures reaching between 19 and 23.</text>
            </forecast-period>
        </area>
