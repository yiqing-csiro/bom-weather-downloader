    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-23T09:21:04+09:30" end-time-local="2026-09-23T09:21:04+09:30" start-time-utc="2026-09-22T23:51:04Z" end-time-utc="2026-09-22T23:51:04Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system centred over the Tasman Sea extends a ridge over SA ahead of a low pressure trough that is expected to move over the far west of SA during Wednesday. The trough will slip southeastwards over southern coasts during Thursday and Friday, before being confined to the west over the weekend.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW011" description="Eastern Eyre Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-23T00:00:00+09:30" end-time-local="2026-09-24T00:00:00+09:30" start-time-utc="2026-09-22T14:30:00Z" end-time-utc="2026-09-23T14:30:00Z">
                <text type="forecast">Sunny. Winds north to northeasterly 15 to 20 km/h tending east to northeasterly in the late afternoon. Daytime maximum temperatures around 30.</text>
                <text type="uv_alert">Sun protection 9:10am to 3:10pm, UV Index predicted to reach 6 [High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-24T00:00:00+09:30" end-time-local="2026-09-25T00:00:00+09:30" start-time-utc="2026-09-23T14:30:00Z" end-time-utc="2026-09-24T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds northerly 25 to 35 km/h shifting south to southwesterly 15 to 20 km/h in the late afternoon. Overnight temperatures falling to between 12 and 15 with daytime temperatures reaching the low 30s.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-25T00:00:00+09:30" end-time-local="2026-09-26T00:00:00+09:30" start-time-utc="2026-09-24T14:30:00Z" end-time-utc="2026-09-25T14:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower in the south, most likely in the morning. Near zero chance of rain elsewhere. Light winds becoming northeast to southeasterly 15 to 25 km/h during the morning. Overnight temperatures falling to around 14 with daytime temperatures reaching 26 to 33.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-26T00:00:00+09:30" end-time-local="2026-09-27T00:00:00+09:30" start-time-utc="2026-09-25T14:30:00Z" end-time-utc="2026-09-26T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds east to southeasterly 15 to 20 km/h tending south to southeasterly 20 to 30 km/h during the morning then tending east to southeasterly 15 to 25 km/h during the evening. Overnight temperatures falling to around 13 with daytime temperatures reaching 24 to 31.</text>
            </forecast-period>
        </area>
