    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-24T17:42:20+09:30" end-time-local="2026-09-24T17:42:20+09:30" start-time-utc="2026-09-24T08:12:20Z" end-time-utc="2026-09-24T08:12:20Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A low pressure trough extends from WA over western SA. This trough will be very slow-moving for the rest of this week and over the weekend. A weakening cold front will slip across southern coasts late Thursday and early Friday. Another low pressure trough will develop over WA on Sunday and Monday then move over SA early to mid next week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW011" description="Eastern Eyre Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-24T15:00:00+09:30" end-time-local="2026-09-25T00:00:00+09:30" start-time-utc="2026-09-24T05:30:00Z" end-time-utc="2026-09-24T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds north to northwesterly 20 to 25 km/h shifting south to southwesterly 15 to 20 km/h in the evening.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-25T00:00:00+09:30" end-time-local="2026-09-26T00:00:00+09:30" start-time-utc="2026-09-24T14:30:00Z" end-time-utc="2026-09-25T14:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower. The chance of a thunderstorm. Winds southeast to southwesterly 15 to 20 km/h tending northeast to southeasterly in the morning then tending south to southeasterly 15 to 25 km/h in the middle of the day. Overnight temperatures falling to around 13 with daytime temperatures reaching 25 to 31.</text>
                <text type="uv_alert">##</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-26T00:00:00+09:30" end-time-local="2026-09-27T00:00:00+09:30" start-time-utc="2026-09-25T14:30:00Z" end-time-utc="2026-09-26T14:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers in the south, slight chance elsewhere. Winds south to southeasterly 25 to 35 km/h. Overnight temperatures falling to around 13 with daytime temperatures reaching between 19 and 26.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-27T00:00:00+09:30" end-time-local="2026-09-28T00:00:00+09:30" start-time-utc="2026-09-26T14:30:00Z" end-time-utc="2026-09-27T14:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower in the south in the morning. Near zero chance of rain elsewhere. Winds southeasterly 20 to 30 km/h. Overnight temperatures falling to between 9 and 12 with daytime temperatures reaching between 19 and 25.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-09-28T00:00:00+09:30" end-time-local="2026-09-29T00:00:00+09:30" start-time-utc="2026-09-27T14:30:00Z" end-time-utc="2026-09-28T14:30:00Z">
                <text type="forecast">Mostly sunny. Winds easterly 15 to 25 km/h turning northeasterly 20 to 30 km/h during the day. Overnight temperatures falling to around 11 with daytime temperatures reaching around 30.</text>
            </forecast-period>
        </area>
