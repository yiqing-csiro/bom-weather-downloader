    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-04T09:20:23+10:30" end-time-local="2026-11-04T09:20:23+10:30" start-time-utc="2026-11-03T22:50:23Z" end-time-utc="2026-11-03T22:50:23Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A cold front will move across the south of the state today, clearing the east of the state in the afternoon. Another ridge of high pressure will follow on Thursday, with another cold front clipping the southeast on Friday. Another high moves over waters to the south of SA on Saturday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW011" description="Eastern Eyre Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-04T00:00:00+10:30" end-time-local="2026-11-05T00:00:00+10:30" start-time-utc="2026-11-03T13:30:00Z" end-time-utc="2026-11-04T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower near the coast in the late morning and afternoon. Near zero chance of rain elsewhere. Winds southwesterly 25 to 40 km/h turning southerly 30 to 45 km/h in the late afternoon then decreasing to 20 to 30 km/h in the late evening. Daytime maximum temperatures in the low to mid 20s.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:10am to 4:50pm, UV Index predicted to reach 10 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-05T00:00:00+10:30" end-time-local="2026-11-06T00:00:00+10:30" start-time-utc="2026-11-04T13:30:00Z" end-time-utc="2026-11-05T13:30:00Z">
                <text type="forecast">Cloud clearing. Winds south to southwesterly 15 to 25 km/h tending south to southeasterly 20 to 30 km/h during the day. Overnight temperatures falling to between 7 and 11 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-06T00:00:00+10:30" end-time-local="2026-11-07T00:00:00+10:30" start-time-utc="2026-11-05T13:30:00Z" end-time-utc="2026-11-06T13:30:00Z">
                <text type="forecast">The chance of morning fog. Sunny day. Winds south to southeasterly 15 to 20 km/h tending west to southwesterly during the day then tending southerly 25 to 35 km/h during the afternoon. Overnight temperatures falling to between 8 and 12 with daytime temperatures reaching 26 to 31.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-07T00:00:00+10:30" end-time-local="2026-11-08T00:00:00+10:30" start-time-utc="2026-11-06T13:30:00Z" end-time-utc="2026-11-07T13:30:00Z">
                <text type="forecast">Cloud clearing. Winds southerly 20 to 30 km/h turning southeasterly 25 to 35 km/h during the morning. Overnight temperatures falling to between 10 and 13 with daytime temperatures reaching between 19 and 23.</text>
            </forecast-period>
        </area>
