    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-09T15:55:51+09:30" end-time-local="2026-09-09T15:55:51+09:30" start-time-utc="2026-09-09T06:25:51Z" end-time-utc="2026-09-09T06:25:51Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system centred south of the Bight extends a ridge across the south of SA. The main high centre will gradually move eastwards to be centred to the east of SA on Friday. A trough over the interior of WA will remain stationary for most of the week and may extend into the far west of SA at times. Another low pressure trough will approach from the west on Saturday and move across SA on Sunday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW011" description="Eastern Eyre Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-09T15:00:00+09:30" end-time-local="2026-09-10T00:00:00+09:30" start-time-utc="2026-09-09T05:30:00Z" end-time-utc="2026-09-09T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds southeasterly 25 to 40 km/h decreasing to 20 to 30 km/h in the evening.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-10T00:00:00+09:30" end-time-local="2026-09-11T00:00:00+09:30" start-time-utc="2026-09-09T14:30:00Z" end-time-utc="2026-09-10T14:30:00Z">
                <text type="forecast">Sunny. Winds east to southeasterly 20 to 30 km/h. Overnight temperatures falling to between 4 and 8 with daytime temperatures reaching between 16 and 20.</text>
                <text type="uv_alert">Sun protection 9:20am to 3:10pm, UV Index predicted to reach 7 [High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-11T00:00:00+09:30" end-time-local="2026-09-12T00:00:00+09:30" start-time-utc="2026-09-10T14:30:00Z" end-time-utc="2026-09-11T14:30:00Z">
                <text type="forecast">Sunny. Winds east to southeasterly 15 to 20 km/h tending east to northeasterly in the morning then becoming light in the middle of the day. Overnight temperatures falling to around 6 with daytime temperatures reaching the low 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-12T00:00:00+09:30" end-time-local="2026-09-13T00:00:00+09:30" start-time-utc="2026-09-11T14:30:00Z" end-time-utc="2026-09-12T14:30:00Z">
                <text type="forecast">Mostly sunny. Light winds becoming north to northeasterly 15 to 25 km/h during the morning. Overnight temperatures falling to around 9 with daytime temperatures reaching the mid 20s.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-09-13T00:00:00+09:30" end-time-local="2026-09-14T00:00:00+09:30" start-time-utc="2026-09-12T14:30:00Z" end-time-utc="2026-09-13T14:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers, most likely in the morning and afternoon. The chance of a thunderstorm in the morning. Winds northerly 15 to 25 km/h turning west to northwesterly 20 to 30 km/h during the day. Overnight temperatures falling to around 14 with daytime temperatures reaching the mid to high 20s.</text>
            </forecast-period>
        </area>
