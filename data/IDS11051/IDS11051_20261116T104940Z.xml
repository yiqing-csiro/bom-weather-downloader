    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-16T21:19:40+10:30" end-time-local="2026-11-16T21:19:40+10:30" start-time-utc="2026-11-16T10:49:40Z" end-time-utc="2026-11-16T10:49:40Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system centred south of Western Australia, extends a ridge of high pressure over most of South Australia. The high and ridge will move slowly eastwards during the week to be in the Tasman Sea on Thursday. A low pressure system and associated trough over Western Australia will move over South Australia mid to late in the week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW011" description="Eastern Eyre Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-16T21:00:00+10:30" end-time-local="2026-11-17T00:00:00+10:30" start-time-utc="2026-11-16T10:30:00Z" end-time-utc="2026-11-16T13:30:00Z">
                <text type="forecast">Mostly clear. Winds south to southeasterly 15 to 25 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-17T00:00:00+10:30" end-time-local="2026-11-18T00:00:00+10:30" start-time-utc="2026-11-16T13:30:00Z" end-time-utc="2026-11-17T13:30:00Z">
                <text type="forecast">Mostly sunny. Winds south to southeasterly 15 to 20 km/h tending east to southeasterly in the early morning then tending south to southeasterly 20 to 30 km/h in the early afternoon. Overnight temperatures falling to between 8 and 11 with daytime temperatures reaching 24 to 29.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:00am to 5:00pm, UV Index predicted to reach 10 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-18T00:00:00+10:30" end-time-local="2026-11-19T00:00:00+10:30" start-time-utc="2026-11-17T13:30:00Z" end-time-utc="2026-11-18T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower, most likely in the late afternoon and evening. Winds east to southeasterly 15 to 25 km/h turning northeasterly 20 to 30 km/h in the morning then tending easterly 15 to 25 km/h in the evening. Overnight temperatures falling to between 13 and 16 with daytime temperatures reaching around 30.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-19T00:00:00+10:30" end-time-local="2026-11-20T00:00:00+10:30" start-time-utc="2026-11-18T13:30:00Z" end-time-utc="2026-11-19T13:30:00Z">
                <text type="forecast">Partly cloudy. Very high chance of showers, most likely in the morning and afternoon. A thunderstorm likely. Winds northeasterly 15 to 25 km/h increasing to 40 km/h before shifting west to northwesterly 25 to 35 km/h during the afternoon. Overnight temperatures falling to between 18 and 21 with daytime temperatures reaching the low to mid 30s.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-11-20T00:00:00+10:30" end-time-local="2026-11-21T00:00:00+10:30" start-time-utc="2026-11-19T13:30:00Z" end-time-utc="2026-11-20T13:30:00Z">
                <text type="forecast">Mostly sunny. Winds westerly 20 to 30 km/h turning south to southwesterly 15 to 25 km/h during the afternoon. Overnight temperatures falling to between 15 and 18 with daytime temperatures reaching 27 to 32.</text>
            </forecast-period>
        </area>
