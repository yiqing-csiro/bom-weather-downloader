    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-26T15:55:47+09:30" end-time-local="2026-09-26T15:55:47+09:30" start-time-utc="2026-09-26T06:25:47Z" end-time-utc="2026-09-26T06:25:47Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough over central Australia will weaken and contract into WA as a ridge of high pressure extends across southern SA on Sunday. The high pressure system is expected to drift into the Tasman Sea by Tuesday as the trough in WA begins to re-extend over western SA on Tuesday, pushing into the state on Wednesday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW011" description="Eastern Eyre Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-26T15:00:00+09:30" end-time-local="2026-09-27T00:00:00+09:30" start-time-utc="2026-09-26T05:30:00Z" end-time-utc="2026-09-26T14:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower in the south, near zero chance elsewhere. Winds south to southeasterly 25 to 35 km/h decreasing to 20 to 25 km/h in the late evening.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-27T00:00:00+09:30" end-time-local="2026-09-28T00:00:00+09:30" start-time-utc="2026-09-26T14:30:00Z" end-time-utc="2026-09-27T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds southeasterly 25 to 35 km/h turning easterly 15 to 25 km/h in the evening. Overnight temperatures falling to between 10 and 13 with daytime temperatures reaching 21 to 28.</text>
                <text type="fire_danger">No Rating</text>
                <text type="uv_alert">Sun protection 9:00am to 3:20pm, UV Index predicted to reach 7 [High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-28T00:00:00+09:30" end-time-local="2026-09-29T00:00:00+09:30" start-time-utc="2026-09-27T14:30:00Z" end-time-utc="2026-09-28T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds east to northeasterly 15 to 25 km/h tending north to northeasterly 20 to 30 km/h during the morning. Overnight temperatures falling to between 12 and 15 with daytime temperatures reaching the low to mid 30s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-29T00:00:00+09:30" end-time-local="2026-09-30T00:00:00+09:30" start-time-utc="2026-09-28T14:30:00Z" end-time-utc="2026-09-29T14:30:00Z">
                <text type="forecast">Becoming cloudy. Slight chance of a shower in the south in the evening. Near zero chance of rain elsewhere. Winds northerly 25 to 35 km/h increasing to 35 to 50 km/h during the morning then shifting south to southwesterly 20 to 30 km/h during the evening. Overnight temperatures falling to around 19 with daytime temperatures reaching the mid 30s.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-09-30T00:00:00+09:30" end-time-local="2026-10-01T00:00:00+09:30" start-time-utc="2026-09-29T14:30:00Z" end-time-utc="2026-09-30T14:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers. The chance of a thunderstorm. Winds southeast to southwesterly 15 to 20 km/h tending north to northwesterly during the morning then tending northeast to southeasterly during the evening. Overnight temperatures falling to between 13 and 16 with daytime temperatures reaching 24 to 29.</text>
            </forecast-period>
        </area>
