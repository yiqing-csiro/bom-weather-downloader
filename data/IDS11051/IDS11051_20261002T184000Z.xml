    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-10-03T04:10:44+09:30" end-time-local="2026-10-03T04:10:44+09:30" start-time-utc="2026-10-02T18:40:44Z" end-time-utc="2026-10-02T18:40:44Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A low pressure system developing in Victoria will move east. In the west, a high pressure system will move into the Bight and slowly move east to be centred over Victoria on Monday, while extending a ridge into parts of the state. Another trough near the WA border is expected to develop from Saturday and extend into the state before weakening by Monday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW011" description="Eastern Eyre Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-10-03T00:00:00+09:30" end-time-local="2026-10-04T00:00:00+09:30" start-time-utc="2026-10-02T14:30:00Z" end-time-utc="2026-10-03T14:30:00Z">
                <text type="forecast">The chance of fog early this morning. Mostly sunny afternoon. Winds southerly 20 to 30 km/h. Daytime maximum temperatures between 18 and 21.</text>
                <text type="fire_danger">No Rating</text>
                <text type="uv_alert">Sun protection 8:50am to 3:30pm, UV Index predicted to reach 8 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-10-04T00:00:00+09:30" end-time-local="2026-10-05T00:00:00+10:30" start-time-utc="2026-10-03T14:30:00Z" end-time-utc="2026-10-04T13:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower, most likely in the afternoon and evening. Winds south to southeasterly 15 to 20 km/h becoming light in the evening. Overnight temperatures falling to around 9 with daytime temperatures reaching between 19 and 22.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-10-05T00:00:00+10:30" end-time-local="2026-10-06T00:00:00+10:30" start-time-utc="2026-10-04T13:30:00Z" end-time-utc="2026-10-05T13:30:00Z">
                <text type="forecast">Partly cloudy. Light winds becoming west to southwesterly 15 to 20 km/h during the day then becoming light during the evening. Overnight temperatures falling to between 8 and 11 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-10-06T00:00:00+10:30" end-time-local="2026-10-07T00:00:00+10:30" start-time-utc="2026-10-05T13:30:00Z" end-time-utc="2026-10-06T13:30:00Z">
                <text type="forecast">Partly cloudy. The chance of morning fog. Slight chance of a shower in the morning. Winds west to southwesterly 15 to 20 km/h turning south to southeasterly 20 to 30 km/h during the day. Overnight temperatures falling to between 7 and 10 with daytime temperatures reaching the low 20s.</text>
            </forecast-period>
        </area>
