    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-10-03T16:31:30+09:30" end-time-local="2026-10-03T16:31:30+09:30" start-time-utc="2026-10-03T07:01:30Z" end-time-utc="2026-10-03T07:01:30Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A ridge of high pressure lies over SA while a near stationary trough lies near there the WA border. The trough will weaken early next week while a cold front moves across the Southern Ocean and over southeast Australia on Tuesday. A high pressure system quickly moves into the Bight mid next week, maintaining the ridge over SA.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW011" description="Eastern Eyre Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-10-03T15:00:00+09:30" end-time-local="2026-10-04T00:00:00+09:30" start-time-utc="2026-10-03T05:30:00Z" end-time-utc="2026-10-03T14:30:00Z">
                <text type="forecast">Mostly clear. Winds south to southeasterly 20 to 30 km/h decreasing to 15 to 20 km/h in the evening.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-10-04T00:00:00+09:30" end-time-local="2026-10-05T00:00:00+10:30" start-time-utc="2026-10-03T14:30:00Z" end-time-utc="2026-10-04T13:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers in the late morning and afternoon. Winds southeasterly 15 to 20 km/h becoming light in the morning. Overnight temperatures falling to between 8 and 11 with daytime temperatures reaching around 19.</text>
                <text type="fire_danger">No Rating</text>
                <text type="uv_alert">Sun protection 9:40am to 4:30pm, UV Index predicted to reach 8 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-10-05T00:00:00+10:30" end-time-local="2026-10-06T00:00:00+10:30" start-time-utc="2026-10-04T13:30:00Z" end-time-utc="2026-10-05T13:30:00Z">
                <text type="forecast">Partly cloudy. Light winds becoming west to southwesterly 15 to 20 km/h in the middle of the day then becoming light in the evening. Overnight temperatures falling to between 8 and 11 with daytime temperatures reaching the low 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-10-06T00:00:00+10:30" end-time-local="2026-10-07T00:00:00+10:30" start-time-utc="2026-10-05T13:30:00Z" end-time-utc="2026-10-06T13:30:00Z">
                <text type="forecast">Partly cloudy. The chance of morning fog. Slight chance of a shower in the south in the morning. Near zero chance of rain elsewhere. Light winds becoming south to southwesterly 15 to 25 km/h during the morning then tending south to southeasterly 20 to 30 km/h during the afternoon. Overnight temperatures falling to between 7 and 10 with daytime temperatures reaching the low 20s.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-10-07T00:00:00+10:30" end-time-local="2026-10-08T00:00:00+10:30" start-time-utc="2026-10-06T13:30:00Z" end-time-utc="2026-10-07T13:30:00Z">
                <text type="forecast">Sunny. Winds northeast to southeasterly 15 to 20 km/h tending north to northeasterly during the day then tending east to northeasterly during the afternoon. Overnight temperatures falling to between 7 and 10 with daytime temperatures reaching the mid to high 20s.</text>
            </forecast-period>
        </area>
