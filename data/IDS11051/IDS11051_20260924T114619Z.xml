    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-24T21:16:19+09:30" end-time-local="2026-09-24T21:16:19+09:30" start-time-utc="2026-09-24T11:46:19Z" end-time-utc="2026-09-24T11:46:19Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A low pressure trough extends from WA over western SA. This trough will be very slow-moving for the rest of this week and over the weekend. A weakening cold front will slip across southern coasts late Thursday and early Friday. Another low pressure trough will develop over WA on Sunday and Monday then move over SA early to mid next week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW011" description="Eastern Eyre Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-24T21:00:00+09:30" end-time-local="2026-09-25T00:00:00+09:30" start-time-utc="2026-09-24T11:30:00Z" end-time-utc="2026-09-24T14:30:00Z">
                <text type="forecast">Cloudy. Winds south to southwesterly 15 to 20 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-25T00:00:00+09:30" end-time-local="2026-09-26T00:00:00+09:30" start-time-utc="2026-09-24T14:30:00Z" end-time-utc="2026-09-25T14:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers in the south, slight chance elsewhere. The chance of a thunderstorm. Winds southeast to southwesterly 15 to 20 km/h tending northeast to southeasterly in the middle of the day then tending south to southeasterly 15 to 25 km/h in the early afternoon. Overnight temperatures falling to between 12 and 15 with daytime temperatures reaching 25 to 31.</text>
                <text type="uv_alert">##</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-26T00:00:00+09:30" end-time-local="2026-09-27T00:00:00+09:30" start-time-utc="2026-09-25T14:30:00Z" end-time-utc="2026-09-26T14:30:00Z">
                <text type="forecast">Cloudy. High chance of showers in the south, slight chance elsewhere. Winds south to southeasterly 25 to 35 km/h. Overnight temperatures falling to around 13 with daytime temperatures reaching between 18 and 26.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-27T00:00:00+09:30" end-time-local="2026-09-28T00:00:00+09:30" start-time-utc="2026-09-26T14:30:00Z" end-time-utc="2026-09-27T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds southeasterly 20 to 30 km/h turning easterly 15 to 25 km/h during the day. Overnight temperatures falling to around 11 with daytime temperatures reaching 21 to 29.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-09-28T00:00:00+09:30" end-time-local="2026-09-29T00:00:00+09:30" start-time-utc="2026-09-27T14:30:00Z" end-time-utc="2026-09-28T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds east to northeasterly 15 to 25 km/h tending north to northeasterly 20 to 30 km/h during the morning. Overnight temperatures falling to around 13 with daytime temperatures reaching the low 30s.</text>
            </forecast-period>
        </area>
