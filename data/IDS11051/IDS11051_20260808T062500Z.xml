        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-08-08T15:55:44+09:30" end-time-local="2026-08-08T15:55:44+09:30" start-time-utc="2026-08-08T06:25:44Z" end-time-utc="2026-08-08T06:25:44Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A vigorous cold front and will move across the west of SA late Saturday then moving across remaining parts of the State on Sunday. A high pressure system moves just to the north on Monday, ahead of another cold front forecast to move across South Australia on Tuesday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW011" description="Eastern Eyre Peninsula" type="public-district" parent-aac="SA_FA001">
            <warning-summary type="sheep_graziers_warning" start-time-local="2026-08-08T10:50:00+09:30" end-time-local="2026-08-10T00:00:00+09:30" start-time-utc="2026-08-08T01:20:00Z" end-time-utc="2026-08-09T14:30:00Z">Warning to Sheep Graziers</warning-summary>
            <forecast-period index="0" start-time-local="2026-08-08T15:00:00+09:30" end-time-local="2026-08-09T00:00:00+09:30" start-time-utc="2026-08-08T05:30:00Z" end-time-utc="2026-08-08T14:30:00Z">
                <text type="forecast">Cloudy. Very high chance of rain, most likely later this evening. Winds northerly 25 to 35 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-08-09T00:00:00+09:30" end-time-local="2026-08-10T00:00:00+09:30" start-time-utc="2026-08-08T14:30:00Z" end-time-utc="2026-08-09T14:30:00Z">
                <text type="forecast">Cloudy. Very high chance of showers. The chance of a thunderstorm in the morning. Winds northerly 20 to 30 km/h turning westerly 30 to 45 km/h in the late morning. Overnight temperatures falling to around 10 with daytime temperatures reaching around 14.</text>
                <text type="uv_alert">Sun protection 11:30am to 1:00pm, UV Index predicted to reach 3 [Moderate]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-08-10T00:00:00+09:30" end-time-local="2026-08-11T00:00:00+09:30" start-time-utc="2026-08-09T14:30:00Z" end-time-utc="2026-08-10T14:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers, most likely in the early morning. Winds west to southwesterly 25 to 40 km/h decreasing to 25 to 35 km/h in the early morning then turning northwesterly 15 to 20 km/h in the evening. Overnight temperatures falling to between 6 and 9 with daytime temperatures reaching around 15.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-08-11T00:00:00+09:30" end-time-local="2026-08-12T00:00:00+09:30" start-time-utc="2026-08-10T14:30:00Z" end-time-utc="2026-08-11T14:30:00Z">
                <text type="forecast">Partly cloudy. Very high chance of showers, most likely in the afternoon and evening with possible small hail. Winds northwesterly 15 to 25 km/h tending north to northwesterly 25 to 40 km/h during the morning then turning westerly 20 to 30 km/h during the afternoon. Overnight temperatures falling to between 5 and 8 with daytime temperatures reaching between 16 and 19.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-08-12T00:00:00+09:30" end-time-local="2026-08-13T00:00:00+09:30" start-time-utc="2026-08-11T14:30:00Z" end-time-utc="2026-08-12T14:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers, most likely in the morning and afternoon. Winds westerly 20 to 30 km/h tending southwesterly during the day then becoming light during the evening. Overnight temperatures falling to around 5 with daytime temperatures reaching around 16.</text>
            </forecast-period>
        </area>
