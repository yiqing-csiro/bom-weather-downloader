        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-12T21:18:12+10:30" end-time-local="2026-11-12T21:18:12+10:30" start-time-utc="2026-11-12T10:48:12Z" end-time-utc="2026-11-12T10:48:12Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A ridge of high pressure lies over water south of the Bight and will weaken this evening. A low pressure system over Western Australian will move over South Australia on Friday, with an associated trough. A ridge of high pressure will follow and persist into early next week. A cold front clips the southeast on Sunday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW004" description="Upper South East" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-12T21:00:00+10:30" end-time-local="2026-11-13T00:00:00+10:30" start-time-utc="2026-11-12T10:30:00Z" end-time-utc="2026-11-12T13:30:00Z">
                <text type="forecast">Partly cloudy. Winds southerly 15 to 20 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-13T00:00:00+10:30" end-time-local="2026-11-14T00:00:00+10:30" start-time-utc="2026-11-12T13:30:00Z" end-time-utc="2026-11-13T13:30:00Z">
                <text type="forecast">Cloudy. High chance of showers, most likely in the morning and early afternoon. Light winds becoming south to southwesterly 15 to 25 km/h in the middle of the day. Overnight temperatures falling to around 12 with daytime temperatures reaching the low to mid 20s.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:00am to 4:40pm, UV Index predicted to reach 10 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-14T00:00:00+10:30" end-time-local="2026-11-15T00:00:00+10:30" start-time-utc="2026-11-13T13:30:00Z" end-time-utc="2026-11-14T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower. Light winds becoming southerly 15 to 20 km/h in the early morning then tending southwesterly 20 to 30 km/h in the morning. Overnight temperatures falling to around 10 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-15T00:00:00+10:30" end-time-local="2026-11-16T00:00:00+10:30" start-time-utc="2026-11-14T13:30:00Z" end-time-utc="2026-11-15T13:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers, most likely in the morning. Winds southwesterly 15 to 20 km/h increasing to 25 to 35 km/h during the morning then turning southerly during the afternoon. Overnight temperatures falling to between 6 and 10 with daytime temperatures reaching the low 20s.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-11-16T00:00:00+10:30" end-time-local="2026-11-17T00:00:00+10:30" start-time-utc="2026-11-15T13:30:00Z" end-time-utc="2026-11-16T13:30:00Z">
                <text type="forecast">Cloudy. Winds southerly 20 to 30 km/h becoming light during the evening. Overnight temperatures falling to around 5 with daytime temperatures reaching the low 20s.</text>
            </forecast-period>
        </area>
