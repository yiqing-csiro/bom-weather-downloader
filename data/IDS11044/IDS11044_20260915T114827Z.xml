            <forecast-period index="2" start-time-local="2026-09-17T00:00:00+09:30" end-time-local="2026-09-18T00:00:00+09:30" start-time-utc="2026-09-16T14:30:00Z" end-time-utc="2026-09-17T14:30:00Z">
                <text type="forecast">Areas of frost and the chance of fog in the morning. Sunny afternoon. Light winds. Overnight temperatures falling to around 2 with daytime temperatures reaching around 17.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-18T00:00:00+09:30" end-time-local="2026-09-19T00:00:00+09:30" start-time-utc="2026-09-17T14:30:00Z" end-time-utc="2026-09-18T14:30:00Z">
                <text type="forecast">Sunny. Winds northerly 15 to 25 km/h turning west to northwesterly during the morning then becoming light during the evening. Overnight temperatures falling to around 4 with daytime temperatures reaching the low 20s.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-09-19T00:00:00+09:30" end-time-local="2026-09-20T00:00:00+09:30" start-time-utc="2026-09-18T14:30:00Z" end-time-utc="2026-09-19T14:30:00Z">
                <text type="forecast">Sunny. Light winds becoming northwesterly 15 to 20 km/h during the morning then tending northerly during the evening. Overnight temperatures falling to around 7 with daytime temperatures reaching the mid to high 20s.</text>
            </forecast-period>
