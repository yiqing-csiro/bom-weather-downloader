    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-11T21:20:33+10:30" end-time-local="2026-11-11T21:20:33+10:30" start-time-utc="2026-11-11T10:50:33Z" end-time-utc="2026-11-11T10:50:33Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system lies south of the Bight and will move into the Tasman Sea on Thursday. A low pressure system over Western Australian will move over South Australia on Friday, with an associated trough. A ridge of high pressure will follow and persist into the weekend.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW002" description="Yorke Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-11T21:00:00+10:30" end-time-local="2026-11-12T00:00:00+10:30" start-time-utc="2026-11-11T10:30:00Z" end-time-utc="2026-11-11T13:30:00Z">
                <text type="forecast">Mostly clear. Winds southeasterly 20 to 30 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-12T00:00:00+10:30" end-time-local="2026-11-13T00:00:00+10:30" start-time-utc="2026-11-11T13:30:00Z" end-time-utc="2026-11-12T13:30:00Z">
                <text type="forecast">Mostly sunny morning. Slight chance of a shower in the evening. Winds southeasterly 20 to 30 km/h. Overnight temperatures falling to between 7 and 11 with daytime temperatures reaching 23 to 29.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:00am to 4:50pm, UV Index predicted to reach 10 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-13T00:00:00+10:30" end-time-local="2026-11-14T00:00:00+10:30" start-time-utc="2026-11-12T13:30:00Z" end-time-utc="2026-11-13T13:30:00Z">
                <text type="forecast">Partly cloudy. High chance of showers, most likely in the morning. The chance of a thunderstorm in the morning and early afternoon. Winds southeasterly 15 to 25 km/h tending northwest to southwesterly 20 to 25 km/h in the early afternoon then tending southerly 20 to 30 km/h in the late afternoon. Overnight temperatures falling to around 13 with daytime temperatures reaching 23 to 28.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-14T00:00:00+10:30" end-time-local="2026-11-15T00:00:00+10:30" start-time-utc="2026-11-13T13:30:00Z" end-time-utc="2026-11-14T13:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower. Winds southerly 25 to 35 km/h. Overnight temperatures falling to around 12 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-11-15T00:00:00+10:30" end-time-local="2026-11-16T00:00:00+10:30" start-time-utc="2026-11-14T13:30:00Z" end-time-utc="2026-11-15T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower. Winds southerly 25 to 35 km/h. Overnight temperatures falling to around 10 with daytime temperatures reaching the low 20s.</text>
            </forecast-period>
        </area>
