            <forecast-period index="3" start-time-local="2026-09-19T00:00:00+09:30" end-time-local="2026-09-20T00:00:00+09:30" start-time-utc="2026-09-18T14:30:00Z" end-time-utc="2026-09-19T14:30:00Z">
                <text type="forecast">Sunny. Winds northerly 20 to 30 km/h. Overnight temperatures falling to between 7 and 11 with daytime temperatures reaching 22 to 27.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-09-20T00:00:00+09:30" end-time-local="2026-09-21T00:00:00+09:30" start-time-utc="2026-09-19T14:30:00Z" end-time-utc="2026-09-20T14:30:00Z">
                <text type="forecast">Mostly sunny. Winds north to northwesterly 25 to 40 km/h turning west to southwesterly 25 to 35 km/h during the morning. Overnight temperatures falling to around 14 with daytime temperatures reaching 20 to 25.</text>
