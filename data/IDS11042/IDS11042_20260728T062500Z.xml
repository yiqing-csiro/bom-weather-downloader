    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-07-28T15:55:08+09:30" end-time-local="2026-07-28T15:55:08+09:30" start-time-utc="2026-07-28T06:25:08Z" end-time-utc="2026-07-28T06:25:08Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A cold front will clip the far southeast on Tuesday evening, before moving out to the east overnight. A high pressure system will then move over the Bight on Wednesday, and will extend a ridge across the state as it slowly moves east into NSW by Saturday. Another cold front is then forecast to cross the state from Saturday evening into Sunday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW002" description="Yorke Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-07-28T15:00:00+09:30" end-time-local="2026-07-29T00:00:00+09:30" start-time-utc="2026-07-28T05:30:00Z" end-time-utc="2026-07-28T14:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers, becoming less likely later tonight. Winds westerly 25 to 35 km/h turning southwesterly 20 to 30 km/h in the late afternoon.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-07-29T00:00:00+09:30" end-time-local="2026-07-30T00:00:00+09:30" start-time-utc="2026-07-28T14:30:00Z" end-time-utc="2026-07-29T14:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower. Winds southwesterly 15 to 25 km/h becoming light in the late afternoon. Overnight temperatures falling to around 6 with daytime temperatures reaching around 15.</text>
                <text type="uv_alert">Sun protection 11:50am to 1:00pm, UV Index predicted to reach 3 [Moderate]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-07-30T00:00:00+09:30" end-time-local="2026-07-31T00:00:00+09:30" start-time-utc="2026-07-29T14:30:00Z" end-time-utc="2026-07-30T14:30:00Z">
                <text type="forecast">Cloudy. The chance of morning fog in the north. Slight chance of a shower, most likely in the late morning and afternoon. Light winds. Overnight temperatures falling to between 3 and 6 with daytime temperatures reaching around 14.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-07-31T00:00:00+09:30" end-time-local="2026-08-01T00:00:00+09:30" start-time-utc="2026-07-30T14:30:00Z" end-time-utc="2026-07-31T14:30:00Z">
                <text type="forecast">Cloudy. Light winds. Overnight temperatures falling to around 4 with daytime temperatures reaching around 15.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-08-01T00:00:00+09:30" end-time-local="2026-08-02T00:00:00+09:30" start-time-utc="2026-07-31T14:30:00Z" end-time-utc="2026-08-01T14:30:00Z">
                <text type="forecast">Mostly sunny. Winds north to northeasterly 15 to 25 km/h. Overnight temperatures falling to between 3 and 6 with daytime temperatures reaching around 15.</text>
