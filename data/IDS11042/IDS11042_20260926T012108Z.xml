    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-26T10:51:09+09:30" end-time-local="2026-09-26T10:51:09+09:30" start-time-utc="2026-09-26T01:21:09Z" end-time-utc="2026-09-26T01:21:09Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough over central Australia will weaken and contract into WA as a ridge of high pressure extends across southern SA on Sunday. The high pressure system is expected to drift into the Tasman Sea by Tuesday as the trough in WA begins to re-extend over western SA on Tuesday, pushing into the state on Wednesday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW002" description="Yorke Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-26T00:00:00+09:30" end-time-local="2026-09-27T00:00:00+09:30" start-time-utc="2026-09-25T14:30:00Z" end-time-utc="2026-09-26T14:30:00Z">
                <text type="forecast">Cloudy. Very high chance of showers in the south, medium chance elsewhere. Winds southeasterly 25 to 35 km/h. Daytime maximum temperatures between 17 and 22.</text>
                <text type="fire_danger">No Rating</text>
                <text type="uv_alert">Sun protection 9:10am to 3:10pm, UV Index predicted to reach 7 [High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-27T00:00:00+09:30" end-time-local="2026-09-28T00:00:00+09:30" start-time-utc="2026-09-26T14:30:00Z" end-time-utc="2026-09-27T14:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower in the south, most likely in the early morning. Near zero chance of rain elsewhere. Winds southeasterly 25 to 35 km/h turning easterly 20 to 30 km/h in the evening. Overnight temperatures falling to around 9 with daytime temperatures reaching between 18 and 26.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-28T00:00:00+09:30" end-time-local="2026-09-29T00:00:00+09:30" start-time-utc="2026-09-27T14:30:00Z" end-time-utc="2026-09-28T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds easterly 20 to 30 km/h turning northeasterly during the morning. Overnight temperatures falling to around 11 with daytime temperatures reaching 25 to 31.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-29T00:00:00+09:30" end-time-local="2026-09-30T00:00:00+09:30" start-time-utc="2026-09-28T14:30:00Z" end-time-utc="2026-09-29T14:30:00Z">
                <text type="forecast">Becoming cloudy. Slight chance of a shower in the south in the evening. Near zero chance of rain elsewhere. Winds northeasterly 20 to 30 km/h tending northerly 25 to 40 km/h during the morning then tending northwest to southwesterly 15 to 20 km/h during the evening. Overnight temperatures falling to around 17 with daytime temperatures reaching 26 to 34.</text>
            </forecast-period>
        </area>
