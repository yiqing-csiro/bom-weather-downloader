    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-13T09:46:04+09:30" end-time-local="2026-09-13T09:46:04+09:30" start-time-utc="2026-09-13T00:16:04Z" end-time-utc="2026-09-13T00:16:04Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough will move across SA today ahead of a high pressure ridge that will build in the wake. A cold front will then slip across southern coasts late Monday and early Tuesday, before the high moves across waters to the south to be centred over Victoria by Thursday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW002" description="Yorke Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-13T00:00:00+09:30" end-time-local="2026-09-14T00:00:00+09:30" start-time-utc="2026-09-12T14:30:00Z" end-time-utc="2026-09-13T14:30:00Z">
                <text type="forecast">Medium chance of showers, becoming less likely in the afternoon. Mostly sunny afternoon. Winds northwesterly 25 to 40 km/h turning west to southwesterly 20 to 30 km/h in the late morning and early afternoon. Daytime maximum temperatures between 19 and 22.</text>
                <text type="uv_alert">Sun protection 9:30am to 3:10pm, UV Index predicted to reach 6 [High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-14T00:00:00+09:30" end-time-local="2026-09-15T00:00:00+09:30" start-time-utc="2026-09-13T14:30:00Z" end-time-utc="2026-09-14T14:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower. Winds westerly 15 to 25 km/h turning southwesterly 15 to 20 km/h during the afternoon and evening. Overnight temperatures falling to between 8 and 11 with daytime temperatures reaching around 18.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-15T00:00:00+09:30" end-time-local="2026-09-16T00:00:00+09:30" start-time-utc="2026-09-14T14:30:00Z" end-time-utc="2026-09-15T14:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower in the north in the morning. Near zero chance of rain elsewhere. Winds southwesterly 15 to 25 km/h tending southerly 20 to 30 km/h during the morning then tending southeasterly 15 to 25 km/h during the evening. Overnight temperatures falling to around 8 with daytime temperatures reaching around 17.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-16T00:00:00+09:30" end-time-local="2026-09-17T00:00:00+09:30" start-time-utc="2026-09-15T14:30:00Z" end-time-utc="2026-09-16T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds southeasterly 20 to 30 km/h. Overnight temperatures falling to between 4 and 9 with daytime temperatures reaching around 16.</text>
            </forecast-period>
        </area>
