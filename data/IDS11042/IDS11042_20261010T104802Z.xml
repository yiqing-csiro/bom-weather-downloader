    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-10-10T21:18:02+10:30" end-time-local="2026-10-10T21:18:02+10:30" start-time-utc="2026-10-10T10:48:02Z" end-time-utc="2026-10-10T10:48:02Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough and cold front cross SA on Sunday and clear to the east by late Monday. A ridge of high pressure will then extend into SA, with the associated high moving into waters south from Tuesday. A trough in the interior of WA will also extend into northern SA at times from Monday until later in the week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW002" description="Yorke Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-10-10T21:00:00+10:30" end-time-local="2026-10-11T00:00:00+10:30" start-time-utc="2026-10-10T10:30:00Z" end-time-utc="2026-10-10T13:30:00Z">
                <text type="forecast">Clear. Light winds.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-10-11T00:00:00+10:30" end-time-local="2026-10-12T00:00:00+10:30" start-time-utc="2026-10-10T13:30:00Z" end-time-utc="2026-10-11T13:30:00Z">
                <text type="forecast">Partly cloudy. High chance of showers in the north, medium chance elsewhere. The chance of a thunderstorm in the afternoon and evening, possibly severe with damaging winds. Winds north to northeasterly 25 to 35 km/h increasing to 40 km/h before shifting southwesterly 15 to 20 km/h in the evening. Overnight temperatures falling to around 10 with daytime temperatures reaching around 30.</text>
                <text type="fire_danger">No Rating</text>
                <text type="uv_alert">Sun protection 9:40am to 4:30pm, UV Index predicted to reach 8 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-10-12T00:00:00+10:30" end-time-local="2026-10-13T00:00:00+10:30" start-time-utc="2026-10-11T13:30:00Z" end-time-utc="2026-10-12T13:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers in the north, slight chance elsewhere. The chance of a thunderstorm in the early morning. Winds south to southwesterly 20 to 30 km/h. Overnight temperatures falling to around 11 with daytime temperatures reaching between 18 and 21.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-10-13T00:00:00+10:30" end-time-local="2026-10-14T00:00:00+10:30" start-time-utc="2026-10-12T13:30:00Z" end-time-utc="2026-10-13T13:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower. Winds south to southwesterly 15 to 20 km/h tending south to southeasterly 20 to 30 km/h during the day. Overnight temperatures falling to between 6 and 10 with daytime temperatures reaching around 19.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-10-14T00:00:00+10:30" end-time-local="2026-10-15T00:00:00+10:30" start-time-utc="2026-10-13T13:30:00Z" end-time-utc="2026-10-14T13:30:00Z">
                <text type="forecast">Partly cloudy. Winds southeasterly 15 to 25 km/h. Overnight temperatures falling to between 4 and 10 with daytime temperatures reaching between 17 and 20.</text>
            </forecast-period>
        </area>
