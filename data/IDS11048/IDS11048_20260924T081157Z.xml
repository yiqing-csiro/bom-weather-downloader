        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-24T17:41:57+09:30" end-time-local="2026-09-24T17:41:57+09:30" start-time-utc="2026-09-24T08:11:57Z" end-time-utc="2026-09-24T08:11:57Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A low pressure trough extends from WA over western SA. This trough will be very slow-moving for the rest of this week and over the weekend. A weakening cold front will slip across southern coasts late Thursday and early Friday. Another low pressure trough will develop over WA on Sunday and Monday then move over SA early to mid next week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW008" description="Mid North" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-24T15:00:00+09:30" end-time-local="2026-09-25T00:00:00+09:30" start-time-utc="2026-09-24T05:30:00Z" end-time-utc="2026-09-24T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds west to northwesterly 15 to 20 km/h becoming light in the late afternoon.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-25T00:00:00+09:30" end-time-local="2026-09-26T00:00:00+09:30" start-time-utc="2026-09-24T14:30:00Z" end-time-utc="2026-09-25T14:30:00Z">
                <text type="forecast">Partly cloudy. Light winds becoming south to southwesterly 15 to 20 km/h in the middle of the day then becoming light in the evening. Overnight temperatures falling to between 10 and 13 with daytime temperatures reaching 25 to 30.</text>
                <text type="uv_alert">##</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-26T00:00:00+09:30" end-time-local="2026-09-27T00:00:00+09:30" start-time-utc="2026-09-25T14:30:00Z" end-time-utc="2026-09-26T14:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower in the south, near zero chance elsewhere. Light winds becoming east to southeasterly 15 to 20 km/h in the morning then tending south to southeasterly 20 to 30 km/h in the middle of the day. Overnight temperatures falling to around 12 with daytime temperatures reaching 22 to 27.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-27T00:00:00+09:30" end-time-local="2026-09-28T00:00:00+09:30" start-time-utc="2026-09-26T14:30:00Z" end-time-utc="2026-09-27T14:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower in the south, near zero chance elsewhere. Winds east to southeasterly 20 to 30 km/h. Overnight temperatures falling to between 6 and 9 with daytime temperatures reaching between 18 and 24.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-09-28T00:00:00+09:30" end-time-local="2026-09-29T00:00:00+09:30" start-time-utc="2026-09-27T14:30:00Z" end-time-utc="2026-09-28T14:30:00Z">
                <text type="forecast">Mostly sunny. Winds easterly 20 to 30 km/h turning northeasterly 15 to 25 km/h during the day. Overnight temperatures falling to between 6 and 10 with daytime temperatures reaching 22 to 27.</text>
            </forecast-period>
        </area>
