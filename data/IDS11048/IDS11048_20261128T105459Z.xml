    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-28T21:24:59+10:30" end-time-local="2026-11-28T21:24:59+10:30" start-time-utc="2026-11-28T10:54:59Z" end-time-utc="2026-11-28T10:54:59Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A ridge of high pressure continues to build across the state. A cold front will brush the far southeast on Sunday before the high begins to move across the Bight and into the Tasman Sea early next week. Another trough begins to develop over WA mid next week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW008" description="Mid North" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-28T21:00:00+10:30" end-time-local="2026-11-29T00:00:00+10:30" start-time-utc="2026-11-28T10:30:00Z" end-time-utc="2026-11-28T13:30:00Z">
                <text type="forecast">Mostly clear. Slight chance of a shower in the south, near zero chance elsewhere. Winds southwesterly 20 to 30 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-29T00:00:00+10:30" end-time-local="2026-11-30T00:00:00+10:30" start-time-utc="2026-11-28T13:30:00Z" end-time-utc="2026-11-29T13:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers in the south, slight chance elsewhere. Winds southwesterly 25 to 40 km/h. Overnight temperatures falling to between 8 and 12 with daytime temperatures reaching the low 20s.</text>
                <text type="fire_danger">High</text>
                <text type="uv_alert">Sun protection 8:50am to 5:20pm, UV Index predicted to reach 12 [Extreme]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-30T00:00:00+10:30" end-time-local="2026-12-01T00:00:00+10:30" start-time-utc="2026-11-29T13:30:00Z" end-time-utc="2026-11-30T13:30:00Z">
                <text type="forecast">Cloud clearing. Winds southeast to southwesterly 15 to 25 km/h becoming southeasterly 15 to 20 km/h in the late evening. Overnight temperatures falling to around 10 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-12-01T00:00:00+10:30" end-time-local="2026-12-02T00:00:00+10:30" start-time-utc="2026-11-30T13:30:00Z" end-time-utc="2026-12-01T13:30:00Z">
                <text type="forecast">Sunny. Winds east to northeasterly 15 to 20 km/h turning north to northwesterly 15 to 25 km/h during the morning. Overnight temperatures falling to around 9 with daytime temperatures reaching around 30.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-12-02T00:00:00+10:30" end-time-local="2026-12-03T00:00:00+10:30" start-time-utc="2026-12-01T13:30:00Z" end-time-utc="2026-12-02T13:30:00Z">
                <text type="forecast">Sunny. Winds north to northwesterly 20 to 30 km/h tending west to northwesterly during the day then becoming light during the evening. Overnight temperatures falling to around 17 with daytime temperatures reaching the mid to high 30s.</text>
            </forecast-period>
        </area>
