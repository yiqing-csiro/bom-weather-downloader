    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-07-28T15:55:38+09:30" end-time-local="2026-07-28T15:55:38+09:30" start-time-utc="2026-07-28T06:25:38Z" end-time-utc="2026-07-28T06:25:38Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A cold front will clip the far southeast on Tuesday evening, before moving out to the east overnight. A high pressure system will then move over the Bight on Wednesday, and will extend a ridge across the state as it slowly moves east into NSW by Saturday. Another cold front is then forecast to cross the state from Saturday evening into Sunday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW009" description="Flinders" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-07-28T15:00:00+09:30" end-time-local="2026-07-29T00:00:00+09:30" start-time-utc="2026-07-28T05:30:00Z" end-time-utc="2026-07-28T14:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower south of Hawker, near zero chance elsewhere. Winds westerly 15 to 25 km/h turning southwesterly 15 to 20 km/h in the late afternoon.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-07-29T00:00:00+09:30" end-time-local="2026-07-30T00:00:00+09:30" start-time-utc="2026-07-28T14:30:00Z" end-time-utc="2026-07-29T14:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers near the coast, slight chance elsewhere. Winds southwesterly 15 to 20 km/h tending southerly in the early morning then becoming light in the evening. Overnight temperatures falling to between 2 and 6 with daytime temperatures reaching between 11 and 15.</text>
                <text type="uv_alert">Sun protection 11:10am to 1:50pm, UV Index predicted to reach 3 [Moderate]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-07-30T00:00:00+09:30" end-time-local="2026-07-31T00:00:00+09:30" start-time-utc="2026-07-29T14:30:00Z" end-time-utc="2026-07-30T14:30:00Z">
                <text type="forecast">Cloudy. The chance of morning fog south of Hawker. Light winds becoming east to southeasterly 15 to 20 km/h in the middle of the day then becoming light in the early afternoon. Overnight temperatures falling to between 1 and 4 with daytime temperatures reaching between 12 and 16.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-07-31T00:00:00+09:30" end-time-local="2026-08-01T00:00:00+09:30" start-time-utc="2026-07-30T14:30:00Z" end-time-utc="2026-07-31T14:30:00Z">
                <text type="forecast">Partly cloudy. Areas of morning frost on and east of the ranges. Light winds becoming easterly 15 to 20 km/h during the evening. Overnight temperatures falling to between 1 and 5 with daytime temperatures reaching between 11 and 16.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-08-01T00:00:00+09:30" end-time-local="2026-08-02T00:00:00+09:30" start-time-utc="2026-07-31T14:30:00Z" end-time-utc="2026-08-01T14:30:00Z">
                <text type="forecast">Sunny. Areas of morning frost. Winds east to northeasterly 15 to 20 km/h tending northwest to northeasterly during the day. Overnight temperatures falling to between minus 1 and 3 above zero with daytime temperatures reaching between 13 and 17.</text>
            </forecast-period>
        </area>
