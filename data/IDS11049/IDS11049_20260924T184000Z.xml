            <forecast-period index="3" start-time-local="2026-09-28T00:00:00+09:30" end-time-local="2026-09-29T00:00:00+09:30" start-time-utc="2026-09-27T14:30:00Z" end-time-utc="2026-09-28T14:30:00Z">
