    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-10-08T09:20:39+10:30" end-time-local="2026-10-08T09:20:39+10:30" start-time-utc="2026-10-07T22:50:39Z" end-time-utc="2026-10-07T22:50:39Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough ahead of a strong cold front is expected move over western SA today, and track east across the rest of SA on Friday. A ridge remains over northern SA on Saturday while a series of troughs and cold fronts move across the state early next week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW009" description="Flinders" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-10-08T00:00:00+10:30" end-time-local="2026-10-09T00:00:00+10:30" start-time-utc="2026-10-07T13:30:00Z" end-time-utc="2026-10-08T13:30:00Z">
                <text type="forecast">Sunny. Winds north to northeasterly 15 to 25 km/h. Daytime maximum temperatures around 30.</text>
                <text type="fire_danger">No Rating</text>
                <text type="uv_alert">Sun protection 9:30am to 4:40pm, UV Index predicted to reach 9 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-10-09T00:00:00+10:30" end-time-local="2026-10-10T00:00:00+10:30" start-time-utc="2026-10-08T13:30:00Z" end-time-utc="2026-10-09T13:30:00Z">
                <text type="forecast">Cloudy. Very high chance of showers, most likely from the late morning. The chance of a thunderstorm in the afternoon and evening, possibly severe with damaging winds west of the ranges. Winds north to northeasterly 20 to 30 km/h turning west to northwesterly in the late morning and afternoon. Overnight temperatures falling to between 12 and 19 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-10-10T00:00:00+10:30" end-time-local="2026-10-11T00:00:00+10:30" start-time-utc="2026-10-09T13:30:00Z" end-time-utc="2026-10-10T13:30:00Z">
                <text type="forecast">Cloud clearing. Winds westerly 20 to 30 km/h becoming light during the evening. Overnight temperatures falling to between 7 and 10 with daytime temperatures reaching the low 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-10-11T00:00:00+10:30" end-time-local="2026-10-12T00:00:00+10:30" start-time-utc="2026-10-10T13:30:00Z" end-time-utc="2026-10-11T13:30:00Z">
                <text type="forecast">Sunny morning. Medium chance of showers, most likely in the afternoon and evening. The chance of a thunderstorm in the afternoon and evening. Winds east to northeasterly 15 to 20 km/h turning north to northwesterly 20 to 30 km/h during the morning. Overnight temperatures falling to between 6 and 11 with daytime temperatures reaching around 30.</text>
            </forecast-period>
        </area>
