        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-24T09:20:16+10:30" end-time-local="2026-11-24T09:20:16+10:30" start-time-utc="2026-11-23T22:50:16Z" end-time-utc="2026-11-23T22:50:16Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough of low pressure over the far northeast will linger over the far northeast until mid week. A high pressure system in the Bight will move across southern parts of the state today, then out over the Tasman sea by Wednesday morning. A trough of low pressure approaches the western border on Wednesday then moves across the west and north of the State on Thursday and eastern parts on Friday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW009" description="Flinders" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-24T00:00:00+10:30" end-time-local="2026-11-25T00:00:00+10:30" start-time-utc="2026-11-23T13:30:00Z" end-time-utc="2026-11-24T13:30:00Z">
                <text type="forecast">Mostly sunny. Winds northeast to southeasterly 15 to 25 km/h. Daytime maximum temperatures 25 to 30.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:00am to 5:10pm, UV Index predicted to reach 11 [Extreme]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-25T00:00:00+10:30" end-time-local="2026-11-26T00:00:00+10:30" start-time-utc="2026-11-24T13:30:00Z" end-time-utc="2026-11-25T13:30:00Z">
                <text type="forecast">Sunny. Winds east to northeasterly 15 to 20 km/h tending northwest to northeasterly in the morning then tending northeast to southeasterly in the late afternoon. Overnight temperatures falling to between 11 and 16 with daytime temperatures reaching the low to mid 30s.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-26T00:00:00+10:30" end-time-local="2026-11-27T00:00:00+10:30" start-time-utc="2026-11-25T13:30:00Z" end-time-utc="2026-11-26T13:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers, most likely in the afternoon and evening. The chance of a thunderstorm north of Hawker in the evening. Winds east to southeasterly 15 to 25 km/h tending east to northeasterly 15 to 20 km/h during the day then tending east to southeasterly 15 to 25 km/h during the evening. Overnight temperatures falling to between 15 and 21 with daytime temperatures reaching around 30.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-27T00:00:00+10:30" end-time-local="2026-11-28T00:00:00+10:30" start-time-utc="2026-11-26T13:30:00Z" end-time-utc="2026-11-27T13:30:00Z">
                <text type="forecast">Partly cloudy. High chance of showers, most likely in the morning. The chance of a thunderstorm in the morning. Winds northeast to southeasterly 15 to 20 km/h tending west to southwesterly 15 to 25 km/h during the day then tending south to southwesterly during the evening. Overnight temperatures falling to between 15 and 19 with daytime temperatures reaching around 30.</text>
            </forecast-period>
        </area>
