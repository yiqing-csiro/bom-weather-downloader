    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-27T04:10:45+09:30" end-time-local="2026-09-27T04:10:45+09:30" start-time-utc="2026-09-26T18:40:45Z" end-time-utc="2026-09-26T18:40:45Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough over central Australia will weaken and contract into WA as a ridge of high pressure extends across southern SA today. The high pressure system is expected to drift into the Tasman Sea by Tuesday as the trough in WA begins to re-extend over western SA on Tuesday, pushing into the state on Wednesday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW009" description="Flinders" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-27T00:00:00+09:30" end-time-local="2026-09-28T00:00:00+09:30" start-time-utc="2026-09-26T14:30:00Z" end-time-utc="2026-09-27T14:30:00Z">
                <text type="forecast">Mostly sunny. Winds easterly 25 to 35 km/h. Daytime maximum temperatures 24 to 32.</text>
                <text type="fire_danger">No Rating</text>
                <text type="uv_alert">Sun protection 8:50am to 3:30pm, UV Index predicted to reach 8 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-28T00:00:00+09:30" end-time-local="2026-09-29T00:00:00+09:30" start-time-utc="2026-09-27T14:30:00Z" end-time-utc="2026-09-28T14:30:00Z">
                <text type="forecast">Mostly sunny. Winds easterly 20 to 30 km/h turning north to northeasterly 15 to 25 km/h during the morning then tending east to northeasterly in the late afternoon. Overnight temperatures falling to between 8 and 16 with daytime temperatures reaching 28 to 34.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-29T00:00:00+09:30" end-time-local="2026-09-30T00:00:00+09:30" start-time-utc="2026-09-28T14:30:00Z" end-time-utc="2026-09-29T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds northeasterly 25 to 35 km/h turning northerly 25 to 40 km/h during the morning then decreasing to 20 to 30 km/h during the afternoon. Overnight temperatures falling to between 13 and 21 with daytime temperatures reaching the low to mid 30s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-30T00:00:00+09:30" end-time-local="2026-10-01T00:00:00+09:30" start-time-utc="2026-09-29T14:30:00Z" end-time-utc="2026-09-30T14:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower south of Hawker in the evening. Near zero chance of rain elsewhere. The chance of a thunderstorm in the evening. Winds northwest to northeasterly 25 to 35 km/h tending west to northwesterly during the day then tending northeast to southeasterly 15 to 20 km/h during the evening. Overnight temperatures falling to between 13 and 19 with daytime temperatures reaching 28 to 33.</text>
            </forecast-period>
        </area>
