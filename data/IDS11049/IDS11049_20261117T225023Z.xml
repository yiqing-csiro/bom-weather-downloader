    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-18T09:20:23+10:30" end-time-local="2026-11-18T09:20:23+10:30" start-time-utc="2026-11-17T22:50:23Z" end-time-utc="2026-11-17T22:50:23Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system centred south of the Bight, extends a ridge of high pressure over most of South Australia. The high and ridge will move slowly eastwards during the week to be in the Tasman Sea on Thursday. A low pressure system and associated trough over Western Australia will move over South Australia mid to late in the week. Another high pressure system follows and moves over South Australia on Saturday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW009" description="Flinders" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-18T00:00:00+10:30" end-time-local="2026-11-19T00:00:00+10:30" start-time-utc="2026-11-17T13:30:00Z" end-time-utc="2026-11-18T13:30:00Z">
                <text type="forecast">Partly cloudy. Winds easterly 15 to 25 km/h tending northeasterly 20 to 30 km/h in the morning. Daytime maximum temperatures in the low to mid 30s.</text>
                <text type="fire_danger">High</text>
                <text type="uv_alert">Sun protection 9:00am to 5:10pm, UV Index predicted to reach 11 [Extreme]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-19T00:00:00+10:30" end-time-local="2026-11-20T00:00:00+10:30" start-time-utc="2026-11-18T13:30:00Z" end-time-utc="2026-11-19T13:30:00Z">
                <text type="forecast">Partly cloudy. High chance of showers. A thunderstorm likely from the late morning. Winds east to northeasterly 15 to 25 km/h tending north to northeasterly 25 to 35 km/h in the morning. Overnight temperatures falling to between 18 and 24 with daytime temperatures reaching 31 to 36.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-20T00:00:00+10:30" end-time-local="2026-11-21T00:00:00+10:30" start-time-utc="2026-11-19T13:30:00Z" end-time-utc="2026-11-20T13:30:00Z">
                <text type="forecast">Slight chance of a shower in the morning. The chance of a thunderstorm in the morning. Sunny afternoon. Winds northwest to northeasterly 15 to 20 km/h tending westerly 25 to 35 km/h during the morning then turning south to southwesterly 20 to 30 km/h during the day. Overnight temperatures falling to between 15 and 20 with daytime temperatures reaching the low to mid 30s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-21T00:00:00+10:30" end-time-local="2026-11-22T00:00:00+10:30" start-time-utc="2026-11-20T13:30:00Z" end-time-utc="2026-11-21T13:30:00Z">
                <text type="forecast">Mostly sunny. Winds southeast to southwesterly 15 to 25 km/h tending west to northwesterly 15 to 20 km/h during the morning then tending northwest to northeasterly during the evening. Overnight temperatures falling to between 11 and 17 with daytime temperatures reaching the low to mid 30s.</text>
            </forecast-period>
        </area>
