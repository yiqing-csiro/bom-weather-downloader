    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-02T15:55:35+10:30" end-time-local="2026-11-02T15:55:35+10:30" start-time-utc="2026-11-02T05:25:35Z" end-time-utc="2026-11-02T05:25:35Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A low pressure system centred over southwestern NSW will continue to move eastwards and a high pressure system in the Bight to slowly drift eastwards. The high weakens on Tuesday allowing a cold front to move over the south of the state on Wednesday. Another ridge of high pressure follows on Thursday, with another cold front clipping the southeast on Friday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW009" description="Flinders" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-02T15:00:00+10:30" end-time-local="2026-11-03T00:00:00+10:30" start-time-utc="2026-11-02T04:30:00Z" end-time-utc="2026-11-02T13:30:00Z">
                <text type="forecast">Clear. Winds west to southwesterly 25 to 40 km/h tending south to southwesterly 25 to 35 km/h in the evening.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-03T00:00:00+10:30" end-time-local="2026-11-04T00:00:00+10:30" start-time-utc="2026-11-02T13:30:00Z" end-time-utc="2026-11-03T13:30:00Z">
                <text type="forecast">Sunny. Winds south to southwesterly 15 to 25 km/h becoming light in the late evening. Overnight temperatures falling to between 9 and 14 with daytime temperatures reaching around 30.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:10am to 5:00pm, UV Index predicted to reach 10 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-04T00:00:00+10:30" end-time-local="2026-11-05T00:00:00+10:30" start-time-utc="2026-11-03T13:30:00Z" end-time-utc="2026-11-04T13:30:00Z">
                <text type="forecast">Mostly sunny. Slight chance of a shower near the coast in the morning and afternoon. Near zero chance of rain elsewhere. Winds northeast to southeasterly 15 to 20 km/h tending northwest to southwesterly 15 to 25 km/h in the morning then tending south to southwesterly 25 to 40 km/h in the middle of the day. Overnight temperatures falling to between 11 and 16 with daytime temperatures reaching 25 to 32.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-05T00:00:00+10:30" end-time-local="2026-11-06T00:00:00+10:30" start-time-utc="2026-11-04T13:30:00Z" end-time-utc="2026-11-05T13:30:00Z">
                <text type="forecast">Sunny. Winds south to southeasterly 20 to 30 km/h tending south to southwesterly 15 to 25 km/h during the day then tending south to southeasterly during the evening. Overnight temperatures falling to between 5 and 11 with daytime temperatures reaching 23 to 28.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-11-06T00:00:00+10:30" end-time-local="2026-11-07T00:00:00+10:30" start-time-utc="2026-11-05T13:30:00Z" end-time-utc="2026-11-06T13:30:00Z">
                <text type="forecast">Sunny. Winds northeast to southeasterly 15 to 20 km/h tending west to northwesterly during the morning then tending west to southwesterly 20 to 30 km/h during the day. Overnight temperatures falling to between 8 and 13 with daytime temperatures reaching 27 to 32.</text>
            </forecast-period>
        </area>
