    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-07-26T15:55:38+09:30" end-time-local="2026-07-26T15:55:38+09:30" start-time-utc="2026-07-26T06:25:38Z" end-time-utc="2026-07-26T06:25:38Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system centred over northern SA will slowly drift east and weaken on Monday as a cold front moves up through the Bight. The front will move over southern SA during Monday night, with a new high pressure system moving into the Bight mid next week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW009" description="Flinders" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-07-26T15:00:00+09:30" end-time-local="2026-07-27T00:00:00+09:30" start-time-utc="2026-07-26T05:30:00Z" end-time-utc="2026-07-26T14:30:00Z">
                <text type="forecast">Partly cloudy. Light winds.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-07-27T00:00:00+09:30" end-time-local="2026-07-28T00:00:00+09:30" start-time-utc="2026-07-26T14:30:00Z" end-time-utc="2026-07-27T14:30:00Z">
                <text type="forecast">Partly cloudy. Patches of frost south of Hawker in the early morning. The chance of morning fog. Light winds becoming northerly 15 to 25 km/h in the morning then tending northwesterly 25 to 35 km/h in the middle of the day. Overnight temperatures falling to between 1 and 5 with daytime temperatures reaching between 15 and 19.</text>
                <text type="uv_alert">Sun protection 11:10am to 1:40pm, UV Index predicted to reach 3 [Moderate]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-07-28T00:00:00+09:30" end-time-local="2026-07-29T00:00:00+09:30" start-time-utc="2026-07-27T14:30:00Z" end-time-utc="2026-07-28T14:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers south of Hawker, most likely in the afternoon and evening. Near zero chance of rain elsewhere. Winds north to northwesterly 15 to 25 km/h shifting southwesterly 15 to 20 km/h in the afternoon. Overnight temperatures falling to between 3 and 6 with daytime temperatures reaching between 14 and 19.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-07-29T00:00:00+09:30" end-time-local="2026-07-30T00:00:00+09:30" start-time-utc="2026-07-28T14:30:00Z" end-time-utc="2026-07-29T14:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower south of Hawker, most likely in the morning. Near zero chance of rain elsewhere. Winds south to southwesterly 15 to 20 km/h tending south to southeasterly during the day. Overnight temperatures falling to between 2 and 5 with daytime temperatures reaching between 12 and 16.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-07-30T00:00:00+09:30" end-time-local="2026-07-31T00:00:00+09:30" start-time-utc="2026-07-29T14:30:00Z" end-time-utc="2026-07-30T14:30:00Z">
                <text type="forecast">Partly cloudy. Areas of morning frost south of Hawker. Light winds becoming east to southeasterly 15 to 20 km/h during the morning. Overnight temperatures falling to between 1 and 5 with daytime temperatures reaching between 11 and 16.</text>
            </forecast-period>
        </area>
