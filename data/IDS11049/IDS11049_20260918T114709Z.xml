            <forecast-period index="1" start-time-local="2026-09-19T00:00:00+09:30" end-time-local="2026-09-20T00:00:00+09:30" start-time-utc="2026-09-18T14:30:00Z" end-time-utc="2026-09-19T14:30:00Z">
                <text type="forecast">Sunny. Light winds becoming north to northwesterly 15 to 25 km/h in the morning then tending north to northeasterly 15 to 20 km/h in the evening. Overnight temperatures falling to between 6 and 10 with daytime temperatures reaching around 30.</text>
                <text type="uv_alert">Sun protection 9:00am to 3:20pm, UV Index predicted to reach 8 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-20T00:00:00+09:30" end-time-local="2026-09-21T00:00:00+09:30" start-time-utc="2026-09-19T14:30:00Z" end-time-utc="2026-09-20T14:30:00Z">
                <text type="forecast">Mostly sunny. Winds north to northwesterly 30 to 45 km/h increasing to 50 km/h before shifting south to southwesterly 20 to 30 km/h in the afternoon. Overnight temperatures falling to between 11 and 17 with daytime temperatures reaching 29 to 34.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-21T00:00:00+09:30" end-time-local="2026-09-22T00:00:00+09:30" start-time-utc="2026-09-20T14:30:00Z" end-time-utc="2026-09-21T14:30:00Z">
                <text type="forecast">Cloud clearing. Winds southerly 20 to 30 km/h turning east to southeasterly during the day. Overnight temperatures falling to between 7 and 12 with daytime temperatures reaching between 19 and 25.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-09-22T00:00:00+09:30" end-time-local="2026-09-23T00:00:00+09:30" start-time-utc="2026-09-21T14:30:00Z" end-time-utc="2026-09-22T14:30:00Z">
                <text type="forecast">Sunny. Winds east to southeasterly 20 to 30 km/h tending east to northeasterly 15 to 20 km/h during the morning. Overnight temperatures falling to between 3 and 10 with daytime temperatures reaching 21 to 27.</text>
            </forecast-period>
        </area>
