            <forecast-period index="0" start-time-local="2026-09-18T21:00:00+09:30" end-time-local="2026-09-19T00:00:00+09:30" start-time-utc="2026-09-18T11:30:00Z" end-time-utc="2026-09-18T14:30:00Z">
