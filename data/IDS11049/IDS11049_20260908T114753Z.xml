    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-08T21:17:53+09:30" end-time-local="2026-09-08T21:17:53+09:30" start-time-utc="2026-09-08T11:47:53Z" end-time-utc="2026-09-08T11:47:53Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system centred south of WA extends a ridge across the south of SA. The main high centre will move eastwards during the week to be centred to the east of SA on Friday. A trough over the interior of WA will remain stationary for most of the week and may extend into the far west of SA at times. Another low pressure trough will approach from the west on Saturday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW009" description="Flinders" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-08T21:00:00+09:30" end-time-local="2026-09-09T00:00:00+09:30" start-time-utc="2026-09-08T11:30:00Z" end-time-utc="2026-09-08T14:30:00Z">
                <text type="forecast">Cloudy. Winds southerly 15 to 25 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-09T00:00:00+09:30" end-time-local="2026-09-10T00:00:00+09:30" start-time-utc="2026-09-08T14:30:00Z" end-time-utc="2026-09-09T14:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower north of Hawker in the morning. Near zero chance of rain elsewhere. Winds southerly 15 to 25 km/h turning southeasterly 25 to 40 km/h early in the morning. Overnight temperatures falling to between 6 and 11 with daytime temperatures reaching between 14 and 19.</text>
                <text type="uv_alert">Sun protection 9:30am to 3:10pm, UV Index predicted to reach 6 [High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-10T00:00:00+09:30" end-time-local="2026-09-11T00:00:00+09:30" start-time-utc="2026-09-09T14:30:00Z" end-time-utc="2026-09-10T14:30:00Z">
                <text type="forecast">Sunny. Winds east to southeasterly 25 to 40 km/h. Overnight temperatures falling to between 2 and 7 with daytime temperatures reaching between 16 and 21.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-11T00:00:00+09:30" end-time-local="2026-09-12T00:00:00+09:30" start-time-utc="2026-09-10T14:30:00Z" end-time-utc="2026-09-11T14:30:00Z">
                <text type="forecast">Sunny. Winds east to southeasterly 20 to 30 km/h tending east to northeasterly 15 to 25 km/h during the morning then tending east to southeasterly 15 to 20 km/h during the evening. Overnight temperatures falling to between 3 and 8 with daytime temperatures reaching between 19 and 25.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-09-12T00:00:00+09:30" end-time-local="2026-09-13T00:00:00+09:30" start-time-utc="2026-09-11T14:30:00Z" end-time-utc="2026-09-12T14:30:00Z">
                <text type="forecast">Mostly sunny. Winds east to southeasterly 15 to 25 km/h turning north to northeasterly 15 to 20 km/h during the morning. Overnight temperatures falling to between 6 and 12 with daytime temperatures reaching 23 to 28.</text>
            </forecast-period>
        </area>
