        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-28T04:10:38+10:30" end-time-local="2026-11-28T04:10:38+10:30" start-time-utc="2026-11-27T17:40:38Z" end-time-utc="2026-11-27T17:40:38Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A ridge of high pressure continues to build across the state. The high will move across the Bight and into the Tasman Sea early next week as another trough begins to develop over WA.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW009" description="Flinders" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-28T00:00:00+10:30" end-time-local="2026-11-29T00:00:00+10:30" start-time-utc="2026-11-27T13:30:00Z" end-time-utc="2026-11-28T13:30:00Z">
                <text type="forecast">Mostly sunny. Medium chance of showers near the coast, most likely this afternoon. Near zero chance of rain elsewhere. Winds southwesterly 25 to 40 km/h. Daytime maximum temperatures 24 to 29.</text>
                <text type="fire_danger">High</text>
                <text type="uv_alert">Sun protection 9:00am to 5:10pm, UV Index predicted to reach 11 [Extreme]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-29T00:00:00+10:30" end-time-local="2026-11-30T00:00:00+10:30" start-time-utc="2026-11-28T13:30:00Z" end-time-utc="2026-11-29T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower near the coast in the morning and early afternoon. Near zero chance of rain elsewhere. Winds south to southwesterly 25 to 35 km/h. Overnight temperatures falling to between 8 and 12 with daytime temperatures reaching 21 to 26.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-30T00:00:00+10:30" end-time-local="2026-12-01T00:00:00+10:30" start-time-utc="2026-11-29T13:30:00Z" end-time-utc="2026-11-30T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower near the coast in the morning. Near zero chance of rain elsewhere. Winds south to southeasterly 20 to 30 km/h. Overnight temperatures falling to between 9 and 13 with daytime temperatures reaching the mid to high 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-12-01T00:00:00+10:30" end-time-local="2026-12-02T00:00:00+10:30" start-time-utc="2026-11-30T13:30:00Z" end-time-utc="2026-12-01T13:30:00Z">
                <text type="forecast">Sunny. Winds east to southeasterly 15 to 20 km/h tending east to northeasterly during the morning then tending northwest to northeasterly during the day. Overnight temperatures falling to between 9 and 15 with daytime temperatures reaching around 30.</text>
            </forecast-period>
        </area>
