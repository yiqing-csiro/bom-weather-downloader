    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-03T17:18:11+10:30" end-time-local="2026-11-03T17:18:11+10:30" start-time-utc="2026-11-03T06:48:11Z" end-time-utc="2026-11-03T06:48:11Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system east of the Bight will weaken allowing a cold front to move across the south of the state on Wednesday. Another ridge of high pressure follows on Thursday, with another cold front clipping the southeast on Friday. Another high moves over waters to the south of SA on Saturday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW009" description="Flinders" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-03T15:00:00+10:30" end-time-local="2026-11-04T00:00:00+10:30" start-time-utc="2026-11-03T04:30:00Z" end-time-utc="2026-11-03T13:30:00Z">
                <text type="forecast">Clear. Winds southwesterly 15 to 25 km/h becoming light in the late evening.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-04T00:00:00+10:30" end-time-local="2026-11-05T00:00:00+10:30" start-time-utc="2026-11-03T13:30:00Z" end-time-utc="2026-11-04T13:30:00Z">
                <text type="forecast">Mostly sunny. Slight chance of a shower near the coast in the late morning and afternoon. Near zero chance of rain elsewhere. Light winds becoming northwest to southwesterly 20 to 30 km/h in the morning then tending south to southwesterly 30 to 45 km/h in the middle of the day. Overnight temperatures falling to between 11 and 16 with daytime temperatures reaching 24 to 32.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:00am to 5:00pm, UV Index predicted to reach 10 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-05T00:00:00+10:30" end-time-local="2026-11-06T00:00:00+10:30" start-time-utc="2026-11-04T13:30:00Z" end-time-utc="2026-11-05T13:30:00Z">
                <text type="forecast">Sunny. Winds southerly 20 to 30 km/h tending southeasterly 15 to 25 km/h in the early morning then tending southeast to southwesterly 20 to 30 km/h in the middle of the day. Overnight temperatures falling to between 6 and 11 with daytime temperatures reaching 23 to 28.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-06T00:00:00+10:30" end-time-local="2026-11-07T00:00:00+10:30" start-time-utc="2026-11-05T13:30:00Z" end-time-utc="2026-11-06T13:30:00Z">
                <text type="forecast">Sunny. Winds northeast to southeasterly 15 to 20 km/h tending west to northwesterly during the morning then turning south to southwesterly 20 to 30 km/h during the day. Overnight temperatures falling to between 8 and 13 with daytime temperatures reaching around 30.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-11-07T00:00:00+10:30" end-time-local="2026-11-08T00:00:00+10:30" start-time-utc="2026-11-06T13:30:00Z" end-time-utc="2026-11-07T13:30:00Z">
                <text type="forecast">Mostly sunny. Winds south to southeasterly 20 to 30 km/h tending east to southeasterly during the day. Overnight temperatures falling to between 8 and 15 with daytime temperatures reaching 22 to 29.</text>
            </forecast-period>
        </area>
