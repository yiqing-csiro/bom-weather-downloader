    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-05T15:55:27+09:30" end-time-local="2026-09-05T15:55:27+09:30" start-time-utc="2026-09-05T06:25:27Z" end-time-utc="2026-09-05T06:25:27Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough and cold front moved across SA early on Saturday and will continue to move away to the east overnight. A ridge of high pressure will follow and move over SA overnight and on Sunday. Another cold front will move across southern coasts early Monday but the ridge will persist further north. A trough over the interior of WA will be near stationary early to mid next week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW003" description="Kangaroo Island" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-05T15:00:00+09:30" end-time-local="2026-09-06T00:00:00+09:30" start-time-utc="2026-09-05T05:30:00Z" end-time-utc="2026-09-05T14:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers, becoming less likely later this evening. Winds westerly 30 to 45 km/h turning southwesterly 15 to 25 km/h in the evening.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-06T00:00:00+09:30" end-time-local="2026-09-07T00:00:00+09:30" start-time-utc="2026-09-05T14:30:00Z" end-time-utc="2026-09-06T14:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers, most likely in the late morning and afternoon. Winds west to southwesterly 15 to 20 km/h becoming light in the late afternoon then becoming southwesterly 15 to 20 km/h in the late evening. Overnight temperatures falling to between 8 and 11 with daytime temperatures reaching around 16.</text>
                <text type="uv_alert">Sun protection 9:50am to 2:30pm, UV Index predicted to reach 5 [Moderate]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-07T00:00:00+09:30" end-time-local="2026-09-08T00:00:00+09:30" start-time-utc="2026-09-06T14:30:00Z" end-time-utc="2026-09-07T14:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower. Light winds becoming southerly 15 to 20 km/h in the morning then tending southeasterly in the middle of the day. Overnight temperatures falling to between 7 and 10 with daytime temperatures reaching around 16.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-08T00:00:00+09:30" end-time-local="2026-09-09T00:00:00+09:30" start-time-utc="2026-09-07T14:30:00Z" end-time-utc="2026-09-08T14:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower in the evening. Light winds becoming southerly 15 to 25 km/h during the day. Overnight temperatures falling to around 7 with daytime temperatures reaching around 16.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-09-09T00:00:00+09:30" end-time-local="2026-09-10T00:00:00+09:30" start-time-utc="2026-09-08T14:30:00Z" end-time-utc="2026-09-09T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds southeasterly 25 to 35 km/h. Overnight temperatures falling to around 10 with daytime temperatures reaching around 15.</text>
            </forecast-period>
        </area>
