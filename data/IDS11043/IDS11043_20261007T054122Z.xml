    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-10-07T16:11:23+10:30" end-time-local="2026-10-07T16:11:23+10:30" start-time-utc="2026-10-07T05:41:23Z" end-time-utc="2026-10-07T05:41:23Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system located near Tasmania maintains a ridge over the state as it moves east into the Tasman Sea. A trough ahead of a strong cold front is expected move over western SA on Thursday, and track east across the rest of SA on Friday. A ridge remains over northern SA on Saturday while a series of troughs and cold fronts move across the state early next week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW003" description="Kangaroo Island" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-10-07T15:00:00+10:30" end-time-local="2026-10-08T00:00:00+10:30" start-time-utc="2026-10-07T04:30:00Z" end-time-utc="2026-10-07T13:30:00Z">
                <text type="forecast">Clear. Winds north to northeasterly 15 to 20 km/h becoming light in the late afternoon then becoming easterly 15 to 20 km/h in the late evening.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-10-08T00:00:00+10:30" end-time-local="2026-10-09T00:00:00+10:30" start-time-utc="2026-10-07T13:30:00Z" end-time-utc="2026-10-08T13:30:00Z">
                <text type="forecast">Sunny. Winds north to northeasterly 25 to 35 km/h. Overnight temperatures falling to around 10 with daytime temperatures reaching the low to mid 20s.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:40am to 4:30pm, UV Index predicted to reach 8 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-10-09T00:00:00+10:30" end-time-local="2026-10-10T00:00:00+10:30" start-time-utc="2026-10-08T13:30:00Z" end-time-utc="2026-10-09T13:30:00Z">
                <text type="forecast">Cloudy. Very high chance of showers, most likely in the morning and afternoon. The chance of a thunderstorm in the late morning and afternoon. Winds northerly 25 to 35 km/h turning west to northwesterly 20 to 30 km/h in the afternoon. Overnight temperatures falling to around 15 with daytime temperatures reaching around 20.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-10-10T00:00:00+10:30" end-time-local="2026-10-11T00:00:00+10:30" start-time-utc="2026-10-09T13:30:00Z" end-time-utc="2026-10-10T13:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers, most likely in the morning and afternoon. Winds westerly 25 to 35 km/h turning northwesterly 15 to 25 km/h during the afternoon. Overnight temperatures falling to around 10 with daytime temperatures reaching around 18.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-10-11T00:00:00+10:30" end-time-local="2026-10-12T00:00:00+10:30" start-time-utc="2026-10-10T13:30:00Z" end-time-utc="2026-10-11T13:30:00Z">
                <text type="forecast">Mostly sunny day. Medium chance of showers in the evening. The chance of a thunderstorm in the evening. Winds northerly 20 to 30 km/h. Overnight temperatures falling to around 11 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
        </area>
