    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-07T09:18:12+10:30" end-time-local="2026-11-07T09:18:12+10:30" start-time-utc="2026-11-06T22:48:12Z" end-time-utc="2026-11-06T22:48:12Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system centred well south of WA extends a ridge over northern and western SA. The high drifts over waters well to the south of SA over the weekend, while a developing low pressure system and trough in WA move close to the SA border. The high drifts southeast of Tasmania by Monday as the low moves across western SA on Monday and northern SA on Tuesday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW003" description="Kangaroo Island" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-07T00:00:00+10:30" end-time-local="2026-11-08T00:00:00+10:30" start-time-utc="2026-11-06T13:30:00Z" end-time-utc="2026-11-07T13:30:00Z">
                <text type="forecast">Cloudy. Winds southeasterly 20 to 30 km/h. Daytime maximum temperatures around 17.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:10am to 4:50pm, UV Index predicted to reach 9 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-08T00:00:00+10:30" end-time-local="2026-11-09T00:00:00+10:30" start-time-utc="2026-11-07T13:30:00Z" end-time-utc="2026-11-08T13:30:00Z">
                <text type="forecast">Cloud clearing. Winds southeasterly 15 to 25 km/h turning easterly 20 to 30 km/h before dawn. Overnight temperatures falling to between 7 and 10 with daytime temperatures reaching around 20.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-09T00:00:00+10:30" end-time-local="2026-11-10T00:00:00+10:30" start-time-utc="2026-11-08T13:30:00Z" end-time-utc="2026-11-09T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower, most likely in the morning and afternoon. Winds easterly 15 to 25 km/h turning northeasterly 20 to 30 km/h during the morning. Overnight temperatures falling to around 11 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-10T00:00:00+10:30" end-time-local="2026-11-11T00:00:00+10:30" start-time-utc="2026-11-09T13:30:00Z" end-time-utc="2026-11-10T13:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower. Winds east to northeasterly 15 to 20 km/h shifting southerly 25 to 35 km/h during the morning. Overnight temperatures falling to around 12 with daytime temperatures reaching the low 20s.</text>
            </forecast-period>
        </area>
