    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-15T04:22:52+10:30" end-time-local="2026-11-15T04:22:52+10:30" start-time-utc="2026-11-14T17:52:52Z" end-time-utc="2026-11-14T17:52:52Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system centred southwest of WA extends a ridge over most of SA. A cold front is expected to clip the southeast of the state today. The high will move slowly eastwards during the week. A trough over inland WA will move over SA mid to late next week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW003" description="Kangaroo Island" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-15T00:00:00+10:30" end-time-local="2026-11-16T00:00:00+10:30" start-time-utc="2026-11-14T13:30:00Z" end-time-utc="2026-11-15T13:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers, becoming less likely this afternoon. Winds southwesterly 15 to 25 km/h tending southerly 25 to 35 km/h in the morning then tending southeasterly 15 to 25 km/h in the late evening. Daytime maximum temperatures around 17.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:10am to 4:50pm, UV Index predicted to reach 9 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-16T00:00:00+10:30" end-time-local="2026-11-17T00:00:00+10:30" start-time-utc="2026-11-15T13:30:00Z" end-time-utc="2026-11-16T13:30:00Z">
                <text type="forecast">Cloudy. Winds southeasterly 15 to 25 km/h. Overnight temperatures falling to around 9 with daytime temperatures reaching around 18.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-17T00:00:00+10:30" end-time-local="2026-11-18T00:00:00+10:30" start-time-utc="2026-11-16T13:30:00Z" end-time-utc="2026-11-17T13:30:00Z">
                <text type="forecast">Partly cloudy. Light winds becoming southeasterly 20 to 30 km/h during the morning. Overnight temperatures falling to between 7 and 10 with daytime temperatures reaching around 19.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-18T00:00:00+10:30" end-time-local="2026-11-19T00:00:00+10:30" start-time-utc="2026-11-17T13:30:00Z" end-time-utc="2026-11-18T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower, most likely in the evening. Winds southeasterly 15 to 20 km/h turning easterly 15 to 25 km/h during the morning. Overnight temperatures falling to around 10 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
        </area>
