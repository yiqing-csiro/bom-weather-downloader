    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-10-11T04:10:16+10:30" end-time-local="2026-10-11T04:10:16+10:30" start-time-utc="2026-10-10T17:40:16Z" end-time-utc="2026-10-10T17:40:16Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A ridge of high pressure to the east directs a northerly flow over South Australia. A trough and cold front about the far west will cross the state today and Monday morning. A cool southwesterly airstream will follow as a new high drifts eastwards across the Bight early this week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW003" description="Kangaroo Island" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-10-11T00:00:00+10:30" end-time-local="2026-10-12T00:00:00+10:30" start-time-utc="2026-10-10T13:30:00Z" end-time-utc="2026-10-11T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower. The chance of a thunderstorm late this afternoon and evening. Winds northerly 20 to 30 km/h shifting southwesterly 15 to 20 km/h in the evening. Daytime maximum temperatures in the low to mid 20s.</text>
                <text type="fire_danger">No Rating</text>
                <text type="uv_alert">Sun protection 9:40am to 4:20pm, UV Index predicted to reach 7 [High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-10-12T00:00:00+10:30" end-time-local="2026-10-13T00:00:00+10:30" start-time-utc="2026-10-11T13:30:00Z" end-time-utc="2026-10-12T13:30:00Z">
                <text type="forecast">Partly cloudy. Winds southwesterly 20 to 30 km/h. Overnight temperatures falling to around 10 with daytime temperatures reaching around 17.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-10-13T00:00:00+10:30" end-time-local="2026-10-14T00:00:00+10:30" start-time-utc="2026-10-12T13:30:00Z" end-time-utc="2026-10-13T13:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower, most likely in the morning. Winds southwesterly 15 to 25 km/h turning south to southeasterly 15 to 20 km/h during the day. Overnight temperatures falling to between 8 and 11 with daytime temperatures reaching around 16.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-10-14T00:00:00+10:30" end-time-local="2026-10-15T00:00:00+10:30" start-time-utc="2026-10-13T13:30:00Z" end-time-utc="2026-10-14T13:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower in the morning and afternoon. Winds southeasterly 15 to 25 km/h. Overnight temperatures falling to between 7 and 10 with daytime temperatures reaching around 15.</text>
            </forecast-period>
        </area>
