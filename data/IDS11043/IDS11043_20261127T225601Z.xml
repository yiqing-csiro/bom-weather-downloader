                <text type="uv_alert">Sun protection 9:00am to 5:10pm, UV Index predicted to reach 10 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-29T00:00:00+10:30" end-time-local="2026-11-30T00:00:00+10:30" start-time-utc="2026-11-28T13:30:00Z" end-time-utc="2026-11-29T13:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers, most likely in the afternoon and evening. Winds southwesterly 25 to 35 km/h turning southerly 15 to 25 km/h in the late evening. Overnight temperatures falling to between 9 and 12 with daytime temperatures reaching around 20.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-30T00:00:00+10:30" end-time-local="2026-12-01T00:00:00+10:30" start-time-utc="2026-11-29T13:30:00Z" end-time-utc="2026-11-30T13:30:00Z">
                <text type="forecast">Partly cloudy. Winds southerly 15 to 25 km/h turning southeasterly 15 to 20 km/h during the evening. Overnight temperatures falling to around 11 with daytime temperatures reaching around 20.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-12-01T00:00:00+10:30" end-time-local="2026-12-02T00:00:00+10:30" start-time-utc="2026-11-30T13:30:00Z" end-time-utc="2026-12-01T13:30:00Z">
                <text type="forecast">Mostly sunny. Light winds becoming north to northeasterly 15 to 25 km/h during the morning then tending north to northwesterly during the day. Overnight temperatures falling to around 8 with daytime temperatures reaching the mid to high 20s.</text>
            </forecast-period>
        </area>
