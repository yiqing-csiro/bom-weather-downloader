                <text type="uv_alert">Sun protection 9:00am to 5:10pm, UV Index predicted to reach 10 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-24T00:00:00+10:30" end-time-local="2026-11-25T00:00:00+10:30" start-time-utc="2026-11-23T13:30:00Z" end-time-utc="2026-11-24T13:30:00Z">
                <text type="forecast">Partly cloudy. Winds southwesterly 15 to 20 km/h becoming light before dawn then becoming northeast to southeasterly 15 to 20 km/h in the middle of the day. Overnight temperatures falling to between 7 and 11 with daytime temperatures reaching around 20.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-25T00:00:00+10:30" end-time-local="2026-11-26T00:00:00+10:30" start-time-utc="2026-11-24T13:30:00Z" end-time-utc="2026-11-25T13:30:00Z">
                <text type="forecast">Sunny. Winds east to northeasterly 15 to 20 km/h tending northwest to northeasterly during the morning then tending south to southeasterly 15 to 25 km/h during the afternoon. Overnight temperatures falling to around 10 with daytime temperatures reaching the mid to high 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-26T00:00:00+10:30" end-time-local="2026-11-27T00:00:00+10:30" start-time-utc="2026-11-25T13:30:00Z" end-time-utc="2026-11-26T13:30:00Z">
