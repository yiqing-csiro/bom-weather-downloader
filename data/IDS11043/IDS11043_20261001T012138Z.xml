    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-10-01T10:51:38+09:30" end-time-local="2026-10-01T10:51:38+09:30" start-time-utc="2026-10-01T01:21:38Z" end-time-utc="2026-10-01T01:21:38Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A series of troughs over SA will slowly move east ahead of a high pressure system that moves into the Bight on Friday. A cold front moving across the Southern Ocean will clip the far southeast late today, with a low pressure system developing near the Victorian border on Friday. Another trough near the WA border is expected to develop on Saturday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW003" description="Kangaroo Island" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-10-01T00:00:00+09:30" end-time-local="2026-10-02T00:00:00+09:30" start-time-utc="2026-09-30T14:30:00Z" end-time-utc="2026-10-01T14:30:00Z">
                <text type="forecast">Cloudy. Very high chance of showers. The chance of a thunderstorm at night. Light winds becoming southerly 15 to 20 km/h in the early afternoon then becoming light in the evening. Daytime maximum temperatures around 19.</text>
                <text type="fire_danger">No Rating</text>
                <text type="uv_alert">Sun protection 9:00am to 3:10pm, UV Index predicted to reach 7 [High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-10-02T00:00:00+09:30" end-time-local="2026-10-03T00:00:00+09:30" start-time-utc="2026-10-01T14:30:00Z" end-time-utc="2026-10-02T14:30:00Z">
                <text type="forecast">Partly cloudy. Very high chance of showers, most likely in the morning and afternoon. The chance of a thunderstorm in the early morning. Winds south to southeasterly 15 to 25 km/h. Overnight temperatures falling to around 10 with daytime temperatures reaching around 16.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-10-03T00:00:00+09:30" end-time-local="2026-10-04T00:00:00+09:30" start-time-utc="2026-10-02T14:30:00Z" end-time-utc="2026-10-03T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds south to southeasterly 20 to 30 km/h. Overnight temperatures falling to between 8 and 11 with daytime temperatures reaching around 16.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-10-04T00:00:00+09:30" end-time-local="2026-10-05T00:00:00+10:30" start-time-utc="2026-10-03T14:30:00Z" end-time-utc="2026-10-04T13:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower in the morning and afternoon. Winds southeasterly 15 to 20 km/h becoming light during the evening. Overnight temperatures falling to around 10 with daytime temperatures reaching around 16.</text>
            </forecast-period>
        </area>
