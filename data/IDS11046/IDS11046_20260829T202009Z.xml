        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-08-30T05:50:09+09:30" end-time-local="2026-08-30T05:50:09+09:30" start-time-utc="2026-08-29T20:20:09Z" end-time-utc="2026-08-29T20:20:09Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system south of SA continues extending a ridge across the state, as it moves slowly east over the weekend, to be centred over Victoria by Monday. A cold front is then forecast to move across the state on Tuesday, as another ridge and high quickly push in behind the front on Wednesday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW006" description="Riverland" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-08-30T00:00:00+09:30" end-time-local="2026-08-31T00:00:00+09:30" start-time-utc="2026-08-29T14:30:00Z" end-time-utc="2026-08-30T14:30:00Z">
                <text type="forecast">Patchy morning fog. Sunny afternoon. Light winds. Daytime maximum temperatures around 19.</text>
                <text type="uv_alert">Sun protection 9:40am to 2:40pm, UV Index predicted to reach 5 [Moderate]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-08-31T00:00:00+09:30" end-time-local="2026-09-01T00:00:00+09:30" start-time-utc="2026-08-30T14:30:00Z" end-time-utc="2026-08-31T14:30:00Z">
                <text type="forecast">The chance of morning fog. Sunny afternoon. Light winds. Overnight temperatures falling to around 5 with daytime temperatures reaching the low 20s.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-01T00:00:00+09:30" end-time-local="2026-09-02T00:00:00+09:30" start-time-utc="2026-08-31T14:30:00Z" end-time-utc="2026-09-01T14:30:00Z">
                <text type="forecast">Sunny morning. Slight chance of a shower in the afternoon and evening. Winds northerly 25 to 35 km/h tending northwesterly during the day then becoming light during the evening. Overnight temperatures falling to around 9 with daytime temperatures reaching the mid to high 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-02T00:00:00+09:30" end-time-local="2026-09-03T00:00:00+09:30" start-time-utc="2026-09-01T14:30:00Z" end-time-utc="2026-09-02T14:30:00Z">
                <text type="forecast">Cloudy. Winds west to southwesterly 15 to 20 km/h becoming westerly 15 to 25 km/h during the day then becoming west to southwesterly and light during the evening. Overnight temperatures falling to around 11 with daytime temperatures reaching around 20.</text>
            </forecast-period>
