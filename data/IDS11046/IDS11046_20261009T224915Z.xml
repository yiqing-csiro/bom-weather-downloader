            <forecast-period index="0" start-time-local="2026-10-10T00:00:00+10:30" end-time-local="2026-10-11T00:00:00+10:30" start-time-utc="2026-10-09T13:30:00Z" end-time-utc="2026-10-10T13:30:00Z">
                <text type="forecast">Partly cloudy. Winds westerly 15 to 25 km/h becoming light in the evening. Daytime maximum temperatures in the low to mid 20s.</text>
                <text type="fire_danger">No Rating</text>
                <text type="uv_alert">Sun protection 9:20am to 4:20pm, UV Index predicted to reach 8 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-10-11T00:00:00+10:30" end-time-local="2026-10-12T00:00:00+10:30" start-time-utc="2026-10-10T13:30:00Z" end-time-utc="2026-10-11T13:30:00Z">
                <text type="forecast">Sunny morning. High chance of showers in the late afternoon and evening. The chance of a thunderstorm in the late afternoon and evening. Light winds becoming north to northeasterly 15 to 25 km/h in the morning then turning northwesterly 20 to 30 km/h in the early afternoon. Overnight temperatures falling to around 7 with daytime temperatures reaching the low 30s.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-10-12T00:00:00+10:30" end-time-local="2026-10-13T00:00:00+10:30" start-time-utc="2026-10-11T13:30:00Z" end-time-utc="2026-10-12T13:30:00Z">
                <text type="forecast">Partly cloudy. High chance of showers, most likely in the morning. The chance of a thunderstorm in the morning. Light winds becoming south to southwesterly 15 to 25 km/h during the morning. Overnight temperatures falling to around 12 with daytime temperatures reaching the low 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-10-13T00:00:00+10:30" end-time-local="2026-10-14T00:00:00+10:30" start-time-utc="2026-10-12T13:30:00Z" end-time-utc="2026-10-13T13:30:00Z">
