    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-04T15:55:26+09:30" end-time-local="2026-09-04T15:55:26+09:30" start-time-utc="2026-09-04T06:25:26Z" end-time-utc="2026-09-04T06:25:26Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough lies near the western border ahead of a cold front moving across the Bight, while a weak ridge of high pressure lies across central Australia. The front and trough will move across SA overnight and into southeastern Australia on Saturday, with a ridge of high pressure developing across SA in its wake. A trough is expected to develop near the western border on Sunday and remain near stationary nearly next week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW006" description="Riverland" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-04T15:00:00+09:30" end-time-local="2026-09-05T00:00:00+09:30" start-time-utc="2026-09-04T05:30:00Z" end-time-utc="2026-09-04T14:30:00Z">
                <text type="forecast">Cloudy. High chance of showers. The chance of a thunderstorm. Winds north to northeasterly 20 to 30 km/h tending north to northwesterly 15 to 20 km/h in the evening.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-05T00:00:00+09:30" end-time-local="2026-09-06T00:00:00+09:30" start-time-utc="2026-09-04T14:30:00Z" end-time-utc="2026-09-05T14:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers in the early morning. The chance of a thunderstorm in the early morning. Winds northwesterly 15 to 25 km/h turning westerly 35 to 50 km/h early in the morning then decreasing to 15 to 25 km/h in the evening. Overnight temperatures falling to around 13 with daytime temperatures reaching around 19.</text>
                <text type="uv_alert">Sun protection 9:30am to 2:40pm, UV Index predicted to reach 5 [Moderate]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-06T00:00:00+09:30" end-time-local="2026-09-07T00:00:00+09:30" start-time-utc="2026-09-05T14:30:00Z" end-time-utc="2026-09-06T14:30:00Z">
                <text type="forecast">Cloudy. Light winds. Overnight temperatures falling to around 7 with daytime temperatures reaching around 19.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-07T00:00:00+09:30" end-time-local="2026-09-08T00:00:00+09:30" start-time-utc="2026-09-06T14:30:00Z" end-time-utc="2026-09-07T14:30:00Z">
                <text type="forecast">Cloudy. The chance of morning fog in the west. Light winds becoming southerly 15 to 20 km/h during the morning then becoming light during the afternoon. Overnight temperatures falling to around 8 with daytime temperatures reaching around 20.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-09-08T00:00:00+09:30" end-time-local="2026-09-09T00:00:00+09:30" start-time-utc="2026-09-07T14:30:00Z" end-time-utc="2026-09-08T14:30:00Z">
