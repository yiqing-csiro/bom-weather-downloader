            </forecast-period>
            <forecast-period index="2" start-time-local="2026-08-11T00:00:00+09:30" end-time-local="2026-08-12T00:00:00+09:30" start-time-utc="2026-08-10T14:30:00Z" end-time-utc="2026-08-11T14:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers, most likely in the evening. Light winds becoming northwesterly 15 to 25 km/h in the morning. Overnight temperatures falling to around 5 with daytime temperatures reaching around 17.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-08-12T00:00:00+09:30" end-time-local="2026-08-13T00:00:00+09:30" start-time-utc="2026-08-11T14:30:00Z" end-time-utc="2026-08-12T14:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers, most likely in the morning. Winds northwesterly 15 to 20 km/h turning southwesterly 20 to 30 km/h during the morning then becoming west to southwesterly and light during the evening. Overnight temperatures falling to around 6 with daytime temperatures reaching around 16.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-08-13T00:00:00+09:30" end-time-local="2026-08-14T00:00:00+09:30" start-time-utc="2026-08-12T14:30:00Z" end-time-utc="2026-08-13T14:30:00Z">
