    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-04T10:55:33+10:30" end-time-local="2026-11-04T10:55:33+10:30" start-time-utc="2026-11-04T00:25:33Z" end-time-utc="2026-11-04T00:25:33Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A cold front will move across the south of the state today, clearing the east of the state in the afternoon. Another ridge of high pressure will follow on Thursday, with another cold front clipping the southeast on Friday. Another high moves over waters to the south of SA on Saturday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW006" description="Riverland" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-04T00:00:00+10:30" end-time-local="2026-11-05T00:00:00+10:30" start-time-utc="2026-11-03T13:30:00Z" end-time-utc="2026-11-04T13:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers in the late morning and afternoon. The chance of a thunderstorm near the eastern border in the late morning and afternoon. Winds westerly 25 to 40 km/h tending southwesterly 30 to 45 km/h in the early afternoon then decreasing to 15 to 25 km/h in the late evening. Daytime maximum temperatures in the mid to high 20s.</text>
                <text type="fire_danger">High</text>
                <text type="uv_alert">Sun protection 9:00am to 4:30pm, UV Index predicted to reach 10 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-05T00:00:00+10:30" end-time-local="2026-11-06T00:00:00+10:30" start-time-utc="2026-11-04T13:30:00Z" end-time-utc="2026-11-05T13:30:00Z">
                <text type="forecast">Cloud clearing. Winds southwesterly 15 to 20 km/h turning southerly in the late morning and afternoon. Overnight temperatures falling to around 8 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-06T00:00:00+10:30" end-time-local="2026-11-07T00:00:00+10:30" start-time-utc="2026-11-05T13:30:00Z" end-time-utc="2026-11-06T13:30:00Z">
                <text type="forecast">Sunny. Light winds becoming westerly 15 to 20 km/h during the day then tending southwesterly 15 to 25 km/h during the afternoon. Overnight temperatures falling to around 8 with daytime temperatures reaching around 30.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-07T00:00:00+10:30" end-time-local="2026-11-08T00:00:00+10:30" start-time-utc="2026-11-06T13:30:00Z" end-time-utc="2026-11-07T13:30:00Z">
                <text type="forecast">Slight chance of a shower in the morning. Sunny afternoon. Winds southwesterly 15 to 20 km/h tending southerly 20 to 30 km/h during the morning then tending southeasterly 15 to 20 km/h during the evening. Overnight temperatures falling to around 9 with daytime temperatures reaching the low 20s.</text>
            </forecast-period>
        </area>
