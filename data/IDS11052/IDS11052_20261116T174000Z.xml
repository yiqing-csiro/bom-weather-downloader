    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-17T04:10:51+10:30" end-time-local="2026-11-17T04:10:51+10:30" start-time-utc="2026-11-16T17:40:51Z" end-time-utc="2026-11-16T17:40:51Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system centred south of Western Australia, extends a ridge of high pressure over most of South Australia. The high and ridge will move slowly eastwards during the week to be in the Tasman Sea on Thursday. A low pressure system and associated trough over Western Australia will move over South Australia mid to late in the week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW012" description="Lower Eyre Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-17T00:00:00+10:30" end-time-local="2026-11-18T00:00:00+10:30" start-time-utc="2026-11-16T13:30:00Z" end-time-utc="2026-11-17T13:30:00Z">
                <text type="forecast">Becoming cloudy. Winds southeasterly 20 to 30 km/h. Daytime maximum temperatures in the low to mid 20s.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:10am to 5:10pm, UV Index predicted to reach 10 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-18T00:00:00+10:30" end-time-local="2026-11-19T00:00:00+10:30" start-time-utc="2026-11-17T13:30:00Z" end-time-utc="2026-11-18T13:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers. Winds easterly 20 to 30 km/h. Overnight temperatures falling to around 14 with daytime temperatures reaching the mid to high 20s.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-19T00:00:00+10:30" end-time-local="2026-11-20T00:00:00+10:30" start-time-utc="2026-11-18T13:30:00Z" end-time-utc="2026-11-19T13:30:00Z">
                <text type="forecast">Partly cloudy. Very high chance of showers, most likely in the morning and afternoon. A thunderstorm likely in the morning and afternoon. Winds east to northeasterly 15 to 25 km/h increasing to 40 km/h before shifting northwesterly 25 to 35 km/h during the day, then decreasing to 15 to 25 km/h during the afternoon. Overnight temperatures falling to around 17 with daytime temperatures reaching the low 30s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-20T00:00:00+10:30" end-time-local="2026-11-21T00:00:00+10:30" start-time-utc="2026-11-19T13:30:00Z" end-time-utc="2026-11-20T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower in the morning. Winds northwesterly 20 to 30 km/h tending westerly 25 to 35 km/h during the morning then becoming light during the evening. Overnight temperatures falling to around 15 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
        </area>
