    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-26T15:55:51+09:30" end-time-local="2026-09-26T15:55:51+09:30" start-time-utc="2026-09-26T06:25:51Z" end-time-utc="2026-09-26T06:25:51Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough over central Australia will weaken and contract into WA as a ridge of high pressure extends across southern SA on Sunday. The high pressure system is expected to drift into the Tasman Sea by Tuesday as the trough in WA begins to re-extend over western SA on Tuesday, pushing into the state on Wednesday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW012" description="Lower Eyre Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-26T15:00:00+09:30" end-time-local="2026-09-27T00:00:00+09:30" start-time-utc="2026-09-26T05:30:00Z" end-time-utc="2026-09-26T14:30:00Z">
                <text type="forecast">Cloudy. High chance of showers, becoming less likely later tonight. Winds southeasterly 25 to 35 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-27T00:00:00+09:30" end-time-local="2026-09-28T00:00:00+09:30" start-time-utc="2026-09-26T14:30:00Z" end-time-utc="2026-09-27T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds southeasterly 25 to 35 km/h turning easterly 25 to 40 km/h during the morning. Overnight temperatures falling to around 11 with daytime temperatures reaching between 18 and 21.</text>
                <text type="fire_danger">No Rating</text>
                <text type="uv_alert">Sun protection 9:10am to 3:20pm, UV Index predicted to reach 7 [High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-28T00:00:00+09:30" end-time-local="2026-09-29T00:00:00+09:30" start-time-utc="2026-09-27T14:30:00Z" end-time-utc="2026-09-28T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds east to northeasterly 20 to 30 km/h becoming light in the evening then becoming northeasterly 15 to 20 km/h in the late evening. Overnight temperatures falling to around 12 with daytime temperatures reaching 28 to 34.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-29T00:00:00+09:30" end-time-local="2026-09-30T00:00:00+09:30" start-time-utc="2026-09-28T14:30:00Z" end-time-utc="2026-09-29T14:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers in the evening. Winds north to northeasterly 25 to 35 km/h increasing to 45 km/h before shifting westerly 25 to 40 km/h during the afternoon. Overnight temperatures falling to around 17 with daytime temperatures reaching around 30.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-09-30T00:00:00+09:30" end-time-local="2026-10-01T00:00:00+09:30" start-time-utc="2026-09-29T14:30:00Z" end-time-utc="2026-09-30T14:30:00Z">
                <text type="forecast">Partly cloudy. High chance of showers, most likely in the morning. The chance of a thunderstorm in the morning. Light winds becoming northwest to southwesterly 15 to 20 km/h during the day then becoming light during the afternoon. Overnight temperatures falling to around 12 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
        </area>
