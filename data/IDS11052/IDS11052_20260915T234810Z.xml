    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-16T09:18:10+09:30" end-time-local="2026-09-16T09:18:10+09:30" start-time-utc="2026-09-15T23:48:10Z" end-time-utc="2026-09-15T23:48:10Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A strong high pressure system south of the state will maintain a ridge across SA for the next few days as it drifts eastwards. A cold front is likely to approach from the west late Saturday and move across SA on Sunday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW012" description="Lower Eyre Peninsula" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-16T00:00:00+09:30" end-time-local="2026-09-17T00:00:00+09:30" start-time-utc="2026-09-15T14:30:00Z" end-time-utc="2026-09-16T14:30:00Z">
                <text type="forecast">Cloudy. Winds east to southeasterly 20 to 30 km/h. Daytime maximum temperatures around 16.</text>
                <text type="uv_alert">Sun protection 9:30am to 3:10pm, UV Index predicted to reach 6 [High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-17T00:00:00+09:30" end-time-local="2026-09-18T00:00:00+09:30" start-time-utc="2026-09-16T14:30:00Z" end-time-utc="2026-09-17T14:30:00Z">
                <text type="forecast">Sunny. Winds easterly 15 to 25 km/h becoming light in the early morning then becoming east to northeasterly 15 to 20 km/h in the morning. Overnight temperatures falling to between 5 and 9 with daytime temperatures reaching between 17 and 21.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-18T00:00:00+09:30" end-time-local="2026-09-19T00:00:00+09:30" start-time-utc="2026-09-17T14:30:00Z" end-time-utc="2026-09-18T14:30:00Z">
                <text type="forecast">Sunny. Winds northerly 15 to 25 km/h tending northwesterly 20 to 30 km/h during the day then becoming light during the afternoon. Overnight temperatures falling to between 6 and 9 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-19T00:00:00+09:30" end-time-local="2026-09-20T00:00:00+09:30" start-time-utc="2026-09-18T14:30:00Z" end-time-utc="2026-09-19T14:30:00Z">
                <text type="forecast">Sunny. Winds north to northeasterly 15 to 20 km/h tending north to northwesterly 20 to 30 km/h during the morning then becoming northerly 15 to 25 km/h during the afternoon. Overnight temperatures falling to around 10 with daytime temperatures reaching the mid to high 20s.</text>
            </forecast-period>
        </area>
