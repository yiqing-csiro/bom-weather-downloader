        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-12T21:18:42+10:30" end-time-local="2026-11-12T21:18:42+10:30" start-time-utc="2026-11-12T10:48:42Z" end-time-utc="2026-11-12T10:48:42Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A ridge of high pressure lies over water south of the Bight and will weaken this evening. A low pressure system over Western Australian will move over South Australia on Friday, with an associated trough. A ridge of high pressure will follow and persist into early next week. A cold front clips the southeast on Sunday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW014" description="North East Pastoral" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-12T21:00:00+10:30" end-time-local="2026-11-13T00:00:00+10:30" start-time-utc="2026-11-12T10:30:00Z" end-time-utc="2026-11-12T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower. The chance of a thunderstorm north of Leigh Creek. Winds southeast to southwesterly 15 to 25 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-13T00:00:00+10:30" end-time-local="2026-11-14T00:00:00+10:30" start-time-utc="2026-11-12T13:30:00Z" end-time-utc="2026-11-13T13:30:00Z">
                <text type="forecast">Partly cloudy. High chance of showers south of Leigh Creek, medium chance elsewhere. The chance of a thunderstorm. Winds southeast to southwesterly 15 to 25 km/h tending northwest to northeasterly in the early morning then tending northwest to southwesterly 20 to 30 km/h in the middle of the day. Overnight temperatures falling to between 18 and 25 with daytime temperatures reaching 31 to 39.</text>
                <text type="fire_danger">High</text>
                <text type="uv_alert">Sun protection 9:00am to 5:00pm, UV Index predicted to reach 11 [Extreme]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-14T00:00:00+10:30" end-time-local="2026-11-15T00:00:00+10:30" start-time-utc="2026-11-13T13:30:00Z" end-time-utc="2026-11-14T13:30:00Z">
                <text type="forecast">Mostly sunny. Slight chance of a shower. The chance of a thunderstorm in the morning and afternoon. Winds south to southwesterly 25 to 35 km/h. Overnight temperatures falling to between 16 and 25 with daytime temperatures reaching 29 to 39.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-15T00:00:00+10:30" end-time-local="2026-11-16T00:00:00+10:30" start-time-utc="2026-11-14T13:30:00Z" end-time-utc="2026-11-15T13:30:00Z">
                <text type="forecast">Mostly sunny. The chance of a thunderstorm north of Oodnadatta. Winds southerly 25 to 35 km/h. Overnight temperatures falling to between 11 and 23 with daytime temperatures reaching 26 to 34.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-11-16T00:00:00+10:30" end-time-local="2026-11-17T00:00:00+10:30" start-time-utc="2026-11-15T13:30:00Z" end-time-utc="2026-11-16T13:30:00Z">
