    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-06T04:10:56+10:30" end-time-local="2026-11-06T04:10:56+10:30" start-time-utc="2026-11-05T17:40:56Z" end-time-utc="2026-11-05T17:40:56Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system over southern SA moves over the eastern states, as a cold front clips the southeast on today. Another high pressure system moves over waters to the south of SA over the weekend, while a developing low pressure system and trough in WA move close to the SA border. The high drifts southeast of Australia as the low moves across SA on Monday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW014" description="North East Pastoral" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-06T00:00:00+10:30" end-time-local="2026-11-07T00:00:00+10:30" start-time-utc="2026-11-05T13:30:00Z" end-time-utc="2026-11-06T13:30:00Z">
                <text type="forecast">Sunny. Winds east to southeasterly 15 to 25 km/h tending southeast to southwesterly in the early afternoon. Daytime maximum temperatures 31 to 36.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:00am to 5:00pm, UV Index predicted to reach 11 [Extreme]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-07T00:00:00+10:30" end-time-local="2026-11-08T00:00:00+10:30" start-time-utc="2026-11-06T13:30:00Z" end-time-utc="2026-11-07T13:30:00Z">
                <text type="forecast">Sunny. Winds south to southeasterly 25 to 40 km/h. Overnight temperatures falling to between 11 and 21 with daytime temperatures reaching 24 to 37.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-08T00:00:00+10:30" end-time-local="2026-11-09T00:00:00+10:30" start-time-utc="2026-11-07T13:30:00Z" end-time-utc="2026-11-08T13:30:00Z">
                <text type="forecast">Mostly sunny. The chance of a thunderstorm west of Leigh Creek in the afternoon and evening. Winds east to southeasterly 35 to 50 km/h. Overnight temperatures falling to between 7 and 22 with daytime temperatures reaching 24 to 37.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-09T00:00:00+10:30" end-time-local="2026-11-10T00:00:00+10:30" start-time-utc="2026-11-08T13:30:00Z" end-time-utc="2026-11-09T13:30:00Z">
                <text type="forecast">Mostly sunny. Slight chance of a shower. The chance of a thunderstorm in the afternoon and evening. Winds east to northeasterly 30 to 45 km/h tending north to northeasterly 25 to 40 km/h during the day then tending east to northeasterly 20 to 30 km/h during the afternoon. Overnight temperatures falling to between 10 and 24 with daytime temperatures reaching 29 to 41.</text>
            </forecast-period>
        </area>
