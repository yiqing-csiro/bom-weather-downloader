            <forecast-period index="0" start-time-local="2026-09-15T15:00:00+09:30" end-time-local="2026-09-16T00:00:00+09:30" start-time-utc="2026-09-15T05:30:00Z" end-time-utc="2026-09-15T14:30:00Z">
                <text type="forecast">Clear. Winds south to southeasterly 25 to 40 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-16T00:00:00+09:30" end-time-local="2026-09-17T00:00:00+09:30" start-time-utc="2026-09-15T14:30:00Z" end-time-utc="2026-09-16T14:30:00Z">
                <text type="forecast">Sunny. Winds southeasterly 35 to 50 km/h. Overnight temperatures falling to between 4 and 14 with daytime temperatures reaching between 18 and 25.</text>
                <text type="uv_alert">Sun protection 9:00am to 3:20pm, UV Index predicted to reach 8 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-17T00:00:00+09:30" end-time-local="2026-09-18T00:00:00+09:30" start-time-utc="2026-09-16T14:30:00Z" end-time-utc="2026-09-17T14:30:00Z">
                <text type="forecast">Sunny. Patches of frost and the chance of fog south of Yunta in the morning. Winds southeasterly 25 to 40 km/h. Overnight temperatures falling to between 3 and 10 with daytime temperatures reaching 20 to 26.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-18T00:00:00+09:30" end-time-local="2026-09-19T00:00:00+09:30" start-time-utc="2026-09-17T14:30:00Z" end-time-utc="2026-09-18T14:30:00Z">
                <text type="forecast">Sunny. The chance of morning frost south of Yunta. Winds east to southeasterly 20 to 30 km/h tending east to northeasterly during the morning then tending east to southeasterly 15 to 20 km/h during the afternoon. Overnight temperatures falling to between 4 and 12 with daytime temperatures reaching 25 to 32.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-09-19T00:00:00+09:30" end-time-local="2026-09-20T00:00:00+09:30" start-time-utc="2026-09-18T14:30:00Z" end-time-utc="2026-09-19T14:30:00Z">
                <text type="forecast">Sunny. Winds east to northeasterly 20 to 30 km/h tending northwest to northeasterly during the day then tending northeast to southeasterly 15 to 20 km/h during the evening. Overnight temperatures falling to between 7 and 16 with daytime temperatures reaching the low to mid 30s.</text>
            </forecast-period>
        </area>
