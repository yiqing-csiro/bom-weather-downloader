    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-02T06:04:43+10:30" end-time-local="2026-11-02T06:04:43+10:30" start-time-utc="2026-11-01T19:34:43Z" end-time-utc="2026-11-01T19:34:43Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A low pressure system over central parts will move slowly east today. A ridge of high pressure will follow which will persist until Tuesday. On Wednesday a cold front moves over the south of the state, followed by another ridge of high pressure, with the centre of the high moving into the Bight on Thursday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW014" description="North East Pastoral" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-02T00:00:00+10:30" end-time-local="2026-11-03T00:00:00+10:30" start-time-utc="2026-11-01T13:30:00Z" end-time-utc="2026-11-02T13:30:00Z">
                <text type="forecast">Mostly sunny. Slight chance of a shower near the eastern border in the early morning. Near zero chance of rain elsewhere. The chance of a thunderstorm in the early morning. Winds northwest to northeasterly 25 to 35 km/h tending northwest to southwesterly 25 to 40 km/h in the middle of the day then tending south to southwesterly in the late afternoon. Daytime maximum temperatures 33 to 42.</text>
                <text type="fire_danger">High</text>
                <text type="uv_alert">Sun protection 9:00am to 5:00pm, UV Index predicted to reach 12 [Extreme]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-03T00:00:00+10:30" end-time-local="2026-11-04T00:00:00+10:30" start-time-utc="2026-11-02T13:30:00Z" end-time-utc="2026-11-03T13:30:00Z">
                <text type="forecast">Sunny. Winds south to southeasterly 25 to 40 km/h. Overnight temperatures falling to between 12 and 25 with daytime temperatures reaching 30 to 39.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-04T00:00:00+10:30" end-time-local="2026-11-05T00:00:00+10:30" start-time-utc="2026-11-03T13:30:00Z" end-time-utc="2026-11-04T13:30:00Z">
                <text type="forecast">Mostly sunny. Slight chance of a shower south of Yunta in the morning and afternoon. Near zero chance of rain elsewhere. Winds south to southeasterly 15 to 25 km/h tending east to southeasterly 20 to 30 km/h during the morning then tending southeast to southwesterly 25 to 40 km/h during the afternoon. Overnight temperatures falling to between 12 and 25 with daytime temperatures reaching 31 to 39.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-05T00:00:00+10:30" end-time-local="2026-11-06T00:00:00+10:30" start-time-utc="2026-11-04T13:30:00Z" end-time-utc="2026-11-05T13:30:00Z">
