    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-25T16:24:59+09:30" end-time-local="2026-09-25T16:24:59+09:30" start-time-utc="2026-09-25T06:54:59Z" end-time-utc="2026-09-25T06:54:59Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough extends over central Australia. A strong high pressure system extends a ridge across southern SA this weekend and pushes the trough into northern SA. The high moves into the Tasman Sea early next week, with the trough shifting west towards the WA border.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW014" description="North East Pastoral" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-25T15:00:00+09:30" end-time-local="2026-09-26T00:00:00+09:30" start-time-utc="2026-09-25T05:30:00Z" end-time-utc="2026-09-25T14:30:00Z">
                <text type="forecast">Mostly clear. Winds east to northeasterly 15 to 25 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-26T00:00:00+09:30" end-time-local="2026-09-27T00:00:00+09:30" start-time-utc="2026-09-25T14:30:00Z" end-time-utc="2026-09-26T14:30:00Z">
                <text type="forecast">Mostly sunny. Slight chance of a shower south of Yunta, near zero chance elsewhere. The chance of a thunderstorm south of Leigh Creek in the afternoon and evening. Winds north to northeasterly 15 to 25 km/h tending northeast to southeasterly in the early afternoon. Overnight temperatures falling to between 14 and 19 with daytime temperatures reaching the low to mid 30s.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 8:50am to 3:20pm, UV Index predicted to reach 8 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-27T00:00:00+09:30" end-time-local="2026-09-28T00:00:00+09:30" start-time-utc="2026-09-26T14:30:00Z" end-time-utc="2026-09-27T14:30:00Z">
                <text type="forecast">Sunny. Winds northeast to southeasterly 20 to 30 km/h. Overnight temperatures falling to between 11 and 19 with daytime temperatures reaching 26 to 36.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-28T00:00:00+09:30" end-time-local="2026-09-29T00:00:00+09:30" start-time-utc="2026-09-27T14:30:00Z" end-time-utc="2026-09-28T14:30:00Z">
                <text type="forecast">Sunny. Winds east to southeasterly 20 to 30 km/h tending east to northeasterly 25 to 35 km/h during the morning. Overnight temperatures falling to between 9 and 19 with daytime temperatures reaching 28 to 36.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-09-29T00:00:00+09:30" end-time-local="2026-09-30T00:00:00+09:30" start-time-utc="2026-09-28T14:30:00Z" end-time-utc="2026-09-29T14:30:00Z">
                <text type="forecast">Mostly sunny. Winds easterly 15 to 25 km/h turning north to northeasterly 25 to 35 km/h during the morning then decreasing to 15 to 25 km/h during the afternoon. Overnight temperatures falling to between 12 and 21 with daytime temperatures reaching 32 to 37.</text>
            </forecast-period>
        </area>
