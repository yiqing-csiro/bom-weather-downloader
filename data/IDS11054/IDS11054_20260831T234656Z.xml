    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-01T09:16:56+09:30" end-time-local="2026-09-01T09:16:56+09:30" start-time-utc="2026-08-31T23:46:56Z" end-time-utc="2026-08-31T23:46:56Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A cold front is expected to move across SA today as a high pressure system moves further east of Australia. Another high pressure ridge will move across the north of the state on Wednesday and Thursday and another cold front will slip across the southeast of SA early Thursday. The ridge will move eastwards early Friday then another trough and cold front will move over SA during the day.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW014" description="North East Pastoral" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-01T00:00:00+09:30" end-time-local="2026-09-02T00:00:00+09:30" start-time-utc="2026-08-31T14:30:00Z" end-time-utc="2026-09-01T14:30:00Z">
                <text type="forecast">Mostly sunny. Slight chance of a shower south of Yunta in the evening. Near zero chance of rain elsewhere. Winds north to northwesterly 25 to 35 km/h tending west to northwesterly in the early afternoon then tending north to northwesterly 15 to 20 km/h in the evening. Daytime maximum temperatures 25 to 32.</text>
                <text type="uv_alert">Sun protection 9:10am to 3:10pm, UV Index predicted to reach 7 [High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-02T00:00:00+09:30" end-time-local="2026-09-03T00:00:00+09:30" start-time-utc="2026-09-01T14:30:00Z" end-time-utc="2026-09-02T14:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers south of Yunta, most likely from the late morning. Near zero chance of rain elsewhere. Winds north to northwesterly 25 to 40 km/h shifting south to southwesterly 15 to 25 km/h in the afternoon. Overnight temperatures falling to between 11 and 18 with daytime temperatures reaching 23 to 35.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-03T00:00:00+09:30" end-time-local="2026-09-04T00:00:00+09:30" start-time-utc="2026-09-02T14:30:00Z" end-time-utc="2026-09-03T14:30:00Z">
                <text type="forecast">Mostly sunny. Winds southeast to southwesterly 15 to 25 km/h tending northeast to southeasterly 20 to 30 km/h during the morning. Overnight temperatures falling to between 7 and 17 with daytime temperatures reaching 21 to 32.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-04T00:00:00+09:30" end-time-local="2026-09-05T00:00:00+09:30" start-time-utc="2026-09-03T14:30:00Z" end-time-utc="2026-09-04T14:30:00Z">
                <text type="forecast">Partly cloudy. Very high chance of showers south of Yunta, near zero chance elsewhere. Winds east to northeasterly 20 to 30 km/h turning north to northwesterly 30 to 45 km/h during the morning then decreasing to 25 to 35 km/h during the afternoon. Overnight temperatures falling to between 8 and 18 with daytime temperatures reaching 21 to 37.</text>
            </forecast-period>
        </area>
