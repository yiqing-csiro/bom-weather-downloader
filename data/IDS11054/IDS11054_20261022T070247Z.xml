    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-10-22T17:32:47+10:30" end-time-local="2026-10-22T17:32:47+10:30" start-time-utc="2026-10-22T07:02:47Z" end-time-utc="2026-10-22T07:02:47Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough of low pressure near the NT border. A slow moving high pressure system in the Tasman Sea maintains a ridge across eastern parts of the state. A trough of low pressure over the far west is forecast to slowly move eastwards on Friday. Another trough and multiple cold fronts move over the state over the weekend. A ridge of high pressure moves into the west on Monday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW014" description="North East Pastoral" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-10-22T16:52:42+10:30" end-time-local="2026-10-23T00:00:00+10:30" start-time-utc="2026-10-22T06:22:42Z" end-time-utc="2026-10-22T13:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers west of Leigh Creek, near zero chance elsewhere. The chance of a thunderstorm north of Leigh Creek. Winds south to southeasterly 15 to 25 km/h tending east to southeasterly 15 to 20 km/h in the late evening.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-10-23T00:00:00+10:30" end-time-local="2026-10-24T00:00:00+10:30" start-time-utc="2026-10-22T13:30:00Z" end-time-utc="2026-10-23T13:30:00Z">
                <text type="forecast">Mostly sunny. Slight chance of a shower in the far northeast in the morning and afternoon. Near zero chance of rain elsewhere. The chance of a thunderstorm north of Leigh Creek in the morning and afternoon. Winds northeast to southeasterly 15 to 20 km/h tending northwest to northeasterly 15 to 25 km/h in the morning then tending northeast to southeasterly 15 to 20 km/h in the late afternoon. Overnight temperatures falling to between 17 and 23 with daytime temperatures reaching the low to mid 30s.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:10am to 4:50pm, UV Index predicted to reach 10 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-10-24T00:00:00+10:30" end-time-local="2026-10-25T00:00:00+10:30" start-time-utc="2026-10-23T13:30:00Z" end-time-utc="2026-10-24T13:30:00Z">
                <text type="forecast">Partly cloudy. High chance of showers south of Yunta, medium chance elsewhere. The chance of a thunderstorm from the late morning. Winds east to northeasterly 15 to 20 km/h turning north to northwesterly 15 to 25 km/h in the late morning. Overnight temperatures falling to between 17 and 23 with daytime temperatures reaching 33 to 38.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-10-25T00:00:00+10:30" end-time-local="2026-10-26T00:00:00+10:30" start-time-utc="2026-10-24T13:30:00Z" end-time-utc="2026-10-25T13:30:00Z">
                <text type="forecast">Partly cloudy. Very high chance of showers south of Leigh Creek, medium chance elsewhere. The chance of a thunderstorm in the morning and afternoon. Winds south to southwesterly 35 to 50 km/h. Overnight temperatures falling to between 15 and 23 with daytime temperatures reaching 21 to 36.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-10-26T00:00:00+10:30" end-time-local="2026-10-27T00:00:00+10:30" start-time-utc="2026-10-25T13:30:00Z" end-time-utc="2026-10-26T13:30:00Z">
                <text type="forecast">Mostly sunny. Slight chance of a shower north of Oodnadatta, near zero chance elsewhere. Winds southerly 20 to 30 km/h. Overnight temperatures falling to between 6 and 16 with daytime temperatures reaching 20 to 27.</text>
            </forecast-period>
        </area>
