    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-26T10:51:27+09:30" end-time-local="2026-09-26T10:51:27+09:30" start-time-utc="2026-09-26T01:21:27Z" end-time-utc="2026-09-26T01:21:27Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough over central Australia will weaken and contract into WA as a ridge of high pressure extends across southern SA on Sunday. The high pressure system is expected to drift into the Tasman Sea by Tuesday as the trough in WA begins to re-extend over western SA on Tuesday, pushing into the state on Wednesday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW014" description="North East Pastoral" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-26T00:00:00+09:30" end-time-local="2026-09-27T00:00:00+09:30" start-time-utc="2026-09-25T14:30:00Z" end-time-utc="2026-09-26T14:30:00Z">
                <text type="forecast">Mostly sunny. The chance of a thunderstorm south of Leigh Creek in the afternoon and evening. Winds north to northeasterly 15 to 25 km/h tending northeast to southeasterly in the early afternoon. Daytime maximum temperatures 31 to 36.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 8:50am to 3:20pm, UV Index predicted to reach 8 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-27T00:00:00+09:30" end-time-local="2026-09-28T00:00:00+09:30" start-time-utc="2026-09-26T14:30:00Z" end-time-utc="2026-09-27T14:30:00Z">
                <text type="forecast">Sunny. Winds northeast to southeasterly 20 to 30 km/h. Overnight temperatures falling to between 11 and 19 with daytime temperatures reaching 27 to 36.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-28T00:00:00+09:30" end-time-local="2026-09-29T00:00:00+09:30" start-time-utc="2026-09-27T14:30:00Z" end-time-utc="2026-09-28T14:30:00Z">
                <text type="forecast">Sunny. Winds east to southeasterly 20 to 30 km/h tending east to northeasterly 25 to 35 km/h during the morning. Overnight temperatures falling to between 10 and 20 with daytime temperatures reaching 30 to 37.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-29T00:00:00+09:30" end-time-local="2026-09-30T00:00:00+09:30" start-time-utc="2026-09-28T14:30:00Z" end-time-utc="2026-09-29T14:30:00Z">
                <text type="forecast">Mostly sunny. Winds east to northeasterly 20 to 30 km/h turning northerly 25 to 35 km/h during the morning then tending north to northeasterly 15 to 25 km/h during the afternoon. Overnight temperatures falling to between 13 and 21 with daytime temperatures reaching the low to high 30s.</text>
            </forecast-period>
        </area>
