    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-30T21:17:28+09:30" end-time-local="2026-09-30T21:17:28+09:30" start-time-utc="2026-09-30T11:47:28Z" end-time-utc="2026-09-30T11:47:28Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A series of troughs over SA will slowly move east ahead of a high pressure system that moves into the Bight on Friday. A cold front moving across the Southern Ocean will clip the far southeast late Thursday, with a low pressure system developing near the Victorian border on Friday. Another trough near the WA border is expected to develop on Saturday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW014" description="North East Pastoral" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-30T21:00:00+09:30" end-time-local="2026-10-01T00:00:00+09:30" start-time-utc="2026-09-30T11:30:00Z" end-time-utc="2026-09-30T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds northwest to northeasterly 20 to 30 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-10-01T00:00:00+09:30" end-time-local="2026-10-02T00:00:00+09:30" start-time-utc="2026-09-30T14:30:00Z" end-time-utc="2026-10-01T14:30:00Z">
                <text type="forecast">Partly cloudy. Very high chance of showers south of Yunta, slight chance elsewhere. The chance of raised dust north of Leigh Creek in the morning and afternoon. The chance of a thunderstorm from the late morning. Winds northwest to northeasterly 30 to 45 km/h tending northwest to southwesterly 25 to 40 km/h in the early afternoon then tending south to southwesterly 20 to 30 km/h in the evening. Overnight temperatures falling to between 18 and 23 with daytime temperatures reaching 32 to 39.</text>
                <text type="fire_danger">High</text>
                <text type="uv_alert">Sun protection 8:40am to 3:30pm, UV Index predicted to reach 9 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-10-02T00:00:00+09:30" end-time-local="2026-10-03T00:00:00+09:30" start-time-utc="2026-10-01T14:30:00Z" end-time-utc="2026-10-02T14:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers, most likely in the morning. The chance of a thunderstorm east of Leigh Creek. Winds south to southwesterly 25 to 35 km/h. Overnight temperatures falling to between 13 and 21 with daytime temperatures reaching 22 to 33.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-10-03T00:00:00+09:30" end-time-local="2026-10-04T00:00:00+09:30" start-time-utc="2026-10-02T14:30:00Z" end-time-utc="2026-10-03T14:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower west of Leigh Creek in the evening. Near zero chance of rain elsewhere. Winds south to southeasterly 20 to 30 km/h. Overnight temperatures falling to between 7 and 18 with daytime temperatures reaching 22 to 31.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-10-04T00:00:00+09:30" end-time-local="2026-10-05T00:00:00+10:30" start-time-utc="2026-10-03T14:30:00Z" end-time-utc="2026-10-04T13:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers west of Leigh Creek, slight chance elsewhere. Winds east to southeasterly 15 to 25 km/h tending south to southeasterly during the afternoon then tending east to southeasterly 15 to 20 km/h during the evening. Overnight temperatures falling to between 7 and 18 with daytime temperatures reaching 21 to 29.</text>
            </forecast-period>
