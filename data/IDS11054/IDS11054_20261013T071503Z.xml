    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-10-13T17:45:04+10:30" end-time-local="2026-10-13T17:45:04+10:30" start-time-utc="2026-10-13T07:15:04Z" end-time-utc="2026-10-13T07:15:04Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough of low pressure lies north of the South Australian border over the Northern Territory. A high pressure system moves across waters to the south of the state reaching the Tasman Sea later on Thursday. Another trough of low pressure moves into the far west on Friday before weakening over the weekend.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW014" description="North East Pastoral" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-10-13T15:00:00+10:30" end-time-local="2026-10-14T00:00:00+10:30" start-time-utc="2026-10-13T04:30:00Z" end-time-utc="2026-10-13T13:30:00Z">
                <text type="forecast">Mostly clear. Slight chance of a shower north of Oodnadatta, near zero chance elsewhere. The chance of a thunderstorm early this evening. Winds south to southeasterly 25 to 40 km/h decreasing to 20 to 30 km/h in the late evening.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-10-14T00:00:00+10:30" end-time-local="2026-10-15T00:00:00+10:30" start-time-utc="2026-10-13T13:30:00Z" end-time-utc="2026-10-14T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower west of Leigh Creek in the afternoon and evening. Near zero chance of rain elsewhere. The chance of a thunderstorm north of Oodnadatta. Winds southeasterly 25 to 40 km/h. Overnight temperatures falling to between 6 and 15 with daytime temperatures reaching 20 to 28.</text>
                <text type="fire_danger">High</text>
                <text type="uv_alert">Sun protection 9:30am to 4:30pm, UV Index predicted to reach 9 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-10-15T00:00:00+10:30" end-time-local="2026-10-16T00:00:00+10:30" start-time-utc="2026-10-14T13:30:00Z" end-time-utc="2026-10-15T13:30:00Z">
                <text type="forecast">Sunny. Winds south to southeasterly 20 to 30 km/h. Overnight temperatures falling to between 7 and 15 with daytime temperatures reaching 23 to 30.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-10-16T00:00:00+10:30" end-time-local="2026-10-17T00:00:00+10:30" start-time-utc="2026-10-15T13:30:00Z" end-time-utc="2026-10-16T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower west of Leigh Creek in the morning. Near zero chance of rain elsewhere. The chance of a thunderstorm west of Leigh Creek in the morning. Winds east to southeasterly 15 to 25 km/h tending south to southeasterly during the evening. Overnight temperatures falling to between 9 and 17 with daytime temperatures reaching 24 to 31.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-10-17T00:00:00+10:30" end-time-local="2026-10-18T00:00:00+10:30" start-time-utc="2026-10-16T13:30:00Z" end-time-utc="2026-10-17T13:30:00Z">
                <text type="forecast">Mostly sunny morning. The chance of a thunderstorm in the far northeast in the afternoon. Winds east to southeasterly 20 to 30 km/h. Overnight temperatures falling to between 11 and 18 with daytime temperatures reaching 27 to 34.</text>
            </forecast-period>
        </area>
