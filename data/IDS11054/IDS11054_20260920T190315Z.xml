    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-21T04:33:15+09:30" end-time-local="2026-09-21T04:33:15+09:30" start-time-utc="2026-09-20T19:03:15Z" end-time-utc="2026-09-20T19:03:15Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system will move eastwards across waters to the south today then over Victoria and the Tasman Sea on Tuesday. This high will extend a ridge westwards over SA ahead of a low pressure trough that is expected to move over the far west of SA during Wednesday. The trough will slip southeastwards over the Bight during Thursday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW014" description="North East Pastoral" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-21T00:00:00+09:30" end-time-local="2026-09-22T00:00:00+09:30" start-time-utc="2026-09-20T14:30:00Z" end-time-utc="2026-09-21T14:30:00Z">
                <text type="forecast">Mostly sunny. The chance of raised dust north of Leigh Creek this morning. Winds south to southeasterly 30 to 45 km/h. Daytime maximum temperatures 21 to 35.</text>
                <text type="uv_alert">Sun protection 8:50am to 3:20pm, UV Index predicted to reach 8 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-22T00:00:00+09:30" end-time-local="2026-09-23T00:00:00+09:30" start-time-utc="2026-09-21T14:30:00Z" end-time-utc="2026-09-22T14:30:00Z">
                <text type="forecast">Sunny. The chance of morning frost south of Yunta. Winds southeasterly 25 to 40 km/h. Overnight temperatures falling to between 5 and 18 with daytime temperatures reaching 23 to 34.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-23T00:00:00+09:30" end-time-local="2026-09-24T00:00:00+09:30" start-time-utc="2026-09-22T14:30:00Z" end-time-utc="2026-09-23T14:30:00Z">
                <text type="forecast">Sunny morning. The chance of a thunderstorm in the far northeast in the afternoon and evening. Winds east to southeasterly 25 to 35 km/h. Overnight temperatures falling to between 6 and 18 with daytime temperatures reaching 27 to 36.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-24T00:00:00+09:30" end-time-local="2026-09-25T00:00:00+09:30" start-time-utc="2026-09-23T14:30:00Z" end-time-utc="2026-09-24T14:30:00Z">
                <text type="forecast">Mostly sunny. Winds east to southeasterly 15 to 25 km/h turning north to northeasterly 20 to 30 km/h during the morning. Overnight temperatures falling to between 9 and 19 with daytime temperatures reaching the low to mid 30s.</text>
            </forecast-period>
        </area>
