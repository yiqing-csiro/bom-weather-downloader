            <forecast-period index="0" start-time-local="2026-11-16T21:00:00+10:30" end-time-local="2026-11-17T00:00:00+10:30" start-time-utc="2026-11-16T10:30:00Z" end-time-utc="2026-11-16T13:30:00Z">
                <text type="forecast">Mostly clear. Winds southerly 15 to 20 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-17T00:00:00+10:30" end-time-local="2026-11-18T00:00:00+10:30" start-time-utc="2026-11-16T13:30:00Z" end-time-utc="2026-11-17T13:30:00Z">
                <text type="forecast">Mostly sunny. Light winds becoming southerly 15 to 25 km/h in the late afternoon then becoming light in the late evening. Overnight temperatures falling to around 6 with daytime temperatures reaching the mid to high 20s.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 9:00am to 4:50pm, UV Index predicted to reach 10 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-18T00:00:00+10:30" end-time-local="2026-11-19T00:00:00+10:30" start-time-utc="2026-11-17T13:30:00Z" end-time-utc="2026-11-18T13:30:00Z">
                <text type="forecast">Partly cloudy. Light winds becoming east to northeasterly 15 to 20 km/h in the morning then tending east to southeasterly in the late afternoon. Overnight temperatures falling to around 11 with daytime temperatures reaching around 30.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-19T00:00:00+10:30" end-time-local="2026-11-20T00:00:00+10:30" start-time-utc="2026-11-18T13:30:00Z" end-time-utc="2026-11-19T13:30:00Z">
                <text type="forecast">Cloudy. High chance of showers. The chance of a thunderstorm in the afternoon and evening. Winds easterly 15 to 20 km/h turning northeasterly 20 to 30 km/h during the day. Overnight temperatures falling to around 17 with daytime temperatures reaching around 30.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-11-20T00:00:00+10:30" end-time-local="2026-11-21T00:00:00+10:30" start-time-utc="2026-11-19T13:30:00Z" end-time-utc="2026-11-20T13:30:00Z">
                <text type="forecast">Mostly sunny. Slight chance of a shower. The chance of a thunderstorm in the morning. Winds northwest to northeasterly 15 to 20 km/h tending west to northwesterly 20 to 30 km/h during the morning then tending west to southwesterly during the afternoon. Overnight temperatures falling to around 17 with daytime temperatures reaching 28 to 33.</text>
            </forecast-period>
