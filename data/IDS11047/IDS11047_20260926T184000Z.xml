        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-27T04:10:36+09:30" end-time-local="2026-09-27T04:10:36+09:30" start-time-utc="2026-09-26T18:40:36Z" end-time-utc="2026-09-26T18:40:36Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A trough over central Australia will weaken and contract into WA as a ridge of high pressure extends across southern SA today. The high pressure system is expected to drift into the Tasman Sea by Tuesday as the trough in WA begins to re-extend over western SA on Tuesday, pushing into the state on Wednesday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW007" description="Murraylands" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-27T00:00:00+09:30" end-time-local="2026-09-28T00:00:00+09:30" start-time-utc="2026-09-26T14:30:00Z" end-time-utc="2026-09-27T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds southeasterly 15 to 25 km/h becoming light in the evening. Daytime maximum temperatures between 17 and 21.</text>
                <text type="fire_danger">No Rating</text>
                <text type="uv_alert">Sun protection 9:00am to 3:10pm, UV Index predicted to reach 7 [High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-28T00:00:00+09:30" end-time-local="2026-09-29T00:00:00+09:30" start-time-utc="2026-09-27T14:30:00Z" end-time-utc="2026-09-28T14:30:00Z">
                <text type="forecast">Partly cloudy. Light winds becoming easterly 15 to 20 km/h in the early morning then tending northeasterly 15 to 25 km/h in the morning. Overnight temperatures falling to around 6 with daytime temperatures reaching the mid 20s.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-29T00:00:00+09:30" end-time-local="2026-09-30T00:00:00+09:30" start-time-utc="2026-09-28T14:30:00Z" end-time-utc="2026-09-29T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds northeasterly 15 to 25 km/h turning northerly 25 to 35 km/h during the morning then tending northwest to northeasterly 15 to 25 km/h during the afternoon. Overnight temperatures falling to around 13 with daytime temperatures reaching the low to mid 30s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-30T00:00:00+09:30" end-time-local="2026-10-01T00:00:00+09:30" start-time-utc="2026-09-29T14:30:00Z" end-time-utc="2026-09-30T14:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers, most likely in the afternoon and evening. The chance of a thunderstorm in the afternoon and evening. Winds northwest to southwesterly 15 to 20 km/h becoming light during the afternoon. Overnight temperatures falling to between 13 and 16 with daytime temperatures reaching the mid to high 20s.</text>
            </forecast-period>
        </area>
