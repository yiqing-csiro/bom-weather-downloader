            <forecast-period index="0" start-time-local="2026-10-06T21:00:00+10:30" end-time-local="2026-10-07T00:00:00+10:30" start-time-utc="2026-10-06T10:30:00Z" end-time-utc="2026-10-06T13:30:00Z">
                <text type="forecast">Clear. Winds southerly 15 to 20 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-10-07T00:00:00+10:30" end-time-local="2026-10-08T00:00:00+10:30" start-time-utc="2026-10-06T13:30:00Z" end-time-utc="2026-10-07T13:30:00Z">
                <text type="forecast">Sunny. Light winds becoming east to northeasterly 15 to 20 km/h in the morning then becoming light in the early afternoon. Overnight temperatures falling to around 4 with daytime temperatures reaching the low 20s.</text>
                <text type="fire_danger">No Rating</text>
                <text type="uv_alert">Sun protection 9:40am to 4:20pm, UV Index predicted to reach 8 [Very High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-10-08T00:00:00+10:30" end-time-local="2026-10-09T00:00:00+10:30" start-time-utc="2026-10-07T13:30:00Z" end-time-utc="2026-10-08T13:30:00Z">
                <text type="forecast">Sunny. Winds north to northeasterly 15 to 25 km/h. Overnight temperatures falling to around 7 with daytime temperatures reaching the mid to high 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-10-09T00:00:00+10:30" end-time-local="2026-10-10T00:00:00+10:30" start-time-utc="2026-10-08T13:30:00Z" end-time-utc="2026-10-09T13:30:00Z">
                <text type="forecast">Cloudy. Very high chance of showers, most likely in the afternoon and evening. The chance of a thunderstorm in the afternoon. Winds north to northeasterly 15 to 25 km/h turning west to northwesterly 15 to 20 km/h during the afternoon. Overnight temperatures falling to between 12 and 15 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-10-10T00:00:00+10:30" end-time-local="2026-10-11T00:00:00+10:30" start-time-utc="2026-10-09T13:30:00Z" end-time-utc="2026-10-10T13:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower in the morning. Winds westerly 15 to 25 km/h becoming light during the evening. Overnight temperatures falling to around 10 with daytime temperatures reaching between 19 and 22.</text>
            </forecast-period>
        </area>
