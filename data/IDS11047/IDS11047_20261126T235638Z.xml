    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-27T10:26:38+10:30" end-time-local="2026-11-27T10:26:38+10:30" start-time-utc="2026-11-26T23:56:38Z" end-time-utc="2026-11-26T23:56:38Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A low pressure system and associated trough moves across eastern parts of the state today, while a ridge of high pressure extends into the west later today and over the weekend. On Monday the high pressure centre moves over waters to the south.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW007" description="Murraylands" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-27T00:00:00+10:30" end-time-local="2026-11-28T00:00:00+10:30" start-time-utc="2026-11-26T13:30:00Z" end-time-utc="2026-11-27T13:30:00Z">
                <text type="forecast">Cloudy. Very high chance of rain near the eastern border, medium chance elsewhere. The chance of a thunderstorm from the late morning, possibly severe with heavy rain which may lead to flash flooding. Winds northeast to southeasterly 15 to 20 km/h tending south to southeasterly in the late afternoon then turning southwesterly in the evening. Daytime maximum temperatures in the high 20s.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 8:50am to 5:10pm, UV Index predicted to reach 11 [Extreme]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-28T00:00:00+10:30" end-time-local="2026-11-29T00:00:00+10:30" start-time-utc="2026-11-27T13:30:00Z" end-time-utc="2026-11-28T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower, most likely in the late morning and afternoon. The chance of a thunderstorm near the eastern border in the morning and afternoon. Winds southwesterly 30 to 45 km/h. Overnight temperatures falling to around 15 with daytime temperatures reaching the low to high 20s.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-29T00:00:00+10:30" end-time-local="2026-11-30T00:00:00+10:30" start-time-utc="2026-11-28T13:30:00Z" end-time-utc="2026-11-29T13:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers in the southwest, slight chance elsewhere. Winds southwesterly 25 to 35 km/h. Overnight temperatures falling to around 10 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-30T00:00:00+10:30" end-time-local="2026-12-01T00:00:00+10:30" start-time-utc="2026-11-29T13:30:00Z" end-time-utc="2026-11-30T13:30:00Z">
                <text type="forecast">Partly cloudy. Winds southwesterly 15 to 20 km/h tending southerly 15 to 25 km/h during the morning then becoming light during the evening. Overnight temperatures falling to around 10 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
        </area>
