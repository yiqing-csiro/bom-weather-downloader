    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-07-29T09:17:54+09:30" end-time-local="2026-07-29T09:17:54+09:30" start-time-utc="2026-07-28T23:47:54Z" end-time-utc="2026-07-28T23:47:54Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">Showers lingering behind a cold front in Bass Strait will ease this morning. A high pressure system will then move over the Bight today, and will extend a ridge across the state as it slowly moves east into NSW by Saturday. Another cold front is then forecast to cross the state from Saturday evening into Sunday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW005" description="Lower South East" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-07-29T00:00:00+09:30" end-time-local="2026-07-30T00:00:00+09:30" start-time-utc="2026-07-28T14:30:00Z" end-time-utc="2026-07-29T14:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower. Winds southwesterly 15 to 25 km/h becoming light in the late afternoon. Daytime maximum temperatures around 13.</text>
                <text type="uv_alert">Sun protection not recommended, UV Index predicted to reach 2 [Low]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-07-30T00:00:00+09:30" end-time-local="2026-07-31T00:00:00+09:30" start-time-utc="2026-07-29T14:30:00Z" end-time-utc="2026-07-30T14:30:00Z">
                <text type="forecast">Cloudy. The chance of morning fog. Medium chance of showers, most likely in the late morning and afternoon. Light winds. Overnight temperatures falling to between 4 and 7 with daytime temperatures reaching around 13.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-07-31T00:00:00+09:30" end-time-local="2026-08-01T00:00:00+09:30" start-time-utc="2026-07-30T14:30:00Z" end-time-utc="2026-07-31T14:30:00Z">
                <text type="forecast">Partly cloudy. The chance of morning fog. Slight chance of a shower in the south, near zero chance elsewhere. Light winds. Overnight temperatures falling to between 1 and 4 with daytime temperatures reaching around 14.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-08-01T00:00:00+09:30" end-time-local="2026-08-02T00:00:00+09:30" start-time-utc="2026-07-31T14:30:00Z" end-time-utc="2026-08-01T14:30:00Z">
                <text type="forecast">Cloudy. Light winds becoming northerly 15 to 25 km/h during the morning then becoming light during the afternoon. Overnight temperatures falling to around 3 with daytime temperatures reaching around 15.</text>
            </forecast-period>
        </area>
