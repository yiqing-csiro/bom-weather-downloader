    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-27T10:26:35+10:30" end-time-local="2026-11-27T10:26:35+10:30" start-time-utc="2026-11-26T23:56:35Z" end-time-utc="2026-11-26T23:56:35Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A low pressure system and associated trough moves across eastern parts of the state today, while a ridge of high pressure extends into the west later today and over the weekend. On Monday the high pressure centre moves over waters to the south.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW005" description="Lower South East" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-27T00:00:00+10:30" end-time-local="2026-11-28T00:00:00+10:30" start-time-utc="2026-11-26T13:30:00Z" end-time-utc="2026-11-27T13:30:00Z">
                <text type="forecast">Cloudy. High chance of rain, most likely in the afternoon and evening. The chance of a thunderstorm in the late morning and afternoon, possibly severe with heavy rain which may lead to flash flooding. Winds easterly 15 to 20 km/h turning southerly in the late afternoon. Daytime maximum temperatures in the high 20s.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 8:40am to 5:00pm, UV Index predicted to reach 10 [Very High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-28T00:00:00+10:30" end-time-local="2026-11-29T00:00:00+10:30" start-time-utc="2026-11-27T13:30:00Z" end-time-utc="2026-11-28T13:30:00Z">
                <text type="forecast">Partly cloudy. High chance of showers, most likely from the late morning. The chance of a thunderstorm in the morning and afternoon. Winds southwesterly 25 to 40 km/h. Overnight temperatures falling to around 14 with daytime temperatures reaching the low 20s.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-29T00:00:00+10:30" end-time-local="2026-11-30T00:00:00+10:30" start-time-utc="2026-11-28T13:30:00Z" end-time-utc="2026-11-29T13:30:00Z">
                <text type="forecast">Cloudy. High chance of showers, most likely in the afternoon and evening. Winds west to southwesterly 25 to 35 km/h. Overnight temperatures falling to around 10 with daytime temperatures reaching around 20.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-30T00:00:00+10:30" end-time-local="2026-12-01T00:00:00+10:30" start-time-utc="2026-11-29T13:30:00Z" end-time-utc="2026-11-30T13:30:00Z">
                <text type="forecast">Cloudy. Winds south to southwesterly 15 to 25 km/h becoming light during the evening. Overnight temperatures falling to between 7 and 10 with daytime temperatures reaching between 19 and 22.</text>
            </forecast-period>
        </area>
