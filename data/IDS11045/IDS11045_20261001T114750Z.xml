    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-10-01T21:17:51+09:30" end-time-local="2026-10-01T21:17:51+09:30" start-time-utc="2026-10-01T11:47:51Z" end-time-utc="2026-10-01T11:47:51Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A series of troughs continue moving east, with a low pressure system developing near the Victorian border on Friday. In the west, a high pressure system will move into the Bight and slowly move east to be centred over Victoria on Monday, while extending a ridge into parts of the state. Another trough near the WA border is expected to develop from Saturday and extend into the state before weakening by Monday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW005" description="Lower South East" type="public-district" parent-aac="SA_FA001">
            <warning-summary type="sheep_graziers_warning" start-time-local="2026-10-01T16:18:00+09:30" end-time-local="2026-10-03T00:00:00+09:30" start-time-utc="2026-10-01T06:48:00Z" end-time-utc="2026-10-02T14:30:00Z">Warning to Sheep Graziers</warning-summary>
            <forecast-period index="0" start-time-local="2026-10-01T21:00:00+09:30" end-time-local="2026-10-02T00:00:00+09:30" start-time-utc="2026-10-01T11:30:00Z" end-time-utc="2026-10-01T14:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower in the north, near zero chance elsewhere. The chance of a thunderstorm. Light winds.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-10-02T00:00:00+09:30" end-time-local="2026-10-03T00:00:00+09:30" start-time-utc="2026-10-01T14:30:00Z" end-time-utc="2026-10-02T14:30:00Z">
                <text type="forecast">Cloudy. Very high chance of showers, most likely from the late morning. The chance of a thunderstorm. Winds south to southeasterly and light becoming southeasterly 15 to 25 km/h in the morning then tending southerly 25 to 35 km/h in the middle of the day. Overnight temperatures falling to around 9 with daytime temperatures reaching around 18.</text>
                <text type="fire_danger">No Rating</text>
                <text type="uv_alert">Sun protection 9:00am to 2:50pm, UV Index predicted to reach 6 [High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-10-03T00:00:00+09:30" end-time-local="2026-10-04T00:00:00+09:30" start-time-utc="2026-10-02T14:30:00Z" end-time-utc="2026-10-03T14:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers, most likely in the early morning. Winds southerly 25 to 40 km/h decreasing to 15 to 25 km/h in the evening then becoming south to southeasterly and light in the late evening. Overnight temperatures falling to between 7 and 10 with daytime temperatures reaching around 17.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-10-04T00:00:00+09:30" end-time-local="2026-10-05T00:00:00+10:30" start-time-utc="2026-10-03T14:30:00Z" end-time-utc="2026-10-04T13:30:00Z">
                <text type="forecast">Partly cloudy. Light winds becoming southerly 15 to 20 km/h during the morning then becoming light during the evening. Overnight temperatures falling to between 5 and 8 with daytime temperatures reaching around 18.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-10-05T00:00:00+10:30" end-time-local="2026-10-06T00:00:00+10:30" start-time-utc="2026-10-04T13:30:00Z" end-time-utc="2026-10-05T13:30:00Z">
                <text type="forecast">Partly cloudy. Light winds becoming west to northwesterly 15 to 20 km/h during the afternoon then becoming light during the evening. Overnight temperatures falling to around 5 with daytime temperatures reaching around 18.</text>
            </forecast-period>
        </area>
