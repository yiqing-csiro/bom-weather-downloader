    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-23T04:10:21+09:30" end-time-local="2026-09-23T04:10:21+09:30" start-time-utc="2026-09-22T18:40:21Z" end-time-utc="2026-09-22T18:40:21Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system centred over the Tasman Sea extends a ridge over SA ahead of a low pressure trough that is expected to move over the far west of SA during Wednesday. The trough will slip southeastwards over southern coasts during Thursday and Friday, before being confined to the west over the weekend.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW005" description="Lower South East" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-23T00:00:00+09:30" end-time-local="2026-09-24T00:00:00+09:30" start-time-utc="2026-09-22T14:30:00Z" end-time-utc="2026-09-23T14:30:00Z">
                <text type="forecast">Mostly sunny. The chance of morning frost. Light winds. Daytime maximum temperatures in the low 20s.</text>
                <text type="uv_alert">Sun protection 9:10am to 2:40pm, UV Index predicted to reach 6 [High]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-24T00:00:00+09:30" end-time-local="2026-09-25T00:00:00+09:30" start-time-utc="2026-09-23T14:30:00Z" end-time-utc="2026-09-24T14:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower. Winds northeasterly 15 to 20 km/h tending northerly in the early morning then becoming light in the early afternoon. Overnight temperatures falling to around 10 with daytime temperatures reaching the low to mid 20s.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-25T00:00:00+09:30" end-time-local="2026-09-26T00:00:00+09:30" start-time-utc="2026-09-24T14:30:00Z" end-time-utc="2026-09-25T14:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers, most likely in the morning. Light winds becoming west to southwesterly 15 to 20 km/h during the day then turning southerly during the afternoon. Overnight temperatures falling to around 11 with daytime temperatures reaching between 19 and 23.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-26T00:00:00+09:30" end-time-local="2026-09-27T00:00:00+09:30" start-time-utc="2026-09-25T14:30:00Z" end-time-utc="2026-09-26T14:30:00Z">
                <text type="forecast">Cloudy. High chance of showers in the south, medium chance elsewhere. Winds southeasterly 20 to 30 km/h. Overnight temperatures falling to around 9 with daytime temperatures reaching between 15 and 18.</text>
            </forecast-period>
        </area>
