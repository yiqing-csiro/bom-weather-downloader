        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-25T10:07:53+09:30" end-time-local="2026-09-25T10:07:53+09:30" start-time-utc="2026-09-25T00:37:53Z" end-time-utc="2026-09-25T00:37:53Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A low pressure trough extends from WA over western SA. This trough will be very slow-moving for the rest of this week and over the weekend. A weakening cold front will slip across southern coasts during today. Another low pressure trough will develop over WA on Sunday and Monday then move over SA early to mid next week.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW005" description="Lower South East" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-25T00:00:00+09:30" end-time-local="2026-09-26T00:00:00+09:30" start-time-utc="2026-09-24T14:30:00Z" end-time-utc="2026-09-25T14:30:00Z">
                <text type="forecast">Cloudy. Medium chance of showers. The chance of a thunderstorm near the eastern border in the afternoon. Winds west to southwesterly 15 to 20 km/h turning southerly in the afternoon. Daytime maximum temperatures between 18 and 22.</text>
                <text type="uv_alert">##</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-26T00:00:00+09:30" end-time-local="2026-09-27T00:00:00+09:30" start-time-utc="2026-09-25T14:30:00Z" end-time-utc="2026-09-26T14:30:00Z">
                <text type="forecast">Cloudy. High chance of showers in the north, medium chance elsewhere. Winds southerly 15 to 20 km/h turning southeasterly 20 to 30 km/h during the morning and early afternoon. Overnight temperatures falling to around 8 with daytime temperatures reaching around 16.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-27T00:00:00+09:30" end-time-local="2026-09-28T00:00:00+09:30" start-time-utc="2026-09-26T14:30:00Z" end-time-utc="2026-09-27T14:30:00Z">
                <text type="forecast">Partly cloudy. Winds southeasterly 20 to 30 km/h. Overnight temperatures falling to between 2 and 6 with daytime temperatures reaching around 17.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-28T00:00:00+09:30" end-time-local="2026-09-29T00:00:00+09:30" start-time-utc="2026-09-27T14:30:00Z" end-time-utc="2026-09-28T14:30:00Z">
                <text type="forecast">Partly cloudy. Light winds becoming easterly 15 to 20 km/h during the morning then tending northeasterly during the evening. Overnight temperatures falling to around 3 with daytime temperatures reaching around 20.</text>
            </forecast-period>
        </area>
