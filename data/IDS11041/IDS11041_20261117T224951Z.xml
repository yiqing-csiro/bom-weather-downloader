    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-11-18T09:19:51+10:30" end-time-local="2026-11-18T09:19:51+10:30" start-time-utc="2026-11-17T22:49:51Z" end-time-utc="2026-11-17T22:49:51Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure system centred south of the Bight, extends a ridge of high pressure over most of South Australia. The high and ridge will move slowly eastwards during the week to be in the Tasman Sea on Thursday. A low pressure system and associated trough over Western Australia will move over South Australia mid to late in the week. Another high pressure system follows and moves over South Australia on Saturday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW015" description="Mount Lofty Ranges" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-11-18T00:00:00+10:30" end-time-local="2026-11-19T00:00:00+10:30" start-time-utc="2026-11-17T13:30:00Z" end-time-utc="2026-11-18T13:30:00Z">
                <text type="forecast">Partly cloudy. Winds east to northeasterly 15 to 20 km/h tending east to southeasterly 15 to 25 km/h in the late afternoon. Daytime maximum temperatures in the mid to high 20s.</text>
                <text type="fire_danger">Moderate</text>
                <text type="uv_alert">Sun protection 8:50am to 5:00pm, UV Index predicted to reach 11 [Extreme]</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-11-19T00:00:00+10:30" end-time-local="2026-11-20T00:00:00+10:30" start-time-utc="2026-11-18T13:30:00Z" end-time-utc="2026-11-19T13:30:00Z">
                <text type="forecast">Cloudy. High chance of showers. The chance of a thunderstorm in the late afternoon and evening. Winds easterly 15 to 25 km/h turning north to northeasterly 20 to 30 km/h during the day. Overnight temperatures falling to between 16 and 19 with daytime temperatures reaching the mid to high 20s.</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-11-20T00:00:00+10:30" end-time-local="2026-11-21T00:00:00+10:30" start-time-utc="2026-11-19T13:30:00Z" end-time-utc="2026-11-20T13:30:00Z">
                <text type="forecast">Partly cloudy. Slight chance of a shower, most likely in the morning. The chance of a thunderstorm in the morning. Winds northerly 15 to 20 km/h turning westerly 20 to 30 km/h during the morning. Overnight temperatures falling to around 16 with daytime temperatures reaching the low to high 20s.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-11-21T00:00:00+10:30" end-time-local="2026-11-22T00:00:00+10:30" start-time-utc="2026-11-20T13:30:00Z" end-time-utc="2026-11-21T13:30:00Z">
                <text type="forecast">Partly cloudy. Winds westerly 15 to 20 km/h becoming light during the morning then becoming northeasterly 15 to 20 km/h during the evening. Overnight temperatures falling to around 13 with daytime temperatures reaching 25 to 30.</text>
            </forecast-period>
        </area>
