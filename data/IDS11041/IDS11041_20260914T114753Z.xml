    <forecast>
        <area aac="SA_FA001" description="South Australia" type="region">
            <forecast-period start-time-local="2026-09-14T21:17:54+09:30" end-time-local="2026-09-14T21:17:54+09:30" start-time-utc="2026-09-14T11:47:54Z" end-time-utc="2026-09-14T11:47:54Z">
                <text type="warning_summary_footer">For latest warnings go to www.bom.gov.au, subscribe to RSS feeds, call 1300 659 210* or listen for warnings on relevant TV and radio broadcasts.</text>
                <text type="synoptic_situation">A high pressure ridge will move over northern SA on Monday and a cold front will move over southern coastal districts late Monday and early Tuesday. A high pressure system will then move across waters to the south during the week to be centred over Victoria later Thursday then over eastern NSW later Friday. A low pressure trough over the interior of WA may extend into far western parts of SA at times before weakening late Tuesday.</text>
                <text type="product_footer">* Calls to 1300 numbers cost around 27.5c incl. GST, higher from mobiles or public phones.</text>
            </forecast-period>
        </area>
        <area aac="SA_PW015" description="Mount Lofty Ranges" type="public-district" parent-aac="SA_FA001">
            <forecast-period index="0" start-time-local="2026-09-14T21:00:00+09:30" end-time-local="2026-09-15T00:00:00+09:30" start-time-utc="2026-09-14T11:30:00Z" end-time-utc="2026-09-14T14:30:00Z">
                <text type="forecast">Partly cloudy. Medium chance of showers. Winds westerly 15 to 25 km/h.</text>
            </forecast-period>
            <forecast-period index="1" start-time-local="2026-09-15T00:00:00+09:30" end-time-local="2026-09-16T00:00:00+09:30" start-time-utc="2026-09-14T14:30:00Z" end-time-utc="2026-09-15T14:30:00Z">
                <text type="forecast">Cloudy. Slight chance of a shower in the early morning. Winds southwesterly 20 to 30 km/h turning south to southeasterly during the day. Overnight temperatures falling to between 7 and 10 with daytime temperatures reaching between 13 and 16.</text>
                <text type="uv_alert">Sun protection 9:10am to 3:00pm, UV Index predicted to reach 6 [High]</text>
            </forecast-period>
            <forecast-period index="2" start-time-local="2026-09-16T00:00:00+09:30" end-time-local="2026-09-17T00:00:00+09:30" start-time-utc="2026-09-15T14:30:00Z" end-time-utc="2026-09-16T14:30:00Z">
                <text type="forecast">Cloudy. Winds southeasterly 15 to 25 km/h. Overnight temperatures falling to between 4 and 9 with daytime temperatures reaching between 12 and 15.</text>
            </forecast-period>
            <forecast-period index="3" start-time-local="2026-09-17T00:00:00+09:30" end-time-local="2026-09-18T00:00:00+09:30" start-time-utc="2026-09-16T14:30:00Z" end-time-utc="2026-09-17T14:30:00Z">
                <text type="forecast">Sunny. Winds east to southeasterly 15 to 20 km/h tending east to northeasterly during the morning then becoming light during the day. Overnight temperatures falling to between 3 and 6 with daytime temperatures reaching between 15 and 18.</text>
            </forecast-period>
            <forecast-period index="4" start-time-local="2026-09-18T00:00:00+09:30" end-time-local="2026-09-19T00:00:00+09:30" start-time-utc="2026-09-17T14:30:00Z" end-time-utc="2026-09-18T14:30:00Z">
                <text type="forecast">Sunny. Winds north to northeasterly 15 to 20 km/h tending north to northwesterly 15 to 25 km/h during the morning. Overnight temperatures falling to around 8 with daytime temperatures reaching between 19 and 22.</text>
            </forecast-period>
        </area>
